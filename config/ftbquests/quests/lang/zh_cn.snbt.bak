	quest.0000000000000002.quest_desc: [
		"按下J打开任务书（当前界面）"
		"左侧：章节列表"
		"右侧：当前章节的任务树"
		"任务类型："
		"• 物品提交 — 提交指定物品"
		"• 击杀生物 — 击败指定怪物"
		"• 确认 — 确认你已了解该功能"
		"完成任务可获得奖励（物品、经验）"
		"完成章节全部任务可领取毕业奖励"
	]
	quest.0000000000000002.quest_subtitle: "如何使用任务"
	quest.0000000000000002.title: "任务书指南"
	quest.0000000000000003.quest_desc: [
		"JEI是本整合包最重要的工具之一"
		"显示在物品栏/合成界面的右侧"
		"快捷键："
		"• R — 查看物品配方"
		"• U — 查看物品用途"
		"• A — 收藏/取消收藏配方"
		"• @模组名 — 按模组搜索"
		"在搜索框中输入 #标签名"
		"可查看该标签下的所有物品"
	]
	quest.0000000000000003.quest_subtitle: "配方与用途"
	quest.0000000000000003.title: "JEI配方查询"
	quest.0000000000000004.quest_desc: [
		"Jade在屏幕顶部显示目标信息"
		"看向方块时显示："
		"• 方块名称和来源模组"
		"• 挖掘进度和所需工具"
		"• 容器物品预览"
		"• 作物生长状态"
		"看向实体时显示："
		"• 生物名称和生命值"
		"• 玩家名称和护甲值"
		"按小键盘0(Num0)开关显示"
	]
	quest.0000000000000004.quest_subtitle: "方块与实体信息"
	quest.0000000000000004.title: "Jade信息面板"
	quest.0000000000000005.quest_desc: [
		"Xaero提供两种地图系统"
		"小地图（右上角）："
		"• 按Y打开小地图设置"
		"• 按B创建路径点"
		"• 显示附近的生物和玩家"
		"世界地图："
		"• 按M打开全屏世界地图"
		"• 已探索区域自动绘制"
		"• 统一管理路径点"
		"探索时善用路径点，"
		"重要地点再也不会丢失！"
	]
	quest.0000000000000005.quest_subtitle: "永不迷路"
	quest.0000000000000005.title: "Xaero地图"
	quest.0000000000000006.quest_desc: [
		"高级存储"
		"为你的背包和容器添加智能整理按钮"
		"功能："
		"• 一键整理物品栏/箱子"
		"• 快速堆叠到附近容器"
		"• 鼠标中键排序"
		"• 可自定义排序规则"
		"打开任何容器界面"
		"在左上角/右上角寻找整理按钮"
		"告别杂乱的物品栏！"
	]
	quest.0000000000000006.quest_subtitle: "智能物品管理"
	quest.0000000000000006.title: "智能整理"
	quest.0000000000000007.quest_desc: [
		"Curios为你的角色添加饰品栏位"
		"按E打开物品栏，点击Curios图标"
		"（左侧的小戒指图标）"
		"可用栏位："
		"• 戒指 x2"
		"• 项链 x1"
		"• 腰带 x1"
		"• 手镯 x1"
		"• 其他特殊栏位"
		"铁魔法和"
		"Puffish属性装备"
		"都需要Curios栏位来佩戴"
	]
	quest.0000000000000007.quest_subtitle: "戒指与项链"
	quest.0000000000000007.title: "Curios饰品"
	quest.0000000000000008.quest_desc: [
		"按K打开技能树面板"
		"通过获取经验来赚取技能点"
		"花费技能点来："
		"• 提升生命值/护甲"
		"• 增加攻击伤害/移动速度"
		"• 解锁特殊能力"
		"技能树类别："
		"• 战斗技艺 — 伤害与防御"
		"• 远程射手 — 弓弩与投掷"
		"• 生存专家 — 采矿与农耕"
		"• 探索冒险 — 移动与探险"
		"• 工艺建造 — 机械与附魔"
		"• 酿造炼金 — 药水与免疫"
	]
	quest.0000000000000008.quest_subtitle: "角色成长"
	quest.0000000000000008.title: "技能树"
	quest.0000000000000009.quest_desc: [
		"传送石碑提供传送网络系统"
		"自然生成的传送石碑可以在以下地点找到："
		"• 村庄中心"
		"• 野外路边"
		"• 特殊结构附近"
		"使用方法："
		"• 右键点击传送石碑打开传送界面"
		"• 花费少量经验值进行传送"
		"• 可合成传送石用于便携使用"
		"一旦建立传送网络，"
		"长途旅行将瞬间完成！"
	]
	quest.0000000000000009.quest_subtitle: "快速传送网络"
	quest.0000000000000009.title: "传送石碑"
	quest.0000000000000010.quest_desc: [
		"一键砍树模组改变了砍树方式"
		"只需用斧头砍断树干最底部的"
		"原木方块"
		"整棵树就会全部倒下！"
		"支持所有模组的树木"
		"（包括BYG、天境等）"
		"注意："
		"• 需要使用斧头（空手无效）"
		"• 潜行(Shift)可以阻止连锁砍伐"
		"• 树叶会自动掉落树苗"
	]
	quest.0000000000000010.quest_subtitle: "一键砍树"
	quest.0000000000000010.title: "一键砍树"
	quest.0000000000000011.quest_desc: [
		"鼠标手势快捷键："
		"• Shift+左键拖动 — 批量转移"
		"• Shift+右键 — 快速移动堆叠"
		"• 滚轮 — 精确放置单个物品"
		"垃圾桶："
		"• 在物品栏/容器界面右下角"
		"• 拖动物品进去即可删除"
		"• 或使用Ctrl+Shift+点击物品"
		"将其快速丢入垃圾桶"
	]
	quest.0000000000000011.quest_subtitle: "快捷操作与垃圾桶"
	quest.0000000000000011.title: "鼠标手势与垃圾桶"
	quest.0000000000000012.quest_desc: [
		"交易刷新可以让你快速刷新村民交易"
		"在村民交易界面中"
		"点击交易旁边的刷新按钮"
		"每次刷新消耗一个绿宝石"
		"不再需要反复破坏和放置"
		"工作方块了！"
		"快速找到你需要的那本附魔书！"
	]
	quest.0000000000000012.title: "刷新村民交易"
	quest.0000000000000013.quest_desc: [
		"按下F7切换刷怪区域显示"
		"颜色含义："
		"• 黄色X — 白天安全，夜晚会刷怪"
		"• 红色X — 怪物随时可以生成!"
		"• 无标记 — 足够明亮，完全安全"
		"确保你的基地没有红色X标记！"
		"放置火把消除所有红色区域"
		"这是生存中最实用的工具之一"
	]
	quest.0000000000000013.quest_subtitle: "防止刷怪"
	quest.0000000000000013.title: "光照显示(F7)"
	quest.0000000000000014.quest_desc: [
		"死亡墓碑模组"
		"在死亡时生成一个墓碑"
		"死亡时："
		"• 所有物品保存在墓碑中"
		"• 墓碑标记你的死亡位置"
		"• 右键点击墓碑取回所有物品"
		"不再害怕岩浆或虚空！"
		"你的物品会被安全保存"
		"但记得在重新装备之前取回它们"
	]
	quest.0000000000000014.quest_subtitle: "安全死亡恢复"
	quest.0000000000000014.title: "死亡墓碑"
	quest.0000000000000015.quest_desc: [
		"恭喜你完成了教程!"
		"你现在已经了解："
		"• FTB任务书和JEI配方系统"
		"• Jade和Xaero地图信息工具"
		"• Curios饰品和技能系统"
		"• 传送石碑传送网络"
		"• 一键砍树和快捷操作"
		"• 交易刷新、F7光照显示、墓碑保护"
		"全部13个章节已解锁！"
		"从原版生存到终极Boss战斗"
		"按你自己的节奏开始冒险吧！"
	]
	quest.0000000000000015.quest_subtitle: "解锁全部章节"
	quest.0000000000000015.title: "教程完成"
	quest.0000000001000001.quest_desc: [
		"欢迎来到 the world of blocks!"
		"首先, 你需要 合成 a 工作台."
		"Use logs 合成 planks,"
		"then use 4 planks 制作 a 工作台."
		"右键点击 放置 it, right-click 打开 the crafting grid."
		"这是 the starting point of all crafting!"
	]
	quest.0000000001000001.quest_subtitle: "第一步"
	quest.0000000001000001.title: "第一步"
	quest.0000000001000002.quest_desc: [
		"找到一棵树,"
		"break the log blocks with your hand or a tool."
		"每个 oak tree provides 4-7 logs."
		"Logs craft into planks,"
		"the basic building material."
		"别忘了 to plant saplings too!"
	]
	quest.0000000001000002.quest_subtitle: "获取木头"
	quest.0000000001000002.title: "采集木头"
	quest.0000000001000003.quest_desc: [
		"The first step into the 石器时代!"
		"Mine stone 获取 cobblestone,"
		"craft a stone pickaxe, axe, and sword."
		"石头 pickaxe can mine iron ore,"
		"stone axe chops trees 3x faster than by hand,"
		"stone sword is a reliable early-game weapon."
		"Use a wooden pickaxe to mine stone, then upgrade to stone tools!"
	]
	quest.0000000001000003.quest_subtitle: "石器时代"
	quest.0000000001000003.title: "石器时代"
	quest.0000000001000004.quest_desc: [
		"Darkness breeds monsters, torches bring safety!"
		"Craft torches with coal/charcoal and sticks."
		"One coal makes 4 torches."
		"Torches are essential for cave exploration,"
		"and also prevent mob spawning."
		"确保 your home has adequate lighting!"
	]
	quest.0000000001000004.quest_subtitle: "照亮黑暗"
	quest.0000000001000004.title: "火把与光源"
	quest.0000000001000005.quest_desc: [
		"Craft a furnace with 8 cobblestone."
		"Smelt logs in the furnace 制作 charcoal,"
		"charcoal burns 8x longer than raw logs!"
		"Furnaces can smelt iron ore and cook food,"
		"one of the most important survival tools."
		"Produce 16 charcoal to prepare for the future."
	]
	quest.0000000001000005.quest_subtitle: "睡眠时间"
	quest.0000000001000005.title: "安然入睡"
	quest.0000000001000006.quest_desc: [
		"Long nights call for a warm bed."
		"Craft a bed with 3 wool and 3 planks."
		"击杀 sheep or use shears 获取 wool."
		"右键点击 a bed to set your spawn point,"
		"right-click at night to sleep and skip the night."
		"Without a bed, the night is full of monsters..."
	]
	quest.0000000001000006.quest_subtitle: "获取食物"
	quest.0000000001000006.title: "食物供应"
	quest.0000000001000007.quest_desc: [
		"物品栏 full? You need a storage system!"
		"Craft a chest with 8 planks,"
		"a chest provides 27 storage slots."
		"Barrels are a cheaper alternative,"
		"crafted with 6 planks and 2 wooden slabs."
		"Organize your storage warehouse!"
	]
	quest.0000000001000007.quest_subtitle: "燃料来源"
	quest.0000000001000007.title: "煤炭与木炭"
	quest.0000000001000008.quest_desc: [
		"进入铁器时代 and boost your productivity!"
		"Find iron ore below Y=56 underground,"
		"smelt iron ore into iron ingots in a furnace."
		"铁 pickaxe can mine diamond, gold, and redstone,"
		"iron durability is over twice that of stone."
		"Prioritize crafting an iron pickaxe!"
	]
	quest.0000000001000008.quest_subtitle: "进入铁器时代"
	quest.0000000001000008.title: "铁器时代"
	quest.0000000001000009.quest_desc: [
		"Plant seeds, harvest the future!"
		"Craft a wooden hoe with 2 sticks and 2 planks."
		"右键点击 grass with a hoe to till farmland,"
		"Breaking grass has a chance to drop wheat seeds."
		"Farmland needs water nearby to stay hydrated,"
		"One water block can hydrate a 9x9 area of farmland."
	]
	quest.0000000001000009.quest_subtitle: "更好的工具"
	quest.0000000001000009.title: "农耕 Basics"
	quest.0000000001000010.quest_desc: [
		"Golden waves of wheat sway in the breeze."
		"Growing wheat requires patience,"
		"ripe wheat turns from green to golden."
		"Harvest wheat 获取 more seeds,"
		"gradually expand your farmland."
		"Use wheat to attract cows and sheep for breeding!"
	]
	quest.0000000001000010.quest_subtitle: "钻石!"
	quest.0000000001000010.title: "Golden 小麦 Field"
	quest.0000000001000011.quest_desc: [
		"Process wheat into delicious bread!"
		"Craft 1 bread using 3 wheat at a crafting table."
		"每个 bread restores 5 hunger points."
		"面包 is the most stable mid-game food source,"
		"portable and doesn't take much inventory space."
		"Build a wheat farm and never go hungry again!"
	]
	quest.0000000001000011.quest_subtitle: "The Baker"
	quest.0000000001000011.title: "The Baker"
	quest.0000000001000012.quest_desc: [
		"Build an animal farm,"
		"say goodbye to hunting!"
		"Use wheat to attract cows and sheep,"
		"carrots to attract pigs,"
		"seeds to attract chickens."
		"Feed two of the same animal to breed them,"
		"gain a stable source of meat and materials."
	]
	quest.0000000001000012.quest_subtitle: "动物养殖"
	quest.0000000001000012.title: "动物养殖"
	quest.0000000001000013.quest_desc: [
		"Nothing beats the smell of grilled meat!"
		"Cooking raw meat in a furnace greatly boosts hunger restoration."
		"Cooked beef restores 8 hunger, the best food!"
		"Cooked porkchop and cooked chicken are great too."
		"Build an automated grilling system,"
		"从不 go hungry again!"
	]
	quest.0000000001000013.quest_subtitle: "烤肉盛宴"
	quest.0000000001000013.title: "烤肉盛宴"
	quest.0000000001000014.quest_desc: [
		"拿起你的 fishing rod and enjoy some time at the river!"
		"Craft a fishing rod with sticks and string,"
		"right-click water to cast the bobber."
		"Wait for the bobber to dip then quickly reel in."
		"钓鱼 yields raw fish, treasure, even enchanted books!"
		"Cod and salmon are a cat's favorite."
	]
	quest.0000000001000014.quest_subtitle: "渔夫之道"
	quest.0000000001000014.title: "渔夫之道"
	quest.0000000001000015.quest_desc: [
		"Find pumpkin and melon seeds in mineshafts or villages."
		"Growing pumpkins and melons requires adjacent farmland,"
		"their stems grow fruit on adjacent blocks."
		"Craft pumpkin pie with pumpkin, sugar, and egg,"
		"a quality food that restores 8 hunger!"
		"32 melon slices to fill your backpack."
	]
	quest.0000000001000015.quest_subtitle: "南瓜与西瓜"
	quest.0000000001000015.title: "南瓜与西瓜"
	quest.0000000001000016.quest_desc: [
		"You are a true livestock expert!"
		"右键点击 a cow with an iron bucket 获取 milk,"
		"milk clears all potion effects."
		"Collect 32 eggs for sustainable chicken hatching,"
		"16 leather can be used for books and equipment."
		"Use eggs, sugar, and milk 合成 a celebration cake!"
	]
	quest.0000000001000016.quest_subtitle: "牛奶与鸡蛋"
	quest.0000000001000016.title: "养殖专家"
	quest.0000000001000017.quest_desc: [
		"最好的 defense is raising your shield!"
		"Craft a shield with 6 planks and 1 iron ingot."
		"Hold right-click to raise the shield and fully block attacks,"
		"including skeleton arrows and creeper explosions!"
		"A shield is a must-have for exploring dangerous areas,"
		"Don't face a group of skeleton archers bare-handed!"
	]
	quest.0000000001000017.quest_subtitle: "盾牌防御"
	quest.0000000001000017.title: "盾牌护身"
	quest.0000000001000018.quest_desc: [
		"Wear a full set of iron armor and protect yourself!"
		"A full set requires 24 iron ingots."
		"提供 15 armor points (max 20),"
		"significantly reducing damage taken."
		"Prioritize crafting the chestplate for the most protection!"
		"With iron armor, mining is no longer terrifying."
	]
	quest.0000000001000018.quest_subtitle: "铁 护甲 Set"
	quest.0000000001000018.title: "铁 护甲 Set"
	quest.0000000001000019.quest_desc: [
		"A good weapon is key to survival!"
		"石头 sword deals 5 attack damage,"
		"1 more than wooden sword, 4 more than bare hands."
		"Keep your weapon on you at all times,"
		"ready to counter zombies and skeletons at night."
		"Even better when paired with a shield!"
	]
	quest.0000000001000019.quest_subtitle: "石头 剑 Upgrade"
	quest.0000000001000019.title: "石头 剑 Upgrade"
	quest.0000000001000020.quest_desc: [
		"Ranged combat is the safest way to fight!"
		"Craft a bow with sticks and string."
		"Bows can be charged for more damage,"
		"a fully charged shot deals 9-10 damage."
		"Prepare plenty of arrows (64+),"
		"defeat monsters and Endermen from a distance."
		"Arrows can be enchanted with Infinity for unlimited use!"
	]
	quest.0000000001000020.quest_subtitle: "The Archer"
	quest.0000000001000020.title: "The Archer"
	quest.0000000001000021.quest_desc: [
		"Brave warrior, take up arms and hunt monsters!"
		"击杀 15 zombies for rotten flesh and XP,"
		"kill 15 skeletons for bones and arrows,"
		"kill 8 spiders for string and spider eyes."
		"These drops can be used for crafting and trading."
		"Bones tame wolves, string makes bows and fishing rods."
		"Hunt monsters at night for best results!"
	]
	quest.0000000001000021.quest_subtitle: "Monster Hunter"
	quest.0000000001000021.title: "Monster Hunter"
	quest.0000000001000022.quest_desc: [
		"Ssssss-BOOM! Keep creepers away from your home!"
		"击杀 8 creepers and collect 32 gunpowder."
		"Creepers explode after 3 seconds when close,"
		"use a bow for safer ranged attacks."
		"火药 is used 合成 TNT and firework rockets."
		"Beware! Creepers don't burn in daylight!"
	]
	quest.0000000001000022.quest_subtitle: "Creeper Bane"
	quest.0000000001000022.title: "Creeper Bane"
	quest.0000000001000023.quest_desc: [
		"The anvil is key to weapon and tool upgrades!"
		"需要 3 iron blocks and 4 iron ingots (31 total),"
		"anvils can rename items, repair tools,"
		"and combine enchanted books."
		"Anvils gradually degrade with use,"
		"eventually becoming a damaged anvil."
		"Invest XP at the anvil to improve your gear!"
	]
	quest.0000000001000023.quest_subtitle: "铁砧 锻造"
	quest.0000000001000023.title: "铁砧 锻造"
	quest.0000000001000024.quest_desc: [
		"恭喜! You've entered the 钻石时代!"
		"Find diamond ore near Y=-58,"
		"mine it with an iron pickaxe or better."
		"钻石 pickaxe can mine obsidian,"
		"a requirement for entering the Nether."
		"钻石 pickaxe has 1561 durability,"
		"6x that of an iron pickaxe!"
	]
	quest.0000000001000024.quest_subtitle: "钻石时代"
	quest.0000000001000024.title: "钻石时代"
	quest.0000000001000025.quest_desc: [
		"Open the gate to the hell dimension!"
		"You need at least 10 obsidian to build the portal."
		"黑曜石 can only be mined with a diamond pickaxe,"
		"create obsidian by pouring water over lava source blocks."
		"The portal frame is a 4x5 hollow rectangle,"
		"right-click with flint and steel to activate."
		"步骤 through the purple veil into the Nether!"
	]
	quest.0000000001000025.quest_subtitle: "下界传送门"
	quest.0000000001000025.title: "下界传送门"
	quest.0000000001000026.quest_desc: [
		"The Nether is a scorching and dangerous realm."
		"Collect 32 netherrack as building and crafting material."
		"荧石 dust is used for redstone lamps and arrow effects."
		"Soul sand is needed to summon the Wither,"
		"and is the soil for growing nether wart."
		"当心 lava and ghasts in the Nether!"
	]
	quest.0000000001000026.quest_subtitle: "Nether 探索"
	quest.0000000001000026.title: "Nether 探索"
	quest.0000000001000027.quest_desc: [
		"Find blaze spawners in Nether fortresses."
		"Blazes charge up before shooting fireballs,"
		"dodge or block with a shield!"
		"击杀 8 blazes for 8 blaze rods,"
		"blaze rods are essential for brewing and crafting ender eyes."
		"Craft blaze powder for brewing fuel."
	]
	quest.0000000001000027.quest_subtitle: "Blaze Hunter"
	quest.0000000001000027.title: "Blaze Hunter"
	quest.0000000001000028.quest_desc: [
		"Hunt Wither Skeletons in Nether fortresses."
		"Wither skeletons are 3 blocks tall, carry stone swords,"
		"and their attacks inflict the Wither effect."
		"击杀 5 Wither Skeletons and get one skull."
		"Wither skeleton skulls have only a 2.5% drop rate,"
		"you may need to kill many!"
		"Three skulls are needed to summon the Wither."
	]
	quest.0000000001000028.quest_subtitle: "Wither Skeleton"
	quest.0000000001000028.title: "Wither Skeleton"
	quest.0000000001000029.quest_desc: [
		"Piglins love gold!"
		"Drop gold ingots near piglins,"
		"they will pick them up and throw back items in exchange."
		"Piglin bartering yields ender pearls, soul sand,"
		"glowstone dust, nether quartz, and other valuables."
		"Wear gold armor and piglins won't attack you."
		"Prepare 16 gold ingots for large-scale bartering!"
	]
	quest.0000000001000029.quest_subtitle: "Piglin Bartering"
	quest.0000000001000029.title: "Piglin Bartering"
	quest.0000000001000030.quest_desc: [
		"Nether quartz is an ore found throughout the Nether."
		"Quartz ore can be found at any height in the Nether."
		"Quartz is used 合成 redstone comparators,"
		"daylight detectors, and diorite."
		"Quartz blocks are beautiful building materials,"
		"collect 64 quartz for building and crafting."
		"挖掘 quartz ore also gives good XP!"
	]
	quest.0000000001000030.quest_subtitle: "下界石英"
	quest.0000000001000030.title: "下界石英"
	quest.0000000001000031.quest_desc: [
		"Mine the most powerful ore — 远古残骸!"
		"Ancient debris only generates in the Nether at Y=8-22,"
		"search at Y=15 using bed explosions or TNT."
		"Ancient debris has extreme blast resistance,"
		"cannot be destroyed by any explosion."
		"Smelt in a furnace into netherite scrap,"
		"4 scraps craft 1 netherite ingot."
	]
	quest.0000000001000031.quest_subtitle: "远古残骸"
	quest.0000000001000031.title: "远古残骸"
	quest.0000000001000032.quest_desc: [
		"Obtain the most powerful material in the game!"
		"Upgrade diamond gear to netherite at a smithing table."
		"下界合金 gear does not burn in lava,"
		"and has higher durability and armor values."
		"Use 1 netherite ingot to upgrade one piece of gear,"
		"preserving existing enchantments and durability."
		"Wear full netherite and conquer everything!"
	]
	quest.0000000001000032.quest_subtitle: "下界合金"
	quest.0000000001000032.title: "下界合金"
	quest.0000000001000033.quest_desc: [
		"Potion brewing is a powerful support system!"
		"Craft a brewing stand with blaze rods and cobblestone."
		"Place water bottles in the bottom of the stand,"
		"and brewing ingredients on top."
		"Use nether wart 制作 awkward potions as a base,"
		"then add other ingredients for specific effects."
		"Glass bottles can be obtained from water sources or witches."
	]
	quest.0000000001000033.quest_subtitle: "酿造基础"
	quest.0000000001000033.title: "酿造基础"
	quest.0000000001000034.quest_desc: [
		"Dive deep into the art of potion brewing!"
		"Craft at least one bottle of any potion."
		"Collect dragon's breath 制作 lingering potions,"
		"lingering potions create a potion cloud on the ground."
		"Common potions: Strength, Swiftness, Regeneration,"
		"Fire 抗性, Night Vision, and Slow Falling."
		"Enhance with glowstone dust, extend with redstone!"
	]
	quest.0000000001000034.quest_subtitle: "Advanced 酿造"
	quest.0000000001000034.title: "Advanced 酿造"
	quest.0000000001000035.quest_desc: [
		"挑战 the world's most dangerous boss — the Wither!"
		"Summon using 3 wither skeleton skulls and 4 soul sand."
		"The Wither shoots explosive wither skulls,"
		"causing massive destruction and the Wither effect."
		"Summon underground or far from your base,"
		"prepare golden apples, strength, and regeneration potions."
		"击败 the Wither to obtain a Nether Star!"
	]
	quest.0000000001000035.quest_subtitle: "Wither Battle"
	quest.0000000001000035.title: "Wither Battle"
	quest.0000000001000036.quest_desc: [
		"Activate your beacon with a Nether Star!"
		"Place the beacon on top of a pyramid made of"
		"iron/gold/diamond/emerald/netherite blocks."
		"The pyramid needs at least 3x3 (9 blocks),"
		"and can go up to a 4-tier pyramid."
		"Beacons provide permanent area buffs:"
		"速度, Haste, 抗性, Strength, Jump Boost, and Regeneration."
		"Collect 36 iron blocks to build the beacon base!"
	]
	quest.0000000001000036.quest_subtitle: "信标 Light"
	quest.0000000001000036.title: "信标 Light"
	quest.0000000001000037.quest_desc: [
		"Long black figures flicker in the night."
		"Endermen only attack when you look at their head!"
		"They are neutral when you don't look at them."
		"击杀 10 Endermen for ender pearls."
		"Ender pearls are key to finding the stronghold."
		"Build a 2-block-high shelter to safely fight Endermen,"
		"since they are 3 blocks tall and can't fit in!"
	]
	quest.0000000001000037.quest_subtitle: "Enderman Hunter"
	quest.0000000001000037.title: "Enderman Hunter"
	quest.0000000001000038.quest_desc: [
		"Find the portal to the End!"
		"Craft eyes of ender with blaze powder and ender pearls."
		"右键点击 with an eye of ender to throw it into the air,"
		"it will fly towards the nearest stronghold."
		"You need up to 12 eyes of ender"
		"to activate the End portal frames."
		"Follow the eyes of ender 找到 the underground stronghold!"
	]
	quest.0000000001000038.quest_subtitle: "Journey to the End"
	quest.0000000001000038.title: "Journey to the End"
	quest.0000000001000039.quest_desc: [
		"Delve into the underground stronghold 找到 the portal room!"
		"The stronghold is filled with silverfish spawners,"
		"kill 5 silverfish and pass through their spawning areas."
		"Collect 16 end stone as a memento."
		"Place eyes of ender in the portal frames to activate."
		"Prepare thoroughly before entering the portal!"
		"Bring a bow, shield, and plenty of food."
	]
	quest.0000000001000039.quest_subtitle: "Stronghold 探索"
	quest.0000000001000039.title: "Stronghold 探索"
	quest.0000000001000040.quest_desc: [
		"Face the 末影龙 and end her reign!"
		"Destroy the End Crystals (on top of obsidian pillars) with a bow or snowballs,"
		"the crystals constantly heal the dragon."
		"The dragon perches on the central bedrock pillar,"
		"this is the best time to attack her."
		"After defeating the dragon, collect the dragon head as a trophy!"
		"The dragon egg appears on the bedrock pillar."
		"当心 the dragon's breath attack!"
	]
	quest.0000000001000040.quest_subtitle: "Dragonslayer"
	quest.0000000001000040.title: "Dragonslayer"
	quest.0000000001000041.quest_desc: [
		"Travel through the End Gateway to the outer islands!"
		"The outer islands are covered with chorus plants,"
		"collect 32 chorus fruit for eating and planting."
		"Search for End Cities on the outer islands,"
		"kill shulkers for shulker shells,"
		"collect 16 purpur blocks for building."
		"The End Cities also hold the precious 鞘翅!"
	]
	quest.0000000001000041.quest_subtitle: "End Outer Islands"
	quest.0000000001000041.title: "End Outer Islands"
	quest.0000000001000042.quest_desc: [
		"The sky is yours! Don the 鞘翅 and soar!"
		"Find the 鞘翅 in an End City ship."
		"Wear the 鞘翅, jump from a high place, and press space to glide."
		"Use firework rockets with 鞘翅 for propelled flight,"
		"craft 32 firework rockets as flight fuel."
		"鞘翅 can also combine with a Riptide trident for fast flight."
		"From now on, the sky is your domain!"
	]
	quest.0000000001000042.quest_subtitle: "鞘翅 Flight"
	quest.0000000001000042.title: "鞘翅 Flight"
	quest.0000000001000043.quest_desc: [
		"Shulkers are one of the most fearsome End mobs!"
		"Shulkers cling to the walls of End Cities,"
		"shooting homing projectiles that make targets levitate."
		"Shulker shells are the only material for shulker boxes,"
		"shulker boxes are portable containers — an expandable backpack!"
		"Craft 4 shulker boxes for storage expansion."
		"Shulker boxes retain their contents even when broken."
	]
	quest.0000000001000043.quest_subtitle: "Shulker Farm"
	quest.0000000001000043.title: "Shulker Farm"
	quest.0000000001000044.quest_desc: [
		"You have fully conquered the End dimension!"
		"Display a dragon head, elytra, 8 shulker boxes,"
		"and 64 ender pearls,"
		"proving 你已经 mastered everything in the End."
		"From defeating the 末影龙 to exploring the outer islands,"
		"你已经 endured a long and difficult journey."
		"The End holds no more secrets!"
	]
	quest.0000000001000044.quest_subtitle: "End Conquest"
	quest.0000000001000044.title: "End Conquest"
	quest.0000000001000045.quest_desc: [
		"Villagers are your best trading partners!"
		"Find a village and interact with villagers to trade."
		"Trade crops and minerals with villagers for emeralds."
		"Collect 16 emeralds and 4 emerald blocks."
		"Different villager professions offer different trades."
		"Repeat trades 解锁 better trading options,"
		"discounted trades are even more worthwhile!"
	]
	quest.0000000001000045.quest_subtitle: "Villager Trading"
	quest.0000000001000045.title: "Villager Trading"
	quest.0000000001000046.quest_desc: [
		"The librarian is the guardian of knowledge."
		"Craft a lectern with 9 books and 6 planks,"
		"a lectern lets unemployed villagers become librarians."
		"Collect 16 bookshelves to empower your enchanting table."
		"Bookshelves are key to boosting enchantment levels."
		"Trade with librarians to obtain enchanted books!"
	]
	quest.0000000001000046.quest_subtitle: "The Librarian"
	quest.0000000001000046.title: "The Librarian"
	quest.0000000001000047.quest_desc: [
		"Man's best friend — tame a wolf!"
		"Find wild wolves in taiga and forest biomes,"
		"right-click with bones for a chance to tame them."
		"Tamed wolves will follow and protect you,"
		"automatically attacking anything that hurts you or you attack."
		"Prepare 16 bones for taming attempts,"
		"and wheat to breed your tamed wolves."
	]
	quest.0000000001000047.quest_subtitle: "Tame the Wolf"
	quest.0000000001000047.title: "Tame the Wolf"
	quest.0000000001000048.quest_desc: [
		"Creepers fear cats more than players!"
		"Find stray cats near villages,"
		"sneak close and tame them with raw cod or raw salmon."
		"Cats follow their owner when sleeping and bring little gifts,"
		"creepers and phantoms actively avoid cats."
		"Prepare 16 fish for taming attempts,"
		"there are 11 different cat variants!"
	]
	quest.0000000001000048.quest_subtitle: "Tame the Cat"
	quest.0000000001000048.title: "Tame the Cat"
	quest.0000000001000049.quest_desc: [
		"附魔 is the ultimate way to enhance gear!"
		"Craft an enchanting table with 4 obsidian, 2 diamonds, and 1 book."
		"Surround the table with bookshelves for high-level enchantments,"
		"level 30 enchants require 15 bookshelves around it."
		"附魔 costs XP and lapis lazuli,"
		"greatly improving gear power and durability."
		"附魔 swords, pickaxes, bows, and armor is core gameplay!"
	]
	quest.0000000001000049.quest_subtitle: "Path of 附魔"
	quest.0000000001000049.title: "Path of 附魔"
	quest.0000000001000050.quest_desc: [
		"Master the ultimate art of enchanting!"
		"Obtain 4 enchanted books — through fishing,"
		"villager trading, or the enchanting table."
		"Use an anvil to apply enchanted books to gear."
		"Collect 64 lapis lazuli as enchantment fuel,"
		"master the strategy of stacking multiple enchantments."
		"Recommended enchants: Efficiency V, Unbreaking III, Sharpness V!"
	]
	quest.0000000001000050.quest_subtitle: "附魔 Master"
	quest.0000000001000050.title: "附魔 Master"
	quest.0000000001000051.quest_desc: [
		"装备 always wears down, learn to repair it!"
		"Craft a grindstone with 2 sticks, 1 stone slab, and 2 planks."
		"The grindstone removes enchantments and returns some XP."
		"Repair gear at an anvil using base materials:"
		"use iron ingots to repair iron tools and armor."
		"Stockpile 32 iron ingots for repairs."
		"The Mending enchantment auto-repairs gear!"
	]
	quest.0000000001000051.quest_subtitle: "Repair 装备"
	quest.0000000001000051.title: "Repair 装备"
	quest.0000000001000052.quest_desc: [
		"Diamonds make the highest-tier equipment!"
		"钻石 chestplate provides 8 armor points,"
		"2 more than iron chestplate, with significant damage reduction."
		"钻石 gear has far higher durability than iron,"
		"it will accompany you through most of the game."
		"With diamond armor, 你可以 challenge"
		"Nether fortresses, the End, and other dangerous areas!"
	]
	quest.0000000001000052.quest_subtitle: "钻石 护甲"
	quest.0000000001000052.title: "钻石 护甲"
	quest.0000000001000053.quest_desc: [
		"Wear a full set of diamond armor and shine!"
		"Full diamond requires 24 diamonds,"
		"providing 20 max armor points."
		"钻石 helmet, leggings, and boots,"
		"plus the diamond chestplate, complete the diamond set."
		"Full diamond reduces damage by 80%!"
		"The minimum setup for challenging the Wither and 末影龙."
	]
	quest.0000000001000053.quest_subtitle: "Full 钻石 Set"
	quest.0000000001000053.title: "Full 钻石 Set"
	quest.0000000001000054.quest_desc: [
		"A true symbol of wealth — the 钻石 Block!"
		"Craft 1 diamond block using 9 diamonds."
		"Show off your vast diamond reserves."
		"钻石 blocks can be used in beacon bases,"
		"and are the best choice for luxurious builds."
		"Flaunt your wealth and gathering prowess!"
	]
	quest.0000000001000054.quest_subtitle: "钻石 Block"
	quest.0000000001000054.title: "钻石 Block"
	quest.0000000001000055.quest_desc: [
		"恭喜! You have completed 原版生存基础!"
		"From your first log to defeating the Wither and 末影龙,"
		"你已经 mastered everything in vanilla Minecraft."
		"You have displayed a diamond block, nether star,"
		"dragon head, and enchanted golden apple —"
		"the highest honors of your journey."
		"New adventures await you ahead!"
	]
	quest.0000000001000055.quest_subtitle: "章节 Graduation"
	quest.0000000001000055.title: "章节 One Graduation"
	quest.0000000002000001.quest_desc: [
		"欢迎来到烹饪与水章节！"
		"本章涵盖四个系统："
		"  Farmer's Delight — 从农场到餐桌"
		"  Kaleidoscope Cookery — 精致美食"
		"  Kaleidoscope Tavern — 酒吧经营"
		"  Thirst Was Taken — 饮水系统"
	]
	quest.0000000002000001.quest_subtitle: "章节 Entry"
	quest.0000000002000001.title: "Culinary Journey"
	quest.0000000002000002.quest_desc: [
		"切菜板是你在Farmer's Delight中"
		"准备食材所需的第一件工具。"
		"放置切菜板后，使用刀在上面"
		"将食材切碎用于烹饪。"
	]
	quest.0000000002000002.quest_subtitle: "Prepare your ingredients"
	quest.0000000002000002.title: "Kitchen Basics"
	quest.0000000002000003.quest_desc: [
		"煎锅用于煎炒和烤制食物。"
		"将其放在炉灶或营火等热源上方，"
		"直接加入食材来煎肉、蛋等。"
	]
	quest.0000000002000003.quest_subtitle: "Frying made easy"
	quest.0000000002000003.title: "Skillet Cooking"
	quest.0000000002000004.quest_desc: [
		"炉灶是核心烹饪站，为所有烹饪"
		"设备提供永久热源。"
		"它无需营火，可同时运行"
		"多个锅具和平底锅。"
	]
	quest.0000000002000004.quest_subtitle: "Permanent cooking heat"
	quest.0000000002000004.title: "Stove Heat"
	quest.0000000002000005.quest_desc: [
		"将烹饪锅放在炉灶上，解锁其"
		"制作汤羹、炖菜和盛宴的全部潜力。"
		"加入水、食材和热源，烹饪复杂"
		"菜肴，恢复大量饱食度。"
	]
	quest.0000000002000005.quest_subtitle: "Hearty meals await"
	quest.0000000002000005.title: "FD Crops"
	quest.0000000002000006.quest_desc: [
		"篮子是一种便携式存储容器，"
		"专为食物和作物设计。"
		"用它整理厨房，将收获的作物"
		"从农田运回基地。"
	]
	quest.0000000002000006.quest_subtitle: "Portable food storage"
	quest.0000000002000006.title: "Crop 种子"
	quest.0000000002000007.quest_desc: [
		"肥沃土壤是通过让有机堆肥"
		"自然发酵生成的。"
		"其作物生长速度显著快于普通"
		"耕地，并具有天然保水能力。"
	]
	quest.0000000002000007.quest_subtitle: "Supercharged farmland"
	quest.0000000002000007.title: "Rich Soil"
	quest.0000000002000008.quest_desc: [
		"有机堆肥由作物残渣、"
		"腐坏食物等有机材料制成。"
		"将其撒在地面上，等待其转化为"
		"肥沃土壤，加速作物生长。"
	]
	quest.0000000002000008.quest_subtitle: "Nature's fertilizer"
	quest.0000000002000008.title: "Kitchen Knives"
	quest.0000000002000009.quest_desc: [
		"水稻是在肥沃土壤浅水层中"
		"生长的主食谷物。"
		"收获水稻制作熟米饭，这是"
		"炒饭等众多菜肴的基础。"
	]
	quest.0000000002000009.quest_subtitle: "Staple crop farming"
	quest.0000000002000009.title: "Simple Cooking"
	quest.000000000200000A.quest_desc: [
		"洋葱是多种Farmer's Delight"
		"食谱中通用的蔬菜。"
		"它们为汤羹、炖菜、三明治"
		"和沙拉增添风味。"
	]
	quest.000000000200000A.quest_subtitle: "Versatile vegetable"
	quest.000000000200000A.title: "Onion"
	quest.000000000200000B.quest_desc: [
		"番茄是酱料、沙拉和三明治的"
		"厨房必备品。"
		"在肥沃土壤上种植番茄种子，"
		"收获用于意面和汉堡。"
	]
	quest.000000000200000B.quest_subtitle: "Sauce and salad staple"
	quest.000000000200000B.title: "Tomato"
	quest.000000000200000C.quest_desc: [
		"卷心菜叶片可从一株植物上"
		"多次收获，无需重新种植。"
		"用于制作卷心菜卷、沙拉以及"
		"各种蔬菜料理。"
	]
	quest.000000000200000C.quest_subtitle: "Leafy green harvest"
	quest.000000000200000C.title: "Cabbage"
	quest.000000000200000D.quest_desc: [
		"燧石小刀是在切菜板上"
		"处理食材的基础切削工具。"
		"用于切蔬菜、切肉，以及从"
		"草和植物中收获额外资源。"
	]
	quest.000000000200000D.quest_subtitle: "Basic cutting tool"
	quest.000000000200000D.title: "燧石 Knife"
	quest.000000000200000E.quest_desc: [
		"铁刀比燧石刀更耐用，"
		"处理食材速度更快。"
		"升级工具以加速食物准备，"
		"减少切割设备的磨损。"
	]
	quest.000000000200000E.quest_subtitle: "Durable kitchen tool"
	quest.000000000200000E.title: "铁 Knife"
	quest.000000000200000F.quest_desc: [
		"钻石刀是高级切削工具，"
		"具有卓越的耐久度和速度。"
		"它能迅速完成任何食材加工，"
		"是值得长期投资的好工具。"
	]
	quest.000000000200000F.quest_subtitle: "Precision cutting"
	quest.000000000200000F.title: "钻石 Knife"
	quest.0000000002000010.quest_desc: [
		"下界合金刀是终极切割工具，"
		"拥有超强耐久度和无与伦比的速度。"
		"这是你厨房武器库的最终升级。"
	]
	quest.0000000002000010.quest_subtitle: "Ultimate kitchen blade"
	quest.0000000002000010.title: "Salads"
	quest.0000000002000011.quest_desc: [
		"烤鸡是一道丰盛的菜肴，提供"
		"丰富的营养和饱食度。"
		"在烹饪锅中将整只鸡与蔬菜一起"
		"烹饪，享用这份美味大餐。"
	]
	quest.0000000002000011.quest_subtitle: "Hearty protein meal"
	quest.0000000002000011.title: "Soups"
	quest.0000000002000012.quest_desc: [
		"牛排土豆是一道经典高蛋白料理，"
		"将牛肉与丰厚的土豆完美结合。"
		"在烹饪锅中将牛肉和土豆一起烹饪，"
		"享用这道营养美味的菜肴。"
	]
	quest.0000000002000012.quest_subtitle: "Classic comfort food"
	quest.0000000002000012.title: "Seafood"
	quest.0000000002000013.quest_desc: [
		"汉堡是包含面包、肉类和"
		"新鲜蔬菜的完整一餐。"
		"提供极佳的饱和度，适合"
		"长期冒险和采矿探险。"
	]
	quest.0000000002000013.quest_subtitle: "完成 handheld meal"
	quest.0000000002000013.title: "Noodles  Dumplings"
	quest.0000000002000014.quest_desc: [
		"混合沙拉将各种蔬菜组合成"
		"一道清淡营养的餐食。"
		"用卷心菜、番茄和洋葱快速制作，"
		"是游戏早期的理想食物供应。"
	]
	quest.0000000002000014.quest_subtitle: "Light and nutritious"
	quest.0000000002000014.title: "Rice Dishes"
	quest.0000000002000015.quest_desc: [
		"水果沙拉用多种新鲜水果"
		"为你的饮食增添天然甜味。"
		"清爽的餐食，提供良好的营养"
		"和换换口味的美味体验。"
	]
	quest.0000000002000015.quest_subtitle: "Sweet and refreshing"
	quest.0000000002000015.title: "Meat Platters"
	quest.0000000002000016.quest_desc: [
		"填馅南瓜是一道节日盛宴菜品，"
		"将南瓜与丰富的食材相结合。"
		"它既是装饰品也是营养餐食，"
		"标志着你对Farmer's Delight烹饪的精通。"
	]
	quest.0000000002000016.quest_subtitle: "Festive feast item"
	quest.0000000002000016.title: "Sandwiches"
	quest.0000000002000017.quest_desc: [
		"万物蒸煮炉是用于高级料理的"
		"多功能烹饪站。"
		"支持炒锅、汤锅、蒸笼和煎锅，"
		"实现多样化的中式烹饪方式。"
	]
	quest.0000000002000017.quest_subtitle: "万花筒 cooking station"
	quest.0000000002000017.title: "Drinks"
	quest.0000000002000018.quest_desc: [
		"炒锅用于在万物蒸煮炉上"
		"进行高温翻炒。"
		"搭配油和食材快速烹制"
		"美味的中式炒菜。"
	]
	quest.0000000002000018.quest_subtitle: "High-heat stir-frying"
	quest.0000000002000018.title: "Bakery"
	quest.0000000002000019.quest_desc: [
		"汤锅用于在万物蒸煮炉上"
		"慢炖浓郁的高汤和汤品。"
		"它是制作高汤的必备工具，"
		"高汤是许多中国菜的风味基础。"
	]
	quest.0000000002000019.quest_subtitle: "Slow-cooking broths"
	quest.0000000002000019.title: "Storage"
	quest.000000000200001A.quest_desc: [
		"蒸笼用蒸汽烹饪食物，保留"
		"营养和细腻的口感。"
		"用于制作饺子、包子和其他"
		"中式蒸制美味。"
	]
	quest.000000000200001A.quest_subtitle: "Steam-cooked delicacies"
	quest.000000000200001A.title: "Steamer"
	quest.000000000200001B.quest_desc: [
		"茶壶用各种原料冲泡茶水，"
		"获得独特的效果。"
		"茶与甜点完美搭配，为烹饪"
		"之余带来片刻放松。"
	]
	quest.000000000200001B.quest_subtitle: "Brew soothing tea"
	quest.000000000200001B.title: "Teapot"
	quest.000000000200001C.quest_desc: [
		"万物砧板用于加工"
		"高级食谱所需食材。"
		"配合厨房刀使用，制作饺子皮"
		"和其他专用食材。"
	]
	quest.000000000200001C.quest_subtitle: "Precision prep surface"
	quest.000000000200001C.title: "KaC Chopping Board"
	quest.000000000200001D.quest_desc: [
		"万物厨房刀专为"
		"食材的精准切割设计。"
		"在砧板上使用，准备"
		"中式料理所需的食材。"
	]
	quest.000000000200001D.quest_subtitle: "KaC precision blade"
	quest.000000000200001D.title: "Kitchen Knife"
	quest.000000000200001E.quest_desc: [
		"食用油是翻炒和煎炸"
		"所需的基础食材。"
		"用磨石从种子中榨取，"
		"储存在炉灶旁的油壶中。"
	]
	quest.000000000200001E.quest_subtitle: "Essential stir-fry ingredient"
	quest.000000000200001E.title: "Cooking Oil"
	quest.000000000200001F.quest_desc: [
		"煎锅用于将饺子、肉类等"
		"食材煎至金黄香脆。"
		"需要油和万物蒸煮炉的"
		"热源才能运行。"
	]
	quest.000000000200001F.quest_subtitle: "Golden pan-frying"
	quest.000000000200001F.title: "Frying Pan"
	quest.0000000002000020.quest_desc: [
		"蛋炒饭是一道经典简餐，"
		"用米饭、鸡蛋和少许油制作。"
		"快速又美味的餐食，容易大批量"
		"制作，为冒险做好准备。"
	]
	quest.0000000002000020.quest_subtitle: "Classic simple dish"
	quest.0000000002000020.title: "Organic Composting"
	quest.0000000002000021.quest_desc: [
		"麻婆豆腐是一道辛辣的川菜，"
		"以豆腐和肉末搭配浓郁酱料。"
		"提供充足的营养，代表了"
		"高级中式烹饪技巧。"
	]
	quest.0000000002000021.quest_subtitle: "Culinary Master"
	quest.0000000002000021.title: "FD Master"
	quest.0000000002000022.quest_desc: [
		"宫保鸡丁是一道香辣炒菜，"
		"包含鸡肉、花生和彩色蔬菜。"
		"高蛋白菜品，恢复大量饱食度，"
		"展示了炒锅的精湛技艺。"
	]
	quest.0000000002000022.quest_subtitle: "Nutty spicy stir-fry"
	quest.0000000002000022.title: "KaC Kitchen"
	quest.0000000002000023.quest_desc: [
		"点心是一系列小份蒸制美食，"
		"展现了茶点文化的艺术。"
		"使用砧板和蒸笼制作，"
		"以小份量提供优质营养。"
	]
	quest.0000000002000023.quest_subtitle: "Steamed bite-sized treats"
	quest.0000000002000023.title: "Chinese Cuisine"
	quest.0000000002000024.quest_desc: [
		"樱花吹雪是一道精致的甜点，"
		"带有淡雅的樱花风味。"
		"高级菜品，展示了万物烹饪"
		"和甜点艺术的高超技艺。"
	]
	quest.0000000002000024.quest_subtitle: "Cherry blossom elegance"
	quest.0000000002000024.title: "Japanese Cuisine"
	quest.0000000002000025.quest_desc: [
		"麻薯是一种甜味年糕甜点，"
		"夹心多样，口感软糯Q弹。"
		"经典的日式点心，丰富了"
		"万物烹饪的甜点菜单。"
	]
	quest.0000000002000025.quest_subtitle: "Sweet rice cake dessert"
	quest.0000000002000025.title: "Western Cuisine"
	quest.0000000002000026.quest_desc: [
		"吧台是你在万物酒馆中"
		"的核心设施。"
		"放置吧台，开始布置你的个人"
		"酒吧和饮品待客区。"
	]
	quest.0000000002000026.quest_subtitle: "Tavern centerpiece"
	quest.0000000002000026.title: "KaC Desserts"
	quest.0000000002000027.quest_desc: [
		"吧柜用于存放酒瓶、杯子"
		"和酒吧工具。"
		"帮助整理酿造原料，"
		"调酒时取用方便。"
	]
	quest.0000000002000027.quest_subtitle: "Tavern storage"
	quest.0000000002000027.title: "Barley Tea"
	quest.0000000002000028.quest_desc: [
		"酒窖柜专为在凉爽地下"
		"储存陈酿酒饮设计。"
		"它能保存葡萄酒和烈酒，"
		"随时间推移提升品质和效果。"
	]
	quest.0000000002000028.quest_subtitle: "Aging and preservation"
	quest.0000000002000028.title: "KaC Decor"
	quest.0000000002000029.quest_desc: [
		"黑色吧椅为酒吧客人"
		"提供吧台座位。"
		"在吧台周围摆放多把，营造"
		"温馨完整的酒吧氛围。"
	]
	quest.0000000002000029.quest_subtitle: "Seating for guests"
	quest.0000000002000029.title: "KaT Tavern"
	quest.000000000200002A.quest_desc: [
		"黑色沙发为酒吧休息区和"
		"放松空间增添舒适座椅。"
		"为长途冒险后享用饮品的"
		"客人营造温馨的氛围。"
	]
	quest.000000000200002A.quest_subtitle: "Lounge comfort"
	quest.000000000200002A.title: "Sofa"
	quest.000000000200002B.quest_desc: [
		"空瓶由玻璃制作，是酿造"
		"饮品必不可少的材料。"
		"装入各种原料后在酒窖柜中陈酿，"
		"制作出精美的饮品。"
	]
	quest.000000000200002B.quest_subtitle: "酿造 essentials"
	quest.000000000200002B.title: "Empty Bottle"
	quest.000000000200002C.quest_desc: [
		"白兰地是一种蒸馏葡萄酒烈酒，"
		"在酒吧提供独特的状态效果。"
		"将酒在酒窖柜中陈化后蒸馏，"
		"即可生产这款精致的饮品。"
	]
	quest.000000000200002C.quest_subtitle: "Distilled wine spirit"
	quest.000000000200002C.title: "Brandy"
	quest.000000000200002D.quest_desc: [
		"香槟是为庆典和特殊场合"
		"酿造的起泡葡萄酒。"
		"提供特殊增益，代表了"
		"酿造工艺的巅峰。"
	]
	quest.000000000200002D.quest_subtitle: "Sparkling celebration"
	quest.000000000200002D.title: "Champagne"
	quest.000000000200002E.quest_desc: [
		"血腥玛丽是混合番茄汁、"
		"香料和烈酒的复杂鸡尾酒。"
		"提供独特效果，展示你"
		"在酒吧中逐渐成长的调酒技艺。"
	]
	quest.000000000200002E.quest_subtitle: "Savory cocktail"
	quest.000000000200002E.title: "Bloody Mary"
	quest.000000000200002F.quest_desc: [
		"深水炸弹是将一小杯烈酒"
		"投入啤酒杯中饮用的强劲酒饮。"
		"提供显著效果，是勇敢"
		"顾客的终极酒吧特调。"
	]
	quest.000000000200002F.quest_subtitle: "Ultimate tavern drink"
	quest.000000000200002F.title: "Depth Charge"
	quest.0000000002000030.quest_desc: [
		"空玻璃器皿用于在酒吧中"
		"专业地供应饮品。"
		"制作各种杯子和马克杯，"
		"优雅而时尚地呈现你的饮品。"
	]
	quest.0000000002000030.quest_subtitle: "Serve in style"
	quest.0000000002000030.title: "Bar Seating"
	quest.0000000002000031.quest_desc: [
		"黑板用于向客人展示"
		"酒吧的菜单。"
		"写下可供应的饮品和菜肴，"
		"营造温馨的酒吧氛围。"
	]
	quest.0000000002000031.quest_subtitle: "Tavern menu display"
	quest.0000000002000031.title: "Bar Cocktails"
	quest.0000000002000032.quest_desc: [
		"熏香以宜人的香气为酒吧"
		"营造放松的氛围。"
		"制作蝴蝶熏香或猫薄荷熏香，"
		"为客人创造不同的氛围效果。"
	]
	quest.0000000002000032.quest_subtitle: "Aromatic ambiance"
	quest.0000000002000032.title: "Bar Reserve"
	quest.0000000002000033.quest_desc: [
		"陶碗是第一个用来盛水"
		"和饮水的容器。"
		"从水源舀水解渴，"
		"开始在这个世界中生存。"
	]
	quest.0000000002000033.quest_subtitle: "First water container"
	quest.0000000002000033.title: "Tavern Decor"
	quest.0000000002000034.quest_desc: [
		"陶罐是升级版饮水"
		"容器，容量更大。"
		"比基础陶碗装更多水且更耐用，"
		"适合更长途的旅行。"
	]
	quest.0000000002000034.quest_subtitle: "Upgraded water container"
	quest.0000000002000034.title: "Tavern Garden"
	quest.0000000002000035.quest_desc: [
		"陶水碗盛装净化后的"
		"饮用水供安全饮用。"
		"保持它装满水，在长时间"
		"采矿和冒险中维持口渴值。"
	]
	quest.0000000002000035.quest_subtitle: "Purified drinking water"
	quest.0000000002000035.title: "Tavern Paintings"
	quest.0000000002000036.quest_desc: [
		"沙子过滤器用沙子和砾石层"
		"将脏水净化为干净饮用水。"
		"当干净水源稀缺或远离基地时，"
		"对生存至关重要。"
	]
	quest.0000000002000036.quest_subtitle: "Water purification"
	quest.0000000002000036.title: "Bar Trinkets"
	quest.0000000002000037.quest_desc: [
		"来自Comforts的睡袋让你可以"
		"随地睡觉而不会重置出生点。"
		"非常适合远离基地床铺"
		"进行探索和旅行。"
	]
	quest.0000000002000037.quest_subtitle: "Sleep anywhere"
	quest.0000000002000037.title: "KaC/KaT Master"
	quest.0000000002000038.quest_desc: [
		"吊床是一种可以在树木或"
		"柱子之间悬挂的便携睡眠方案。"
		"在野外提供舒适的休息，"
		"且不会重置你的出生点。"
	]
	quest.0000000002000038.quest_subtitle: "线 up and rest"
	quest.0000000002000038.title: "口渴值 System"
	quest.0000000002000039.quest_desc: [
		"传送石碑是创建快速旅行"
		"网络的传送锚点。"
		"在重要地点放置传送石碑并激活，"
		"即可启用传送功能。"
	]
	quest.0000000002000039.quest_subtitle: "Teleportation anchor"
	quest.0000000002000039.title: "Upgraded Bowls"
	quest.000000000200003A.quest_desc: [
		"传送石是一种便携设备，可让"
		"你传送到任何已激活的传送石碑。"
		"随身携带，从世界任何地方"
		"返回家园或在基地间旅行。"
	]
	quest.000000000200003A.quest_subtitle: "Portable teleportation"
	quest.000000000200003A.title: "Warp 石头"
	quest.0000000002000040.title: "Sand Filter"
	quest.0000000002000041.title: "Water Master"
	quest.0000000002000042.title: "Sleeping 装备"
	quest.0000000002000043.title: "Rope  Nail"
	quest.0000000002000044.title: "传送石碑"
	quest.0000000002000045.title: "生存 Master"
	quest.0000000002000046.title: "更多 BBQ"
	quest.0000000002000047.title: "Skewers"
	quest.0000000002000048.title: "Ice  Cookies"
	quest.0000000002000049.title: "牛奶  Broth"
	quest.0000000002000050.quest_desc: [
		"恭喜！你已精通烹饪艺术！"
		"从农场到酒吧，你是终极烹饪大师！"
	]
	quest.0000000002000050.quest_subtitle: "章节 完成"
	quest.0000000002000050.title: "Culinary Graduation"
	quest.0000000003000001.quest_desc: [
		"原版箱子时代即将结束！"
		"本章介绍现代存储系统："
		"精致背包："
		"- 多层级可升级便携背包"
		"- 自动拾取、自动喂食、流体存储"
		"- 升级槽位用于自定义功能"
		"精致存储："
		"- 多层级木桶、箱子和潜影盒"
		"- 存储控制器实现统一网络管理"
		"- 无线/有线存储访问终端"
		"准备4个原版箱子作为基础"
		"开始你的存储革命！"
	]
	quest.0000000003000001.quest_subtitle: "Farewell to messy chests"
	quest.0000000003000001.title: "Storage Revolution"
	quest.0000000003000002.quest_desc: [
		"这是你的第一个精致背包！"
		"右键打开背包界面。"
		"基础背包提供27个存储槽位，"
		"相当于一个小箱子。"
		"精致背包的核心功能："
		"- 升级槽位（初始1个）"
		"- 可安装拾取升级、合成升级等"
		"- 潜行+右键可放置在地面"
		"- 破坏后保留所有物品和升级"
		"提交一个基础背包，开始你的升级之旅！"
	]
	quest.0000000003000002.quest_subtitle: "Sophisticated Backpack Intro"
	quest.0000000003000002.title: "Basic Backpack"
	quest.0000000003000003.quest_desc: [
		"将基础背包升级为铁背包！"
		"铁背包属性："
		"- 存储：54个槽位（双箱子大小）"
		"- 升级槽位：2个"
		"- 更坚固的材质，金属外观"
		"合成方法："
		"用铁锭环绕基础背包合成"
		"（查看JEI获取精确配方）"
		"每次升级都会显著提升"
		"容量和功能！"
	]
	quest.0000000003000003.quest_subtitle: "铁 Backpack - 更多 Space"
	quest.0000000003000003.title: "铁 Upgrade"
	quest.0000000003000004.quest_desc: [
		"从铁背包升级到金背包！"
		"金背包属性："
		"- 存储：81个槽位"
		"- 升级槽位：3个"
		"- 金色外观，奢华造型"
		"金材质背包采用特殊的"
		"空间折叠魔法，"
		"比铁背包多50%容量！"
		"用金锭环绕铁背包合成。"
	]
	quest.0000000003000004.quest_subtitle: "金 Backpack - 速度 and Luxury"
	quest.0000000003000004.title: "金 Upgrade"
	quest.0000000003000005.quest_desc: [
		"从金背包升级到钻石背包！"
		"钻石背包属性："
		"- 存储：108个槽位"
		"- 升级槽位：4个"
		"- 钻石材质，提升爆炸抗性"
		"钻石背包能满足几乎"
		"所有日常冒险存储需求。"
		"搭配升级模块，功能更加强大。"
		"但还有终极升级在等待……"
		"还有一个升级等级等待着你！"
	]
	quest.0000000003000005.quest_subtitle: "钻石 Backpack - Top Capacity"
	quest.0000000003000005.title: "钻石 Upgrade"
	quest.0000000003000006.quest_desc: [
		"精致背包的终极形态！"
		"下界合金背包属性："
		"- 存储：135个槽位"
		"- 升级槽位：5个"
		"- 免疫火焰和熔岩销毁"
		"- 虚空抗性——掉入虚空也不会消失"
		"升级需要下界合金升级锻造模板。"
		"将钻石背包与下界合金锭合成。"
		"拥有它，你几乎不再需要"
		"任何额外的便携存储！"
	]
	quest.0000000003000006.quest_subtitle: "Ultimate Portable Warehouse"
	quest.0000000003000006.title: "下界合金升级"
	quest.0000000003000007.quest_desc: [
		"精致存储提供多层级容器系统。"
		"木桶是精致存储的基础容器。"
		"特点："
		"- 像原版木桶一样摆放和使用"
		"- 支持多材质升级（铁/金/钻石/下界合金）"
		"- 每级升级增加更多存储空间"
		"- 破坏后保留物品和升级"
		"- 可接入存储网络进行统一管理"
		"制作2个基础木桶开始使用！"
	]
	quest.0000000003000007.quest_subtitle: "高级存储 Basics"
	quest.0000000003000007.title: "Barrels"
	quest.0000000003000008.quest_desc: [
		"精致存储的木桶/箱子/潜影盒"
		"支持四个材质升级等级："
		"铁 — 基础升级，额外空间"
		"金 — 更大容量，更快访问"
		"钻石 — 大幅扩容，增强爆炸抗性"
		"下界合金 — 终极升级，免疫火焰"
		"每级升级需要对应的矿物块。"
		"收集全部四种材料，"
		"为你的存储网络做好准备！"
	]
	quest.0000000003000008.quest_subtitle: "Four Upgrade 材料"
	quest.0000000003000008.title: "Barrel Upgrades"
	quest.0000000003000009.quest_desc: [
		"存储控制器是整个存储系统的心脏！"
		"放置后，它管理附近"
		"所有已连接的存储容器。"
		"功能："
		"- 统一物品搜索界面"
		"- 跨容器物品管理"
		"- 支持存储链接扩展网络范围"
		"- 支持无线终端远程访问"
		"有了控制器，你不再需要记住"
		"每个箱子里放了什么。"
		"一切通过一个界面管理！"
	]
	quest.0000000003000009.quest_subtitle: "Core of Storage Network"
	quest.0000000003000009.title: "Storage Controller"
	quest.0000000003000010.quest_desc: [
		"存储链接扩展控制器的覆盖范围。"
		"默认情况下，控制器只管理"
		"周围有限范围内的容器。"
		"使用存储链接可以："
		"- 将远方容器接入网络"
		"- 跨楼层和房间桥接"
		"- 构建大规模自动化仓库"
		"每个链接连接一个容器组。"
		"制作4个存储链接，"
		"为大型存储网络奠定基础！"
	]
	quest.0000000003000010.quest_subtitle: "Expand Your Storage Network"
	quest.0000000003000010.title: "Storage Link"
	quest.0000000003000011.quest_desc: [
		"将你所有的存储知识付诸实践！"
		"构建完整存储网络需要："
		"- 16个箱子 — 作为基础存储单元"
		"- 4个木桶 — 作为辅助存储容器"
		"将这些容器放置在控制器周围，"
		"使用存储链接扩展网络范围。"
		"你的首个自动化仓库"
		"即将上线！"
		"告别翻箱倒柜的日子！"
	]
	quest.0000000003000011.quest_subtitle: "Build Automated Warehouse"
	quest.0000000003000011.title: "Storage Network"
	quest.0000000003000012.quest_desc: [
		"恭喜！你已成为存储大师！"
		"你已掌握："
		"- 精致背包的五级升级系统"
		"- 精致存储的多层级容器升级"
		"- 存储控制器与链接的网络架构"
		"- 自动化仓库的构建方法"
		"拥有下界合金背包和存储控制器，"
		"你是这个服务器上最顶尖的"
		"物品管理专家之一！"
		"带着你的便携仓库和存储网络"
		"去征服更伟大的目标！"
	]
	quest.0000000003000012.quest_subtitle: "The True 存储大师"
	quest.0000000003000012.title: "存储大师 Graduation"
	quest.0000000003000013.quest_subtitle: "Connect Your Network"
	quest.0000000003000013.title: "Storage Link"
	quest.0000000003000014.quest_desc: [
		"恭喜！你已掌握本世界的存储之道。"
		"领取完成存储大师章节的奖励。"
	]
	quest.0000000003000014.quest_subtitle: "完成 the 章节"
	quest.0000000003000014.title: "存储大师 Graduation"
	quest.0000000004000001.quest_desc: [
		"Macaw 是一套模块化建造模组"
		"提供窗户、门、栅栏、家具和桥梁。"
		"本整合包安装的 Macaw 模组："
		"- Windows - 窗户和百叶窗"
		"- Doors - 多种门样式"
		"- Fences - 栅栏和树篱"
		"- Furniture - 室内家具"
		"- Bridges - 桥梁建造"
		"让我们从最基础的开始：窗户！"
	]
	quest.0000000004000001.quest_subtitle: "Macaw's Modular"
	quest.0000000004000001.title: "建造 Basics"
	quest.0000000004000002.quest_desc: [
		"Macaw 的窗户模组提供多种窗户样式。"
		"从橡木变体开始你的窗户之旅："
		"- 橡木窗户 - 基础窗框"
		"- 橡木百叶窗 - 可开合窗扇"
		"- 橡木大窗 - 大型双开窗"
		"不同木材有不同颜色和纹理，"
		"适配各种建筑风格。"
	]
	quest.0000000004000002.quest_subtitle: "Macaw's Windows"
	quest.0000000004000002.title: "Oak Windows"
	quest.0000000004000003.quest_desc: [
		"尝试不同木材风格的窗户！"
		"桦木和云杉是最常见的变体。"
		"不同木材适合不同建筑："
		"- 桦木 - 明亮现代风格"
		"- 云杉 - 经典温暖风格"
	]
	quest.0000000004000003.quest_subtitle: "Different 木头 Styles"
	quest.0000000004000003.title: "Window Variants"
	quest.0000000004000004.quest_desc: [
		"Macaw 的门模组提供多样化的门样式，"
		"远超原版的木门。"
		"主要样式："
		"- 现代门 - 简洁线条"
		"- 谷仓门 - 乡村风格"
		"- 经典门 - 传统设计"
		"- 玻璃门 - 通透设计"
	]
	quest.0000000004000004.quest_subtitle: "Macaw's Doors"
	quest.0000000004000004.title: "Elegant Doors"
	quest.0000000004000005.quest_desc: [
		"Macaw 的栅栏模组提供精致的边界设计，"
		"远超原版栅栏。"
		"栅栏样式："
		"- 尖桩栅栏 - 经典美式风格"
		"- 树篱 - 自然绿植"
		"- 牧场栅栏 - 牧场风格"
		"混搭不同材质创造独特边界！"
	]
	quest.0000000004000005.quest_subtitle: "Macaw's Fences"
	quest.0000000004000005.title: "Fences and Hedges"
	quest.0000000004000006.quest_desc: [
		"Macaw 的家具模组提供完整的家具套装，"
		"涵盖客厅、厨房、书房和卧室。"
		"基础家具套装："
		"- 椅子 + 书桌 - 书房套装"
		"- 橱柜 + 柜台 - 厨房套装"
		"- 书架 - 书房装饰"
		"- 衣柜 - 卧室必备"
	]
	quest.0000000004000006.quest_subtitle: "Macaw's Furniture"
	quest.0000000004000006.title: "Interior Furniture"
	quest.0000000004000007.quest_desc: [
		"继续扩展你的家具收藏！"
		"- 茶几 - 客厅中心"
		"- 抽屉柜 - 卧室收纳"
		"- 双抽屉柜 - 厨房升级"
	]
	quest.0000000004000007.quest_subtitle: "更多 Furniture"
	quest.0000000004000007.title: "Tables and Cabinets"
	quest.0000000004000008.quest_desc: [
		"Macaw 的桥梁模组让你建造美丽的桥梁！"
		"桥梁类型："
		"- 木桥 - 简单实用"
		"- 绳桥 - 峡谷穿越"
		"- 廊桥 - 带屋顶步道"
		"- 石桥 - 坚固耐用"
	]
	quest.0000000004000008.quest_subtitle: "Macaw's Bridges"
	quest.0000000004000008.title: "Bridge Engineering"
	quest.0000000004000009.quest_desc: [
		"为窗户添加装饰细节！"
		"- 百叶窗板 - 可调节窗扇"
		"- 窗帘杆 - 搭配窗帘使用"
		"- 玻璃窗 - 增加自然采光"
	]
	quest.0000000004000009.quest_subtitle: "Shutters and Curtains"
	quest.0000000004000009.title: "Window Decor"
	quest.0000000004000010.quest_desc: [
		"尝试不同木材类型的家具。"
		"每种木材都有独特的纹理。"
		"制作桦木和云杉家具"
		"丰富你的建筑设计多样性。"
	]
	quest.0000000004000010.quest_subtitle: "Diverse Decoration"
	quest.0000000004000010.title: "Furniture Styles"
	quest.0000000004000011.quest_desc: [
		"打造完整的建筑组合，"
		"室内外装饰和谐统一。"
		"提交更多高级家具作为你"
		"设计能力的证明。"
	]
	quest.0000000004000011.quest_subtitle: "Outdoor Furniture"
	quest.0000000004000011.title: "Garden Decor"
	quest.0000000004000012.quest_desc: [
		"整合所有 Macaw 元素"
		"建造一个完整的建筑。"
		"提交核心建筑材料作为掌握证明："
		"窗户 + 门 + 家具 + 桥梁"
	]
	quest.0000000004000012.quest_subtitle: "Integrated 建造"
	quest.0000000004000012.title: "建造 Integration"
	quest.0000000004000013.quest_desc: [
		"恭喜！你已成为 Macaw 建造大师！"
		"你已经掌握："
		"- 多种窗户类型和百叶窗"
		"- 从现代到经典的门设计"
		"- 栅栏和树篱组合"
		"- 室内家具布置"
		"- 桥梁建造技术"
		"用这些技能创造"
		"属于你自己的独特建筑杰作！"
	]
	quest.0000000004000013.quest_subtitle: "章节 4 完成"
	quest.0000000004000013.title: "建造 Master Graduation"
	quest.0000000005000001.quest_desc: [
		"BYG（Oh The Biomes We've Gone）为 Minecraft 增添了超过 40 个新生物群系！"
		"从樱花林到荒芜恶地，热带雨林到冻土苔原"
		"每个生物群系都有独特的植物和建材资源"
		"准备好你的指南针，整装出发"
		"本章将带你穿越四大气候带"
		"温带、热带、寒带、魔法 — 22 种木材等你收集！"
	]
	quest.0000000005000001.quest_subtitle: "New Era 探索"
	quest.0000000005000001.title: "New Era 探索"
	quest.0000000005000002.quest_desc: [
		"BYG 新增了 22 种全新木材"
		"远超原版木材种类，提供无限的建造可能"
		"白杨木是 BYG 中最常见的木材"
		"具有优雅的金黄色调和细腻纹理"
		"非常适合古典风格建筑"
		"收集白杨原木并合成白杨木板"
		"作为你 BYG 木材之旅的第一步"
	]
	quest.0000000005000002.quest_subtitle: "BYG 木头 Guide"
	quest.0000000005000002.title: "BYG 木头 Guide"
	quest.0000000005000003.quest_desc: [
		"BYG 世界拥有种类繁多的植物"
		"每种植物都适应其原生生物群系"
		"芦荟 — 生长于干旱温暖生物群系"
		"紫菀花丛 — 温带草原的标志性花卉"
		"这些植物不仅美观，也是食材"
		"开启你的植物收集之旅！"
	]
	quest.0000000005000003.quest_subtitle: "BYG Flora Basics"
	quest.0000000005000003.title: "BYG Flora Basics"
	quest.0000000005000004.quest_desc: [
		"BYG 不仅扩展了生物群系，还带来了独特的食物系统"
		"使用生物群系植物制作美味佳肴"
		"芦荟汁 — 清爽的沙漠饮品"
		"蓝莓派 — 温带生物群系的甜蜜享受"
		"收集足够的食材，品尝 BYG 的独特风味"
		"美食是探索路上最好的慰藉"
	]
	quest.0000000005000004.quest_subtitle: "BYG Culinary 探索"
	quest.0000000005000004.title: "BYG Culinary 探索"
	quest.0000000005000005.quest_desc: [
		"BYG 生物群系中蕴藏着丰富的矿产宝藏"
		"稀有矿物和独特植物等待你的发现"
		"绿宝石 — 热带生物群系的珍贵矿物"
		"钻石 — 深藏于寒带生物群系之下"
		"奥丁球茎 — 来自魔法生物群系的魔法植物"
		"这三种资源分布在不同的气候带"
		"准备好你的镐子，深入地下！"
	]
	quest.0000000005000005.quest_subtitle: "BYG Mineral Treasures"
	quest.0000000005000005.title: "BYG Mineral Treasures"
	quest.0000000005000006.quest_desc: [
		"温带生物群系是 BYG 中最多姿多彩的区域"
		"分明的季风气候孕育了多样的木材和植物"
		"白杨林 — 金色树叶在微风中摇曳"
		"枫木林 — 如画的红色秋叶"
		"樱花林 — 粉色花瓣如雪般飘落"
		"收集白杨木作为温带之旅的开端"
		"温带还有更多木材等待发现"
	]
	quest.0000000005000006.quest_subtitle: "Temperate Biomes"
	quest.0000000005000006.title: "Temperate Biomes"
	quest.0000000005000007.quest_desc: [
		"白杨木是 BYG 中最具代表性的木材"
		"金色木纹，温润如玉"
		"大量储备白杨原木和白杨木板作为建造储备"
		"并收集白杨树苗进行人工造林"
		"白杨木板是北欧风格建筑的理想材料"
		"搭配深色木材营造惊艳的对比效果"
		"满满一箱白杨木 — 你做到了吗？"
	]
	quest.0000000005000007.quest_subtitle: "Aspen Depth"
	quest.0000000005000007.title: "Aspen Depth"
	quest.0000000005000008.quest_desc: [
		"枫木是温带生物群系的标志性木材"
		"红棕色木材，带有独特的暖色调"
		"秋天的枫木林最为壮观"
		"整片森林染成火红色"
		"收集枫木原木和枫木树苗"
		"在你的基地周围种植一片枫树林"
		"感受四季变换的自然之美"
	]
	quest.0000000005000008.quest_subtitle: "Maple Collection"
	quest.0000000005000008.title: "Maple Collection"
	quest.0000000005000009.quest_desc: [
		"樱花木是 BYG 中最浪漫的木材"
		"淡粉色木材，如盛开的樱花"
		"樱花生物群系中飘落粉色花瓣粒子"
		"是 BYG 世界中最美丽的生物群系之一"
		"收集樱花原木和南洋杉树苗"
		"南洋杉是一种古老的针叶树种"
		"与樱花共生，营造独特的景观"
	]
	quest.0000000005000009.quest_subtitle: "Sakura Collection"
	quest.0000000005000009.title: "Sakura Collection"
	quest.0000000005000010.quest_desc: [
		"松木生长在温带与寒带的交界处"
		"深绿色针叶和粗壮树干极具特色"
		"松木是小屋和度假村的绝佳材料"
		"深色纹理带来稳重和自然感"
		"收集松木原木和松木树苗"
		"为温带建材库增添新品种"
