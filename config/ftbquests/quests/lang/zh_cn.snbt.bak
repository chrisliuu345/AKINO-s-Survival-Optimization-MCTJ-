	quest.0000000009000051.title: "Necronomicon"
	quest.0000000009000052.quest_desc: [
		"Collect the three rare school affinity rings"
		"to fully experience all known magical schools"
		"• Ender Affinity Ring — Space  Teleportation"
		"• Evoker Affinity Ring — Summons  Commands"
		"• Cultist Ring — Forbidden  Curses"
		"These rare rings expand"
		"the magical domains beyond the six primary schools"
	]
	quest.0000000009000052.quest_subtitle: "Three Arcane Affinity Rings"
	quest.0000000009000052.title: "Rare Rings"
	quest.0000000009000053.quest_desc: [
		"Cinderous Soul Runes are special soul-based runes"
		"containing soul energy tempered by flames"
		"These runes are used to inscribe"
		"the most forbidden and powerful spells"
		"Souls are the ultimate fuel for magic"
		"at the cost of souls, gain supreme power!"
	]
	quest.0000000009000053.quest_subtitle: "Cinderous Soul Power"
	quest.0000000009000053.title: "Soul Runes"
	quest.0000000009000054.quest_desc: [
		"The Auto-loading 弩 is a special ranged weapon in ISB"
		"cleverly combining magic and machinery"
		"功能:"
		"• Auto-loading — no manual cocking needed"
		"• Can fire magical arrows"
		"• Compatible with various enchantment enhancements"
		"A perfect fusion of technology and magic"
		"silently harvesting enemies from afar!"
	]
	quest.0000000009000054.quest_subtitle: "Auto-loading 弩"
	quest.0000000009000054.title: "弩 Mage"
	quest.0000000009000055.quest_desc: [
		"Ender Runes and Evocation Runes are advanced school runes"
		"representing the magical powers of space and summoning"
		"Ender Rune — Spatial teleportation and blink spells"
		"Evocation Rune — Summoning and command spells"
		"Master these high-tier runes"
		"and the boundaries of space, time, and life will blur for you!"
	]
	quest.0000000009000055.quest_subtitle: "Space  Evocation Inscription"
	quest.0000000009000055.title: "Ender Runes"
	quest.0000000009000056.quest_desc: [
		"A true mage is not merely one who casts spells"
		"but one who deeply understands magical materials"
		"Collect large quantities of basic magical materials:"
		"• Arcane Ingots x64 — Foundation of magical metal"
		"• Arcane Runes x64 — 法术 book core"
		"• Arcane Essence x64 — Source of magical energy"
		"With ample magical material reserves"
		"你可以 freely forge and experiment with magic"
	]
	quest.0000000009000056.quest_subtitle: "Magic Material Master"
	quest.0000000009000056.title: "法术 Mastery"
	quest.0000000009000057.quest_desc: [
		"Collect and mass-produce affinity rings"
		"to become a true accessory expert"
		"需要 submissions:"
		"• Basic Affinity Rings x8"
		"• Six school affinity rings x2 each"
		"Rings are a mages most important accessories"
		"Mix different rings for magical enhancement combos!"
	]
	quest.0000000009000057.quest_subtitle: "Full Affinity Ring Collection"
	quest.0000000009000057.title: "Accessory Expert"
	quest.0000000009000058.quest_desc: [
		"Proof of pushing your magical path to its peak"
		"Showcase your most precious magical collection"
		"Collection requirements:"
		"• Necronomicon — Proof of Legend"
		"• 下界合金 法术 书 — Proof of Peak"
		"• Legendary Ink x4 — Ultimate inscription ink"
		"• Arcane Ingots x64 — Proof of boundless resources"
		"All of this gathered in one place"
		"你是 a true legendary collector!"
	]
	quest.0000000009000058.quest_subtitle: "Ultimate Magic Collector"
	quest.0000000009000058.title: "Legendary Collection"
	quest.0000000009000059.quest_desc: [
		"Runes are the bridge connecting school powers to spell books"
		"Collect large quantities of all six school runes"
		"Submit 32 of each school rune:"
		"• Fire Runes — Power of Flame"
		"• Ice Runes — Power of Frost"
		"• Lightning Runes — Power of Lightning"
		"• Holy Runes — Power of the Divine"
		"• Blood Runes — Power of Life"
		"• Nature Runes — Power of the Earth"
		"With runes in hand, all magic is yours to command!"
	]
	quest.0000000009000059.quest_subtitle: "Six Schools Rune Mastery"
	quest.0000000009000059.title: "Rune Master"
	quest.0000000009000060.quest_desc: [
		"恭喜! You have become a Magic Conqueror!"
		"You have mastered:"
		"• Arcane Basics — From debris to Arcane Ingots"
		"• Arcane 铁砧  Alchemist 炼药锅 — Magical Workshop"
		"• Six Schools — Fire/Ice/Lightning/Holy/Blood/Nature"
		"• School Books — All six school spell books"
		"• 法术 书 Upgrades — 金 > 钻石 > 下界合金"
		"• Necronomicon — Legendary forbidden spell tome"
		"• Full 护甲 Sets — Six school exclusive battle armor"
		"• Full Ring Collection — Magical accessory master"
		"• Full Rune Mastery — All six school runes"
		"• Material Master — Vast magical resource reserves"
		"From Arcane Apprentice to Magic Conqueror"
		"You are AKINOs most powerful Magic Conqueror!"
	]
	quest.0000000009000060.quest_subtitle: "ISB 章节 Final Completion"
	quest.0000000009000060.title: "Graduation: Magic Conqueror"
	quest.0000000010000001.quest_desc: [
		"Gather glowstone in the dark depths of the Nether"
		"Build a portal to the 天境 using glowstone"
		"Within the radiance, the world above the clouds awaits you"
		"步骤 through this gate and begin your 天境 journey"
	]
	quest.0000000010000001.quest_subtitle: "Sky Gate"
	quest.0000000010000001.title: "Sky Gate"
	quest.0000000010000002.quest_desc: [
		"Cross the glowstone portal to enter the 天境"
		"Collect 天境 Grass as your foothold"
		"Observe the unique terrain and creatures around you"
		"Above the sky, anything is possible"
	]
	quest.0000000010000002.quest_subtitle: "Enter the 天境"
	quest.0000000010000002.title: "Enter the 天境"
	quest.0000000010000003.quest_desc: [
		"The 天境 has different survival rules than the overworld"
		"Collect 天境 Dirt and 天境 Grass as basics"
		"Learn the 天境's unique fall mechanics"
		"Stand firm on your feet to travel further"
	]
	quest.0000000010000003.quest_subtitle: "天境 生存"
	quest.0000000010000003.title: "天境 生存"
	quest.0000000010000004.quest_desc: [
		"The 天境's most basic wood — Skyroot"
		"Chop Skyroot Logs and collect saplings"
		"Skyroot wood is the starting point of 天境 survival"
		"All construction begins with this log"
	]
	quest.0000000010000004.quest_subtitle: "Skyroot Logs"
	quest.0000000010000004.title: "Skyroot Logs"
	quest.0000000010000005.quest_desc: [
		"Craft basic tools using Skyroot wood"
		"Your most reliable companion in the early 天境"
		"镐, axe, shovel, sword — a complete set"
		"Well-equipped, ready to travel in all directions"
	]
	quest.0000000010000005.quest_subtitle: "Skyroot 工具"
	quest.0000000010000005.title: "Skyroot 工具"
	quest.0000000010000006.quest_desc: [
		"Process Skyroot logs into building materials"
		"木板, stairs, slabs — all available"
		"Build your first base in the 天境"
		"Skyroot builds are beautiful and practical"
	]
	quest.0000000010000006.quest_subtitle: "Skyroot 建造"
	quest.0000000010000006.title: "Skyroot 建造"
	quest.0000000010000007.quest_desc: [
		"Add doors and fences to your 天境 home"
		"Doors for protection, fences for Moa ranching"
		"The complete Skyroot home series"
		"Safety first — build your 天境 cottage"
	]
	quest.0000000010000007.quest_subtitle: "Skyroot Doors"
	quest.0000000010000007.title: "Skyroot Doors"
	quest.0000000010000008.quest_desc: [
		"Sail across 天境 lakes and cloud tops"
		"Skyroot Boat and 箱子 Boat"
		"Light and durable, essential for floating island exploration"
		"Ride the wind and waves across 天境 waters"
	]
	quest.0000000010000008.title: "Skyroot Boat"
	quest.0000000010000009.quest_desc: [
		"Skyroot 桶, the 天境's unique container"
		"Used to carry water and transport aquatic creatures"
		"Can also collect the 天境's unique poison"
		"A small bucket with great utility"
	]
	quest.0000000010000009.title: "Skyroot 桶"
	quest.0000000010000010.quest_desc: [
		"Settling in the 天境? Of course 你需要 a bed"
		"Skyroot Bed and Bookshelf accompany your nights"
		"Setting a spawn point in the 天境 is crucial"
		"Rest well and prepare for greater challenges"
	]
	quest.0000000010000010.title: "Skyroot Bed"
	quest.0000000010000011.quest_desc: [
		"The 天境's unique aercloud blocks"
		"Cold aerclouds slow you down, golden aerclouds speed you up"
		"Blue aerclouds let you bounce — each with its own use"
		"Collect all three aerclouds and master 天境 mobility"
	]
	quest.0000000010000011.quest_subtitle: "Aerclouds"
	quest.0000000010000011.title: "Aerclouds"
	quest.0000000010000012.quest_desc: [
		"The 天境's most abundant stone — Holystone"
		"Ancient stones scattered across 天境 island massifs"
		"A more durable material than Skyroot"
		"Holystone — opens the second phase of the 天境"
	]
	quest.0000000010000012.quest_subtitle: "Holystone Era"
	quest.0000000010000012.title: "Holystone Era"
	quest.0000000010000013.quest_desc: [
		"Process Holystone into refined building blocks"
		"Holystone Bricks, Holystone Brick Stairs, and Slabs"
		"The perfect material for second-phase 天境 building"
		"Construct a Holystone castle atop the clouds"
	]
	quest.0000000010000013.quest_subtitle: "Holystone 建造"
	quest.0000000010000013.title: "Holystone 建造"
	quest.0000000010000014.quest_desc: [
		"Collect more Holystone building blocks"
		"Holystone Stairs, Slabs, and Walls"
		"Perfect your 天境 architectural style"
		"每个 brick and tile carries Holystone's elegance"
	]
	quest.0000000010000014.quest_subtitle: "Holystone Set"
	quest.0000000010000014.title: "Holystone Set"
	quest.0000000010000015.quest_desc: [
		"Mossy Holystone weathered by ages"
		"Mossy Holystone and Mossy Holystone Stairs — ancient and natural"
		"Find them in the ancient 天境 ruins"
		"每个 mossy stone tells a story of the distant past"
	]
	quest.0000000010000015.quest_subtitle: "Mossy Holystone"
	quest.0000000010000015.title: "Mossy Holystone"
	quest.0000000010000016.quest_desc: [
		"The 天境's unique magical ore — Ambrosium"
		"Mine the ore to obtain Ambrosium Shards"
		"Use shards 合成 Ambrosium Torches"
		"The 天境's most basic energy source"
	]
	quest.0000000010000016.title: "Ambrosium Ore"
	quest.0000000010000017.quest_desc: [
		"最 important mid-game mineral — Zanite"
		"Zanite ore spreads throughout the 天境 underground"
		"Zanite gets stronger the more you use it — a unique trait"
		"The hallmark of advancing to the mid-tier 天境"
	]
	quest.0000000010000017.quest_subtitle: "Zanite Era"
	quest.0000000010000017.title: "Zanite Era"
	quest.0000000010000018.quest_desc: [
		"Forge powerful tools with Zanite"
		"Zanite tools get faster as durability decreases"
		"Unique trait makes combat and gathering more exciting"
		"Zanite in hand, the world is yours"
	]
	quest.0000000010000018.quest_subtitle: "Zanite 工具"
	quest.0000000010000018.title: "Zanite 工具"
	quest.0000000010000019.quest_desc: [
		"Craft Zanite Blocks from Zanite gemstones"
		"Store your Zanite wealth"
		"Zanite Blocks can be used for decoration or beacon bases"
		"Stack them high to display your power"
	]
	quest.0000000010000019.title: "Zanite Block"
	quest.0000000010000020.quest_desc: [
		"Craft exquisite accessories with Zanite"
		"Zanite Ring and Pendant provide unique buffs"
		"The accessory system is a unique 天境 feature"
		"Wear them and feel the power of Zanite"
	]
	quest.0000000010000020.quest_subtitle: "Zanite Accessories"
	quest.0000000010000020.title: "Zanite Accessories"
	quest.0000000010000021.quest_desc: [
		"The 天境's unique delicious food"
		"Blue Berries restore stamina, Enchanted Berries provide special effects"
		"White Apples are the 天境's most precious fruit"
		"Food accompanies the journey, energy replenished"
	]
	quest.0000000010000021.quest_subtitle: "天境 Food"
	quest.0000000010000021.title: "天境 Food"
	quest.0000000010000022.quest_desc: [
		"Special sweets obtained from the 天境"
		"Candy Canes and Gingerbread Men — cute and delicious"
		"Special holiday-themed treats"
		"Sweet in the mouth, warm in the heart"
	]
	quest.0000000010000022.quest_subtitle: "天境 Sweets"
	quest.0000000010000022.title: "天境 Sweets"
	quest.0000000010000023.quest_desc: [
		"击败 the 天境's unique Swet slimes"
		"Collect Swet Balls and Gummy Swets"
		"Blue Gummy and Golden Gummy — each with their own use"
		"Soft and sticky, but very useful"
	]
	quest.0000000010000023.quest_subtitle: "Swet  Gummy"
	quest.0000000010000023.title: "Swet  Gummy"
	quest.0000000010000024.quest_desc: [
		"The 天境's most precious ore — Gravitite"
		"Gravitite ore hides deep within the 天境 underground"
		"A Zanite pickaxe is required to mine it"
		"The power of levitation, beyond ordinary physics"
	]
	quest.0000000010000024.title: "Gravitite Ore"
	quest.0000000010000025.quest_desc: [
		"Forge top-tier tools with Gravitite"
		"Gravitite tools can make blocks float in the air"
		"右键点击 to levitate blocks in mid-air"
		"Master gravity, reshape the 天境"
	]
	quest.0000000010000025.quest_subtitle: "Gravitite 工具"
	quest.0000000010000025.title: "Gravitite 工具"
	quest.0000000010000026.quest_desc: [
		"Infuse Gravitite with stronger magical energy"
		"Enchanted Gravitite is the 天境's ultimate material"
		"Used 合成 various ultimate equipment"
		"The perfect union of magic and gravity"
	]
	quest.0000000010000026.title: "Enchanted Gravitite"
	quest.0000000010000027.quest_desc: [
		"The 天境's three elemental weapons"
		"Flaming 剑 burns all, Holy 剑 banishes evil"
		"Lightning 剑 strikes enemies to summon lightning"
		"Elemental power gathered at blade's edge"
	]
	quest.0000000010000027.quest_subtitle: "Special 武器"
	quest.0000000010000027.title: "Special 武器"
	quest.0000000010000028.quest_desc: [
		"A collection of the 天境's rare weapons"
		"Vampire Blade drains life to restore health"
		"Pig Slayer — wield against the denizens of the Nether"
		"每个 weapon has its own legendary tale"
	]
	quest.0000000010000028.quest_subtitle: "Advanced 武器"
	quest.0000000010000028.title: "Advanced 武器"
	quest.0000000010000029.quest_desc: [
		"The essence of 天境 ranged weapons"
		"Cloud Staff summons cloud blocks to walk on"
		"Nature Staff heals oneself"
		"Phoenix Bow shoots unquenchable arrows"
	]
	quest.0000000010000029.quest_subtitle: "Staves  Bow"
	quest.0000000010000029.title: "Staves  Bow"
	quest.0000000010000030.quest_desc: [
		"The 天境's most legendary divine weapons"
		"Hammer of Jeb — crushes enemies with the power of Notch"
		"Valkyrie Lance — the signature weapon of the Valkyrie Queen"
		"Obtain them and write your own legend"
	]
	quest.0000000010000030.quest_subtitle: "Legendary 武器"
	quest.0000000010000030.title: "Legendary 武器"
	quest.0000000010000031.quest_desc: [
		"The great gates of 天境 dungeons open before you"
		"Collect the Bronze, Silver, and 金 keys"
		"每个 key corresponds to a different dungeon challenge"
		"Three dungeons, three bosses, awaiting your challenge"
	]
	quest.0000000010000031.quest_subtitle: "Dungeon Entrance"
	quest.0000000010000031.title: "Dungeon Entrance"
	quest.0000000010000032.quest_desc: [
		"挑战 the Slider Boss of the Bronze Dungeon"
		"A giant sliding automaton guards the treasure"
		"Collect the Bronze Key and open the treasure chest"
		"The first test of wisdom and courage"
	]
	quest.0000000010000032.quest_subtitle: "Bronze Dungeon"
	quest.0000000010000032.title: "Bronze Dungeon"
	quest.0000000010000033.quest_desc: [
		"挑战 the Valkyrie Queen of the Silver Dungeon"
		"The valiant Valkyries guard the sacred temple"
		"击败 her to obtain the Valkyrie Lance"
		"The ultimate test of combat skill"
	]
	quest.0000000010000033.quest_subtitle: "Silver Dungeon"
	quest.0000000010000033.title: "Silver Dungeon"
	quest.0000000010000034.quest_desc: [
		"挑战 the Sun God of the 金 Dungeon"
		"The blazing spirit guards the golden temple"
		"Find the Sun Altar and face the fury of the sun"
		"The hardest fight among the three bosses"
	]
	quest.0000000010000034.quest_subtitle: "金 Dungeon"
	quest.0000000010000034.title: "金 Dungeon"
	quest.0000000010000035.quest_desc: [
		"Collect the precious loot from all three dungeon bosses"
		"Victory Medals witness your triumph"
		"Presents and Enchanted Gravitite carried home in triumph"
		"All three bosses have bowed to your might"
	]
	quest.0000000010000035.title: "Boss Loot"
	quest.0000000010000036.quest_desc: [
		"The 天境's unique flying mount — Moa"
		"Collect Blue, White, and Black Moa Eggs"
		"每个 Moa color has different abilities"
		"Tame a Moa and soar through 天境 skies"
	]
	quest.0000000010000036.quest_subtitle: "Moa Hatching"
	quest.0000000010000036.title: "Moa Hatching"
	quest.0000000010000037.quest_desc: [
		"Craft an Incubator to hatch Moa eggs"
		"Golden Amber is the fuel for the Incubator"
		"Wait patiently, new life is about to be born"
		"Baby Moa, the 天境's most loyal companion"
	]
	quest.0000000010000037.title: "Incubator"
	quest.0000000010000038.quest_desc: [
		"Free-falling in the 天境 requires a parachute"
		"Golden Parachute and Cold Parachute"
		"Pair with Golden Feathers for slow falling"
		"Land safely, fearless of the heights"
	]
	quest.0000000010000038.quest_subtitle: "Parachute 装备"
	quest.0000000010000038.title: "Parachute 装备"
	quest.0000000010000039.quest_desc: [
		"The 天境's traditional ranged weapon — Darts"
		"Golden Darts, Poison Darts, Enchanted Darts"
		"Three dart shooters, each with their own strengths"
		"每个 shot hits home, piercing from a hundred paces"
	]
	quest.0000000010000039.quest_subtitle: "Dart Set"
	quest.0000000010000039.title: "Dart Set"
	quest.0000000010000040.quest_desc: [
		"The 天境's accessory system is rich and varied"
		"Golden Ring, 铁 Ring, Ice Ring"
		"Pendants also come in 铁 and Ice varieties"
		"完成 accessories — like a tiger with wings"
	]
	quest.0000000010000040.quest_subtitle: "Accessory Collection"
	quest.0000000010000040.title: "Accessory Collection"
	quest.0000000010000041.quest_desc: [
		"天境 capes are both cosmetic and functional"
		"Agility Cape boosts movement speed"
		"Swet Cape and Valkyrie Cape each have their own traits"
		"Capes flowing — the 天境 is yours to soar"
	]
	quest.0000000010000041.quest_subtitle: "Cape Collection"
	quest.0000000010000041.title: "Cape Collection"
	quest.0000000010000042.quest_desc: [
		"The 天境's unique special defensive equipment"
		"盾牌 of Repulsion repels all who dare attack"
		"Invisibility Cloak lets you move unseen in darkness"
		"Regeneration 石头 and Healing 石头 keep you completely safe"
	]
	quest.0000000010000042.quest_subtitle: "Special 装备"
	quest.0000000010000042.title: "Special 装备"
	quest.0000000010000043.quest_desc: [
		"Collect Life Shards to increase your maximum health"
		"铁 Bubble provides underwater breathing"
		"Search the depths of the 天境 for these rare items"
		"Life force is the foundation of 天境 exploration"
	]
	quest.0000000010000043.quest_subtitle: "Life Shard"
	quest.0000000010000043.title: "Life Shard"
	quest.0000000010000044.quest_desc: [
		"Collect all the 天境 music discs"
		"Six discs recording the tales of the 天境"
		"From 天境 Tune to Slider's Wrath"
		"Music is the chanting of the 天境's soul"
	]
	quest.0000000010000044.quest_subtitle: "Music Discs"
	quest.0000000010000044.title: "Music Discs"
	quest.0000000010000045.quest_desc: [
		"The 天境's rarest tree — Golden Oak"
		"Collect Golden Oak Logs and saplings"
		"Golden Oaks only grow on special 天境 floating islands"
		"Golden leaves shimmering with radiance"
	]
	quest.0000000010000045.title: "Golden Oak"
	quest.0000000010000046.quest_desc: [
		"The 天境's beautiful crystal leaves"
		"Crystal Leaves and Crystal Fruit Leaves"
		"They grow in the mystical corners of the 天境"
		"Crystal clear, breathtakingly beautiful"
	]
	quest.0000000010000046.title: "Crystal Leaves"
	quest.0000000010000047.quest_desc: [
		"The 天境's unique quicksoil and glass"
		"Quicksoil makes those walking on it slide faster"
		"Quicksoil Glass is a transparent speed floor"
		"速度 and passion — race freely through the 天境"
	]
	quest.0000000010000047.quest_subtitle: "Quicksoil Glass"
	quest.0000000010000047.title: "Quicksoil Glass"
	quest.0000000010000048.quest_desc: [
		"The ultimate proof of an 天境 Master"
		"Gather massive quantities of rare 天境 resources"
		"Gravitite Ore, Zanite, 天境 Grass, Presents"
		"You are now truly an 天境 Master-grade figure"
	]
	quest.0000000010000048.quest_subtitle: "天境 Master"
	quest.0000000010000048.title: "天境 Master"
	quest.0000000010000049.quest_desc: [
		"The ultimate goal of an 天境 Collector"
		"Collect massive quantities of 天境 delicacies and goods"
		"Blue Berries, Candy Canes, Gingerbread Men, Aechor Petals"
		"每个 collected item is a precious memory of the 天境"
	]
	quest.0000000010000049.title: "天境 Collector"
	quest.0000000010000050.quest_desc: [
		"The final graduation mission of the 天境 journey"
		"From the Sky Gate to the three dungeons"
		"You have conquered the entire world above the clouds"
		"天境 Overlord — the title speaks for itself"
		"Thank you for your perseverance and courage"
	]
	quest.0000000010000050.title: "天境 Conqueror"
	quest.0000000011000001.quest_desc: [
		"欢迎来到 the Ultimate Boss Hunting chapter!"
		"This chapter challenges the strongest bosses in this modpack."
		"ISB Magic Bosses:"
		"- Tyros - The Flame Demon King"
		"- Dead King - Lord of the Undead"
		"Boss工厂 (BFB):"
		"- Sandworm - Desert Behemoth"
		"- Yeti - Tundra Predator"
		"- Great Dragon - Sky Overlord"
		"- Knight - Castle Guardian"
		"- Kraken - Deep Sea Terror"
		"All quests require submitting boss drop trophies as proof."
		"No cheating - only victory earns the spoils!"
		"Prepare 32 Arcane Ingots and embark on your hunt!"
	]
	quest.0000000011000001.quest_subtitle: "ISB Magic Boss Hunt"
	quest.0000000011000001.title: "Magic Hunt"
	quest.0000000011000002.quest_desc: [
		"Tyros - The Flame Demon King"
		"Demon lord who commands hellfire."
		"Boss traits:"
		"- Immune to fire and lava damage"
		"- Launches fireball barrages"
		"- Summons Blaze minions to assist"
		"- Extremely high HP; full enchanted gear recommended"
		"Battle preparations:"
		"- Fire 抗性 potion (ESSENTIAL!)"
		"- Ranged weapons for aerial combat"
		"- Fully enchanted 下界合金 gear"
		"Trophy proof: 烈焰棒 x32 + 岩浆膏 x8"
		"Prove 你已经 defeated the Flame Demon King!"
	]
	quest.0000000011000002.quest_subtitle: "Tyros the Flame Demon"
	quest.0000000011000002.title: "Tyros Battle"
	quest.0000000011000003.quest_desc: [
		"Dead King - Lord of the Undead"
		"The terrifying monarch who rules the realm of the dead."
		"Boss traits:"
		"- Summons undead legions to assist"
		"- Wither aura continuously corrodes life"
		"- Wither Skeleton royal guard protection"
		"- Shadow magic area attacks"
		"Battle preparations:"
		"- Smite-enchanted weapons"
		"- Plenty of milk to clear wither effects"
		"- Golden apples for health regeneration"
		"Trophy proof: Wither Skeleton Skull x3 + 骨头 Block x8"
		"Prove 你已经 defeated the Lord of the Undead!"
	]
	quest.0000000011000003.quest_subtitle: "Dead King, Lord of Undead"
	quest.0000000011000003.title: "Dead King Battle"
	quest.0000000011000004.quest_desc: [
		"After defeating Tyros and the Dead King,"
		"你已经 earned the right to wield high-level magic."
		"The Necronomicon is the most powerful shadow spellbook,"
		"containing the ultimate power of the undead realm."
		"只有 a mage who has conquered both flame and undeath"
		"is worthy of mastering this tome."
		"Submit the Necronomicon as proof of the dual-king conquest!"
	]
	quest.0000000011000004.quest_subtitle: "击败 both Kings for the Necronomicon"
	quest.0000000011000004.title: "Necronomicon"
	quest.0000000011000005.quest_desc: [
		"You have defeated all ISB Magic bosses!"
		"Achievement summary:"
		"- Tyros - Flame Demon King (done)"
		"- Dead King - Lord of the Undead (done)"
		"- Necronomicon - Ultimate 法术 (done)"
		"Now submit the final trophies"
		"to prove 你已经 conquered the ISB Magic chapter!"
		"需要: Nether Star x2 + Arcane Ingot x64"
	]
	quest.0000000011000005.quest_subtitle: "ISB Boss 完成 Hunt"
	quest.0000000011000005.title: "Magic Boss Hunter"
	quest.0000000011000006.quest_desc: [
		"Boss工厂 (BFB)"
		"are the second boss challenge group in this pack."
		"Five bosses are scattered across the world:"
		"- Sandworm - Deep in the desert"
		"- Yeti - Snow-covered tundra"
		"- Great Dragon - Towering mountain peaks"
		"- Knight - Ancient castle ruins"
		"- Kraken - Deep ocean caves"
		"每个 boss has unique trophies."
		"击败 them all to complete the ultimate conquest!"
		"Ready your strongest gear!"
		"Submit: 下界合金 剑 x1 + 不死图腾 x1"
	]
	quest.0000000011000006.quest_subtitle: "Boss工厂"
	quest.0000000011000006.title: "Ultimate 挑战"
	quest.0000000011000007.quest_desc: [
		"Sandworm - A giant worm lurking beneath the desert."
		"Boss traits:"
		"- Lurks in sand, ambushes unexpectedly"
		"- Burrows underground, hard to lock onto"
		"- Swallows players for massive damage"
		"- Summons zombies to assist"
		"Combat tips:"
		"- Fight on solid blocks (harder for the worm to burrow)"
		"- Suppress with ranged bow attacks"
		"- Watch for ground vibration warnings"
		"Trophy proof: Sand x64 + Sandstone x64 + Rotten Flesh x32"
	]
	quest.0000000011000007.quest_subtitle: "Desert Behemoth"
	quest.0000000011000007.title: "Sandworm"
	quest.0000000011000008.quest_desc: [
		"Yeti - The apex predator of the frozen tundra."
		"Boss traits:"
		"- Ice breath freezes players"
		"- Frigid aura continuously slows"
		"- Bite attacks deal piercing damage"
		"- Summons ice shard area attacks"
		"Battle preparations:"
		"- 皮革 armor for cold protection"
		"- 抗性 potions"
		"- Keep moving to dodge ice shards"
		"Trophy proof: Snow Block x32 + Packed Ice x32 + 骨头 x32"
	]
	quest.0000000011000008.quest_subtitle: "Tundra Predator"
	quest.0000000011000008.title: "Yeti"
	quest.0000000011000009.quest_desc: [
		"Great Dragon - Sky overlord atop towering peaks."
		"Boss traits:"
		"- Agile and flexible flight patterns"
		"- Dragon breath covers large areas"
		"- Dive-bomb strikes are instantly lethal"
		"- Dragon roar knocks back players"
		"Battle preparations:"
		"- 鞘翅 + Fireworks for aerial pursuit"
		"- Powerful bow for ranged damage"
		"- Dragon''s Breath potions as counters"
		"- Burst melee when grounded"
		"Trophy proof: Dragon''s Breath x8 + 龙头 x1 + 黑曜石 x64"
	]
	quest.0000000011000009.quest_subtitle: "Sky Overlord"
	quest.0000000011000009.title: "Great Dragon"
	quest.0000000011000010.quest_desc: [
		"Knight - The immortal guardian of ancient castles."
		"Boss traits:"
		"- Heavy armor with extreme damage reduction"
		"- 盾牌 blocks frontal attacks"
		"- Charging impacts deal massive damage"
		"- Summons 铁 Golem legions"
		"Combat tips:"
		"- Flank attack (knight''s shield makes front invulnerable)"
		"- Axe to break shield (armor-piercing effect)"
		"- Prioritize clearing 铁 Golem minions"
		"Trophy proof: 下界合金 Ingot x4 + 盾牌 x4 + 铁 Block x16"
	]
	quest.0000000011000010.quest_subtitle: "Castle Guardian"
	quest.0000000011000010.title: "Knight"
	quest.0000000011000011.quest_desc: [
		"Kraken - The terrifying leviathan of the deep ocean caves."
		"Boss traits:"
		"- Moves extremely fast underwater, relentless pursuit"
		"- Tentacle attacks deal area damage"
		"- Ink clouds blind players"
		"- Whirlpool vortex drags players into the depths"
		"Battle preparations:"
		"- Depth Strider III enchanted boots"
		"- Water Breathing + Night Vision potions"
		"- 三叉戟 (Impaling V) for ranged advantage"
		"- Turtle Shell helmet for extended underwater time"
		"Trophy proof: Heart of the Sea x2 + Prismarine Shard x64 + Nautilus Shell x4"
	]
	quest.0000000011000011.quest_subtitle: "Deep Sea Terror"
	quest.0000000011000011.title: "Kraken"
	quest.0000000011000012.quest_desc: [
		"You have defeated all 5 BFB bosses!"
		"Hunt checklist:"
		"- Sandworm - Desert Behemoth (done)"
		"- Yeti - Tundra Predator (done)"
		"- Great Dragon - Sky Overlord (done)"
		"- Knight - Castle Guardian (done)"
		"- Kraken - Deep Sea Terror (done)"
		"All five bosses conquered!"
		"Submit combined trophies as proof of victory."
		"需要: Nether Star x5 + Dragon''s Breath x16 + Sand x64 + Snow Block x64 + Heart of the Sea x4"
	]
	quest.0000000011000012.quest_subtitle: "BFB 完成 Hunt"
	quest.0000000011000012.title: "BFB Hunter"
	quest.0000000011000013.quest_desc: [
		"You have conquered all bosses in this modpack!"
		"ISB Magic Boss record:"
		"- Tyros - Flame Demon King (done)"
		"- Dead King - Lord of the Undead (done)"
		"- Necronomicon - Ultimate 法术 (done)"
		"BFB Boss record:"
		"- Sandworm + Yeti + Dragon + Knight + Kraken (done)"
		"You are a true Boss Hunter!"
		"Submit final proof:"
		"Nether Star x8 + 龙头 x1 + 下界合金 Block x1"
	]
	quest.0000000011000013.quest_subtitle: "ISB + BFB 完成 Conquest"
	quest.0000000011000013.title: "Boss Conqueror"
	quest.0000000011000014.quest_desc: [
		"恭喜! Boss Hunter Graduation!"
		"You have defeated all ultimate bosses in this modpack."
		"From the Flame Demon King''s inferno to the deep sea leviathan''s abyss,"
		"from the desert worm''s sandstorms to the sky dragon''s firmament."
		"You are fearless and unstoppable!"
		"Your name shall be etched in the server''s history."
		"You are a true Boss Hunter without equal!"
		"Submit the final graduation proof:"
		"Nether Star x10 + 信标 x1 + 龙头 x1"
	]
	quest.0000000011000014.quest_subtitle: "Ultimate Hunt 完成"
	quest.0000000011000014.title: "Boss Hunter Graduation"
	quest.0000000012000001.quest_desc: [
		"欢迎来到 the RPG Progression and Maid System!"
		"The 东方小女仆 mod adds"
		"adorable maid companions to your adventure."
		"Use cake to tame or summon maids."
		"They will accompany you exploring the world, fighting enemies,"
		"and can even manage farms and items for you."
		"Prepare a cake and begin"
		"your maid companion journey!"
	]
	quest.0000000012000001.quest_subtitle: "Maid Companion System"
	quest.0000000012000001.title: "冒险 Companion"
	quest.0000000012000002.quest_desc: [
		"Maids are your most loyal adventure companions."
		"How to obtain a maid:"
		"- 右键点击 a maid with cake to tame her"
		"- Tamed maids will follow you"
		"- 右键点击 打开 the maid GUI for management"
		"Maids spawn naturally in the world."
		"Explore different biomes 找到"
		"your perfect maid companion!"
		"Submit 4 cakes as taming proof."
	]
	quest.0000000012000002.quest_subtitle: "Taming Your Maid"
	quest.0000000012000002.title: "Maid Contract"
	quest.0000000012000003.quest_desc: [
		"Your maid can equip weapons and armor!"
		"Open the maid GUI and place in equipment slots:"
		"- 钻石 剑: 提升 maid''s melee attack power"
		"- 钻石 胸甲: Enhances maid''s defense"
		"- Bow: 授予 maid ranged attack capability"
		"A well-equipped maid is your"
		"reliable assistant in battle, especially against tough enemies."
		"Prepare all three equipment items"
		"to outfit your maid with a full combat set!"
	]
	quest.0000000012000003.quest_subtitle: "Maid 装备"
	quest.0000000012000003.title: "Maid 装备"
	quest.0000000012000004.quest_desc: [
		"技能树 provides"
		"a powerful skill tree system!"
		"按下 K 打开 the skill tree interface."
		"等级 up to earn skill points,"
		"and invest points in the skill tree for passive bonuses:"
		"- Combat Skills: Increase attack damage and speed"
		"- 挖掘 Skills: Increase mining speed and fortune"
		"- 生存 Skills: Increase health and armor"
		"- Agility Skills: Increase movement speed and dodge"
		"Bottles o'' 附魔 and enchanted books symbolize"
		"your initial investment in the skill system."
	]
	quest.0000000012000004.quest_subtitle: "技能树 Introduction"
	quest.0000000012000004.title: "技能 Tree"
	quest.0000000012000005.quest_desc: [
		"技能属性 and Curios"
		"provide an equipment attribute bonus system for your character."
		"Curio slots:"
		"- Ring slot: Wear rings for attribute bonuses"
		"- Necklace slot: Wear necklaces for special effects"
		"- Belt slot: Wear belts for enhanced defense"
		"- 也: bracelets, charms, and many more slots"
		"Golden apples symbolize attribute enhancement."
		"金 nuggets symbolize Curio accessories."
		"Get ready to explore the world of attribute gear!"
	]
	quest.0000000012000005.quest_subtitle: "技能属性  Curios"
	quest.0000000012000005.title: "属性 装备"
	quest.0000000012000006.quest_desc: [
		"It''s time to hone your combat skills!"
		"Through the skill tree''s combat branch,"
		"your character''s strength is improving."
		"Now test your training in real combat!"
		"击杀 targets:"
		"- Skeletons x20: Practice ranged defense"
		"- Zombies x20: Practice melee blocking"
		"- Spiders x10: Practice agile positioning"
		"Bring your maid to fight alongside you."
		"Accumulate real combat experience and march toward combat mastery!"
	]
	quest.0000000012000006.quest_subtitle: "Combat Training"
	quest.0000000012000006.title: "Combat Training"
	quest.0000000012000007.quest_desc: [
		"Maids are your most loyal combat partners."
		"With a well-equipped maid by your side,"
		"sweep through the nightly monster hordes together!"
		"Collect these trophies as combat proof:"
		"- Rotten Flesh x64: Proof of the zombie army"
		"- Bones x64: Proof of the skeleton archers"
		"- 线 x32: Proof of the spider nests"
		"Fight alongside your maid, amass troves of loot,"
		"and prove your unbeatable combat synergy!"
	]
	quest.0000000012000007.quest_subtitle: "Maid Combat"
	quest.0000000012000007.title: "Maid Combat"
	quest.0000000012000008.quest_desc: [
		"You have completed skill training and combat testing."
		"Now it''s time to prove your full RPG mastery!"
		"Submit these items as master-level proof:"
		"- 附魔金苹果: Ultimate combat recovery"
		"- 不死图腾: Last resort for desperate survival"
		"- 下界合金 Ingot x4: Symbol of top-tier equipment"
		"这是 the milestone node for the first half of this chapter."
		"Completing this quest proves 你已经 mastered RPG core gameplay."
		"Continue downward to explore shrine and fairy secrets!"
	]
	quest.0000000012000008.quest_subtitle: "RPG 完成 Mastery"
	quest.0000000012000008.title: "Full Power"
	quest.0000000012000009.quest_desc: [
		"In the 东方小女仆 mod,"
		"shrines are important structures that provide P-Points (spirit power)."
		"Use lanterns and glowstone to illuminate the shrine."
		"The shrine''s gohei will provide you and your maid"
		"with P-Point balance for special abilities."
		"Collect these shrine lighting materials:"
		"- 荧石 x32: Main shrine light source"
		"- Lanterns x16: Decorative shrine lamps"
		"- Amethyst Shards x16: Spirit power medium"
		"Light up the shrine and unlock the spirit power system!"
	]
	quest.0000000012000009.quest_subtitle: "Shrine P-Power"
	quest.0000000012000009.title: "Shrine Power"
	quest.0000000012000010.quest_desc: [
		"Wild fairy maids are scattered throughout the world."
		"They are a special variant type of maid."
		"Fairy maids have unique appearances and abilities."
		"Use cake to tame them and expand your maid squad!"
		"Taming supplies needed:"
		"- Emeralds x16: Fairy maid trading currency"
		"- Cakes x8: For taming multiple fairy maids"
		"- Golden Carrots x16: Fairy maids'' favorite food"
		"Explore different biomes"
		"to discover and tame rare fairy maids!"
	]
	quest.0000000012000010.quest_subtitle: "Fairy Maids"
	quest.0000000012000010.title: "Fairy Maids"
	quest.0000000012000011.quest_desc: [
		"这是 the ultimate test of the RPG progression system!"
		"You have completed:"
		"[+] 技能 tree training and combat practice"
		"[+] 属性 gear and Curio accessories"
		"[+] Maid taming, equipping, and combat synergy"
		"[+] Shrine spirit power and fairy maid exploration"
		"Now submit the final proof:"
		"- Cakes x16: Logistics for your maid legion"
		"- Enchanted Golden Apples x4: Ultimate combat reserves"
		"- Nether Stars x4: Symbol of master-level power"
		"恭喜! You are an AKINO RPG Master!"
		"Next, welcome the final graduation ceremony!"
	]
	quest.0000000012000011.quest_subtitle: "Maid  RPG Grandmaster"
	quest.0000000012000011.title: "Master of Companions"
	quest.0000000012000012.quest_desc: [
		"恭喜! You have reached the final graduation ceremony!"
		"Review your AKINO adventure journey:"
		"- 原版生存基础 - Starting MC life from scratch"
		"- Cooking and Cuisine - Enjoy the fruits of harvest"
		"- Storage Management - Build your item kingdom"
		"- Macaw''s 建造 - Craft your dream home"
		"- BYG Rich World - Explore 40+ biome wonders"
		"- YUNG Dungeons - Conquer new structure challenges"
		"- Dimension Travel - Nether, End, 天境, 深暗之域"
		"- 机械动力 - Steampunk automation"
		"- 铁''s Spells - Master the six schools of magic"
		"- Boss Hunting - 击败 all legendary foes"
		"- RPG Progression - Skills, Attributes, Maid Mastery"
		"Submit the final graduation offerings:"
		"- Nether Star x8 - Witness to complete power"
		"- 龙头 - Ultimate conquest of the 末影龙"
		"- 信标 - Light at the top of the world"
		"- 蛋糕 - A memento returning to where it all began"
		"You are a true AKINO Master!"
	]
	quest.0000000012000012.quest_subtitle: "AKINO Graduation Ceremony"
	quest.0000000012000012.title: "AKINO Graduation"
	quest.00FA24BFFBD39B2D.quest_desc: [
		"击败 Shulkers in End Cities to"
		"collect shulker shells. Two shells"
		"craft a shulker box which stores"
		"items even when broken. Portable"
		"storage for your adventures."
	]
	quest.00FA24BFFBD39B2D.title: "Shulker Shell"
	quest.03CFC47D75623D5C.quest_desc: [
		"Craft a brewing stand with a blaze"
		"rod and cobblestone. 酿造 stands"
		"create potions using water bottles"
		"nether wart and various ingredients."
	]
	quest.03CFC47D75623D5C.title: "酿造台"
	quest.056088BF4F56866E.quest_desc: [
		"Mine redstone ore deep underground"
		"using an iron pickaxe or better."
		"红石 is the core component for"
		"contraptions automation and circuits."
	]
	quest.056088BF4F56866E.title: "红石 Dust"
	quest.06BBD2FAF873BD70.quest_desc: [
		"Craft the mighty diamond pickaxe using"
		"diamonds and sticks. 钻石 tools have"
		"the highest durability and can mine"
		"obsidian for accessing the Nether."
	]
	quest.06BBD2FAF873BD70.title: "钻石 镐"
	quest.0909F835E2FB137A.quest_desc: [
		"Collect diamonds from deep underground."
		"Two diamonds plus obsidian and a book"
		"craft the enchanting table. Save some"
		"for tools armor and jukeboxes."
	]
	quest.0909F835E2FB137A.title: "钻石"
	quest.0AA29F4ECB8E4C91.quest_desc: [
		"Begin your 原版生存 journey."
		"Master tools farming redstone enchanting"
		"brewing and exploration. Five branches"
		"await your progress through Minecraft."
	]
	quest.0AA29F4ECB8E4C91.title: "Vanilla Journey"
	quest.0C3851E13BD87FE7.quest_desc: [
		"Craft a furnace with 8 cobblestone."
		"Furnaces smelt ores into ingots and"
		"cook raw food. Use coal charcoal or"
		"wood as fuel to power your furnace."
	]
	quest.0C3851E13BD87FE7.title: "熔炉"
	quest.0E7C0A6ADC9B45F3.quest_desc: [
		"Find melon and pumpkin seeds in"
		"dungeons mineshafts or villages."
		"Melons restore hunger while pumpkins"
		"can be carved or used 制作 golems."
	]
	quest.0E7C0A6ADC9B45F3.title: "Melon  Pumpkin"
	quest.108F8962EE32DC2E.quest_desc: [
		"JEI (仅仅 足够 物品) shows all recipes."
		"按下 R on an item 查看 its recipe or"
		"U 查看 what it can be used for."
		"Search items on the right side of your inventory."
	]
	quest.108F8962EE32DC2E.title: "JEI配方查询"
	quest.1655335413FB1714.quest_desc: [
		"Biomes We've Gone adds over 80 new biomes"
		"with unique trees plants and terrain."
		"Explore diverse landscapes from lush"
		"tropics to frozen wastelands."
	]
	quest.1655335413FB1714.title: "Biomes  建造"
	quest.180492980DB17A32.quest_desc: [
		"The FTB 任务 书 is your guide through"
		"the modpack. Open it with the hotkey or"
		"the book icon in your inventory."
		"Quests help you learn mods step by step."
	]
	quest.180492980DB17A32.title: "任务书指南"
	quest.1A3F5B8C6AED8BA1.quest_desc: [
		"Upgrade a dropper with a bow 合成"
		"a dispenser. Dispensers can shoot"
		"arrows place water or lava and use"
		"other items with special behaviors."
	]
	quest.1A3F5B8C6AED8BA1.title: "Dispenser"
	quest.1B13FE0613AB1936.quest_desc: [
		"Enter the Nether and defeat Blazes"
		"in Nether Fortresses. Blaze rods are"
		"essential for brewing stands and for"
		"crafting Eyes of Ender."
	]
	quest.1B13FE0613AB1936.title: "烈焰棒"
	quest.1D6B52B45262B3E6.quest_desc: [
		"Craft your first pickaxe using planks"
		"and sticks. Wooden tools are the"
		"foundation of all tool progression."
		"Use it to mine stone and upgrade."
	]
	quest.1D6B52B45262B3E6.title: "Wooden 镐"
	quest.1DC504A8DD3E340D.quest_desc: [
		"Craft bookshelves with books and wood"
		"planks. Place 15 bookshelves around"
		"your enchanting table 解锁 level"
		"30 enchantments for maximum power."
	]
	quest.1DC504A8DD3E340D.title: "Bookshelf"
	quest.20CCEC345A7C854B.quest_desc: [
		"Upgrade to a blast furnace using iron"
		"ingots a furnace and smooth stone."
		"Blast furnaces smelt ores twice as"
		"fast as a regular furnace."
	]
	quest.20CCEC345A7C854B.title: "高炉"
	quest.2160D71A7E80C5FA.quest_desc: [
		"Craft an observer with cobblestone"
		"redstone dust and nether quartz."
		"Observers detect block updates and"
		"emit a redstone pulse in response."
	]
	quest.2160D71A7E80C5FA.title: "Observer"
	quest.227795C4B58DD1A0.quest_desc: [
		"Breed chickens with seeds for eggs"
		"and meat. Shear or breed sheep with"
		"wheat for wool. Wool is essential"
		"for beds and decorative blocks."
	]
	quest.227795C4B58DD1A0.title: "Chicken  Sheep Farm"
	quest.2379CC05C6EA7358.quest_desc: [
		"完成 this quest 解锁 all content"
		"chapters. 每个 chapter focuses on a"
		"specific aspect of the modpack."
		"祝你好运 on your adventure!"
	]
	quest.2379CC05C6EA7358.title: "解锁全部章节"
	quest.2757288AA4ACA157.quest_desc: [
		"Face powerful bosses and enhance your"
		"combat abilities. 铁魔法 adds"
		"boss fights while improved combat mechanics"
		"make battles more engaging and rewarding."
	]
	quest.2757288AA4ACA157.title: "Combat  Bosses"
	quest.2871A402DDA75DFE.quest_desc: [
		"Craft a hopper with iron ingots and"
		"a chest. Hoppers move items between"
		"containers and can collect dropped"
		"items on the ground automatically."
	]
	quest.2871A402DDA75DFE.title: "Hopper"
	quest.290B326B898FDFC2.quest_desc: [
		"Find beetroot seeds in villages or"
		"dungeon chests. Beetroots can be"
		"crafted into beetroot soup for a"
		"hearty meal restoring 6 hunger."
	]
	quest.290B326B898FDFC2.title: "甜菜根"
	quest.2A77A8B819B0A58D.quest_desc: [
		"传送石碑 let you teleport between locations."
		"Find them in villages or craft your own."
		"右键点击 a Waystone to activate it then"
		"warp between any activated 传送石碑."
	]
	quest.2A77A8B819B0A58D.title: "传送石碑"
	quest.2C67A0D81F3382F5.quest_desc: [
		"Craft a dropper with cobblestone and"
		"redstone dust. Droppers eject items"
		"from their inventory when powered."
		"Essential for item transport systems."
	]
	quest.2C67A0D81F3382F5.title: "Dropper"
	quest.2F2BCA80BADED045.quest_desc: [
		"Mine gold ore found deep underground"
		"or in badlands biomes. 金 ingots are"
		"used for powered rails golden apples"
		"and bartering with Piglins."
	]
	quest.2F2BCA80BADED045.title: "金 挖掘"
	quest.3053761AB671D65F.quest_desc: [
		"Brew a potion by placing water bottles"
		"in a brewing stand adding nether wart"
		"and then a secondary ingredient like"
		"sugar blaze powder or golden carrots."
	]
	quest.3053761AB671D65F.title: "水瓶 Potion"
	quest.3693B876119DEE82.quest_desc: [
		"Craft Eyes of Ender with ender pearls"
		"and blaze powder. Throw them to locate"
		"the Stronghold. Fill the End Portal"
		"frame with 12 Eyes of Ender."
	]
	quest.3693B876119DEE82.title: "Eye of Ender"
	quest.3B692852CBD08203.quest_desc: [
		"Craft bread from 3 wheat in a row."
		"面包 is an excellent early-game food"
		"restoring 5 hunger points. Ideal for"
		"long mining trips and exploration."
	]
	quest.3B692852CBD08203.title: "面包"
	quest.3D947BE2838F0FFD.quest_desc: [
		"Combine a piston with a slimeball"
		"dropped by slimes. Sticky pistons"
		"can both push and pull blocks"
		"enabling advanced contraptions."
	]
	quest.3D947BE2838F0FFD.title: "Sticky Piston"
	quest.4084C0C650D6D286.quest_desc: [
		"机械动力 is a mechanical engineering mod."
		"Build contraptions with gears belts and"
		"shafts. Automate resource processing"
		"with mechanical power instead of redstone."
	]
	quest.4084C0C650D6D286.title: "机械动力"
	quest.45CB29779F19E294.quest_desc: [
		"欢迎来到 AKINO's 生存 Optimization!"
		"This modpack combines over 200 mods"
		"for an enhanced Minecraft experience."
		"完成 this tutorial 解锁 all chapters."
	]
	quest.45CB29779F19E294.title: "欢迎来到 AKINO"
	quest.477E5422BB62324B.quest_desc: [
		"Craft an enchanting table with obsidian"
		"diamonds and a book. 附魔 adds"
		"powerful abilities to your tools and"
		"armor. Surround with bookshelves for"
		"higher-level enchantments."
	]
	quest.477E5422BB62324B.title: "附魔台"
	quest.487D033753B53CA8.quest_desc: [
		"Mine coal ore found in stone layers."
		"煤炭 is the most common fuel source"
		"used in furnaces for smelting ores"
		"and cooking your first food."
	]
	quest.487D033753B53CA8.title: "煤炭 挖掘"
	quest.48EB23F3A8E0E619.quest_desc: [
		"Summon and defeat the Wither to obtain"
		"a Nether Star for a beacon. Craft a"
		"conduit with nautilus shells and a"
		"heart of the sea. These end-game blocks"
		"grant powerful area buffs."
	]
	quest.48EB23F3A8E0E619.title: "信标  Conduit"
	quest.4A13EF2048CCBC9D.quest_desc: [
		"The 天境 is a heavenly dimension in the"
		"sky. Build a 荧石 Portal with water"
		"to enter this paradise dimension filled"
		"with flying islands and unique mobs."
	]
	quest.4A13EF2048CCBC9D.title: "天境"
	quest.4A8AA81E4CC7E6FB.quest_desc: [
		"铁魔法 adds a complete magic system."
		"Craft spell books find scrolls and learn"
		"powerful spells. Use mana to cast healing"
		"damage and utility spells in combat."
	]
	quest.4A8AA81E4CC7E6FB.title: "铁魔法"
	quest.4C6497DFF66336B6.quest_desc: [
		"Craft detector rails with iron ingots"
		"stone pressure plates and redstone."
		"Detector rails emit a redstone signal"
		"when a minecart passes over them."
	]
	quest.4C6497DFF66336B6.title: "Detector Rail"
	quest.4D8D44EF7B17B929.quest_desc: [
		"Xaero小地图 and World Map help you"
		"navigate the world. Set waypoints see"
		"terrain around you and never get lost"
		"on your adventures."
	]
	quest.4D8D44EF7B17B929.title: "Xaero's Maps"
	quest.4E63603D557A8E50.quest_desc: [
		"Jade shows information about the block or"
		"entity 你是 looking at. See block names"
		"mod sources and more at the top of your"
		"screen without opening any interface."
	]
	quest.4E63603D557A8E50.title: "Jade HUD"
	quest.51124642104D6F70.quest_desc: [
		"Collect Dragon's Breath using a glass"
		"bottle during the 末影龙 fight."
		"Dragon's Breath is used to brew"
		"lingering potions."
	]
	quest.51124642104D6F70.title: "Dragon's Breath"
	quest.5144ECF156FE8973.quest_desc: [
		"恭喜! You have mastered"
		"every branch of 原版生存."
		"You have conquered tools farming"
		"redstone enchanting and exploration."
		"Your name echoes across the server!"
	]
	quest.5144ECF156FE8973.title: "Vanilla Grandmaster"
	quest.5683D9B30B01B931.quest_desc: [
		"高级背包 add portable storage."
		"Craft a backpack and upgrade it with various"
		"tiers and modules like crafting tables"
		"smelting and magnet upgrades. 按下 B 打开."
	]
	quest.5683D9B30B01B931.title: "高级背包"
	quest.57253D0D9A020F39.quest_desc: [
		"Craft a boat with wood planks. Boats"
		"let you travel across oceans and rivers"
		"quickly. They can carry two passengers"
		"and are immune to fall damage."
	]
	quest.57253D0D9A020F39.title: "Boat"
	quest.577D321D24D51E1C.quest_desc: [
		"Craft a compass with iron ingots and"
		"redstone dust. The compass always"
		"points to your world spawn point."
		"Essential for navigation."
	]
	quest.577D321D24D51E1C.title: "指南针"
	quest.585719C49104B22A.quest_desc: [
		"Forge an iron pickaxe with iron ingots"
		"and sticks. 铁 tools mine faster and"
		"can harvest diamond ore and gold ore."
		"A major step in your progression."
	]
	quest.585719C49104B22A.title: "铁 镐"
	quest.5A29E29D84EC1BB2.quest_desc: [
		"Breed cows with wheat and pigs with"
		"carrots. Cows provide beef and leather"
		"while pigs give porkchops. A steady"
		"food supply is vital for survival."
	]
	quest.5A29E29D84EC1BB2.title: "Cow  Pig Farm"
	quest.5AFF77883C0E8075.quest_desc: [
		"Find carrots in village farms or as"
		"a rare zombie drop. Carrots are easy"
		"to farm and restore 3 hunger points."
		"也 used to breed pigs and rabbits."
	]
	quest.5AFF77883C0E8075.title: "胡萝卜"
	quest.5DDDD609E80C8E62.quest_desc: [
		"击败 Endermen in the Overworld or"
		"the Nether to collect ender pearls."
		"Throw an ender pearl to teleport to"
		"where it lands at the cost of health."
	]
	quest.5DDDD609E80C8E62.title: "Ender Pearl"
	quest.5F0F0C58411C27DF.quest_desc: [
		"Craft rails with iron ingots and a"
		"stick. Rails guide minecarts along"
		"a path. Combine with powered rails"
		"to build full railway systems."
	]
	quest.5F0F0C58411C27DF.title: "Rails"
	quest.5F69490589CD056D.quest_desc: [
		"Upgrade to a stone pickaxe using"
		"cobblestone and sticks. 石头 tools"
		"mine faster and can harvest iron ore"
		"which wooden tools cannot."
	]
	quest.5F69490589CD056D.title: "石头 镐"
	quest.6082FF105C97DFC7.quest_desc: [
		"Mine iron ore found underground."
		"Smelt raw iron in a furnace 获取"
		"iron ingots. 铁 is essential for"
		"tools armor and mechanical crafting."
	]
	quest.6082FF105C97DFC7.title: "铁 挖掘"
	quest.6659973960B4E6B2.quest_desc: [
		"Craft a minecart with iron ingots."
		"Minecarts ride on rails for fast"
		"transportation. Add a chest furnace"
		"or hopper for specialized minecarts."
	]
	quest.6659973960B4E6B2.title: "Minecart"
	quest.6667B5A27F9DE92E.quest_desc: [
		"欢迎来到 AKINO 生存 Optimization modpack!"
		"功能:"
		"• 铁魔法 — 魔法六学派"
		"• 机械动力 — Steampunk Automation"
		"• BYG Oh The Biomes — 40+ Biomes to Explore"
		"• YUNG'sOverhauled Structures — New Dungeon 经验值"
		"• 天境 + 深暗之域 Depths"
		"• 东方小女仆 — Maid Companion Adventures"
		"This chapter is a tutorial overview. 完成 all quests 解锁 every chapter!"
	]
	quest.6667B5A27F9DE92E.quest_subtitle: "Modpack Overview"
	quest.6667B5A27F9DE92E.title: "欢迎来到 AKINO"
	quest.66972350E70080C5.quest_desc: [
		"Craft a repeater with redstone torches"
		"redstone dust and stone. Repeaters"
		"extend and delay redstone signals"
		"up to 4 ticks of delay."
	]
	quest.66972350E70080C5.title: "红石 Repeater"
	quest.6717E1912A4A900C.quest_desc: [
		"The 深暗之域 mod expands the Deep Dark"
		"dimension below the Ancient Cities."
		"Discover Sculk-infested caves and face"
		"the dangers lurking in the depths."
	]
	quest.6717E1912A4A900C.title: "深暗之域"
	quest.676273237277BC75.quest_desc: [
		"Craft a fishing rod with sticks and"
		"string from spiders. Fish in any body"
		"of water to catch raw fish which can"
		"be cooked for better hunger restoration."
	]
	quest.676273237277BC75.title: "钓鱼竿"
	quest.6797570FAA857C5F.quest_desc: [
		"Craft an anvil with iron blocks and"
		"iron ingots. Anvils combine enchanted"
		"items and repair tools. 经验值"
		"bottles can be found or traded."
	]
	quest.6797570FAA857C5F.title: "铁砧  Exp Bottle"
	quest.68C1B60CBC5F072F.quest_desc: [
		"Find elytra in End Ships floating"
		"near End Cities. 鞘翅 let you glide"
		"through the air. Boost with fireworks"
		"for powered flight across the world."
	]
	quest.68C1B60CBC5F072F.title: "鞘翅"
	quest.6CC5DE67AEB158EC.quest_desc: [
		"Mine diamond ore near bedrock levels."
		"Diamonds are the most valuable ore"
		"used for top-tier tools armor and"
		"an enchanting table."
	]
	quest.6CC5DE67AEB158EC.title: "钻石 挖掘"
	quest.71EDDB11F73F7C4C.quest_desc: [
		"Craft an empty map with paper and a"
		"compass. Maps record the terrain as"
		"you explore. Expand them with more"
		"paper at a cartography table."
	]
	quest.71EDDB11F73F7C4C.title: "地图"
	quest.74058C637502CD90.quest_desc: [
		"Craft a piston with wood planks"
		"cobblestone redstone dust and an"
		"iron ingot. Pistons push blocks"
		"when powered by redstone."
	]
	quest.74058C637502CD90.title: "Piston"
	quest.74B6BC1EA60CF143.quest_desc: [
		"恭喜! You have learned about"
		"the major mods in this modpack. You are"
		"now ready to dive deeper into each"
		"chapter and master every mod."
	]
	quest.74B6BC1EA60CF143.title: "教程完成"
	quest.74B9B00986CD9B18.quest_desc: [
		"Find potatoes in village farms or as"
		"a rare zombie drop. Potatoes can be"
		"cooked into baked potatoes for better"
		"hunger restoration."
	]
	quest.74B9B00986CD9B18.title: "土豆"
	quest.7646A4EF95218159.quest_desc: [
		"Collect wheat seeds by breaking tall"
		"grass. Plant seeds on farmland near"
		"water to grow wheat. 小麦 is the"
		"staple crop for bread and breeding."
	]
	quest.7646A4EF95218159.title: "小麦 种子"
	quest.77AAF938A932FE52.quest_desc: [
		"Craft a spyglass with copper ingots"
		"and an amethyst shard. Use it to zoom"
		"in and scout distant terrain or"
		"locate structures from afar."
	]
	quest.77AAF938A932FE52.title: "Spyglass"
	quest.7998017F967B10D9.quest_desc: [
		"Brew a lingering potion by adding"
		"Dragon's Breath to a splash potion."
		"Lingering potions create a cloud that"
		"applies effects to entities inside."
	]
	quest.7998017F967B10D9.title: "Lingering Potion"
	quest.79C171814B1BE5D1.quest_desc: [
		"Find nether wart growing in Nether"
		"Fortresses. Nether wart is the base"
		"ingredient for all potions. Farm it"
		"on soul sand for a steady supply."
	]
	quest.79C171814B1BE5D1.title: "下界疣"
	quest.7A895FDC11FD4B86.quest_desc: [
		"Craft powered rails with gold ingots"
		"redstone dust and sticks. Powered"
		"rails propel minecarts when given"
		"a redstone signal."
	]
	quest.7A895FDC11FD4B86.title: "Powered Rail"
	quest.7B364D96652201C0.quest_desc: [
		"Upgrade your diamond pickaxe with a"
		"netherite ingot at a smithing table."
		"下界合金 tools are lava-proof and"
		"have the highest stats in the game."
	]
	quest.7B364D96652201C0.title: "下界合金 镐"
	quest.7E36D8AFE64BAC31.quest_desc: [
		"Mine obsidian with a diamond pickaxe"
		"or find it where water meets lava."
		"黑曜石 is needed for Nether portals"
		"enchanting tables and ender chests."
	]
	quest.7E36D8AFE64BAC31.title: "黑曜石"
	quest.7FCE371458E53CDC.quest_desc: [
		"Cook raw cod or salmon in a furnace"
		"or smoker. Cooked fish is an excellent"
		"food source that restores 5 hunger"
		"points without needing farmland."
	]
	quest.7FCE371458E53CDC.title: "Cooked Fish"
