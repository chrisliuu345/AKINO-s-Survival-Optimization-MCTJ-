	quest.0000000005000011.quest_subtitle: "Temperate Flora"
	quest.0000000005000011.title: "Temperate Flora"
	quest.0000000005000012.quest_desc: [
		"温带植物不仅可以观赏"
		"还能制作成风味独特的料理"
		"芦荟汁 — 清凉爽口"
		"青苹果派 — 酸甜可口"
