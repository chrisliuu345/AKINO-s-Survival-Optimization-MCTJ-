	quest.0000000009000047.quest_subtitle: "Expand 法术 Capacity"
	quest.0000000009000047.title: "法术 栏位 Upgrade"
	quest.0000000009000048.quest_desc: [
		"The 钻石 法术 书 is the pinnacle of mid-tier spell books"
		"featuring 10 spell slots"
		"enabling simultaneous use of multiple school spells"
		"for cross-school combos"
		"Craft on the Arcane 铁砧"
		"requires Diamonds and a 金 法术 书 as the base"
		"10 slots truly make you"
		"a battlemage versed in many schools!"
	]
	quest.0000000009000048.quest_subtitle: "10 法术 栏位"
	quest.0000000009000048.title: "钻石 法术 书"
	quest.0000000009000049.quest_desc: [
		"The 下界合金 法术 书 is the apex of standard spell books"
		"featuring 12 spell slots"
		"Among non-legendary spell books"
		"it has the most slots and largest mana capacity"
		"Craft on the Arcane 铁砧"
		"requires 下界合金 Ingots and a 钻石 法术 书"
		"12 slots let you freely"
		"wield the full power of all six schools!"
	]
	quest.0000000009000049.quest_subtitle: "12 法术 栏位"
	quest.0000000009000049.title: "下界合金 法术 书"
	quest.0000000009000050.quest_desc: [
		"下界合金 Mage 护甲 is ISBs strongest magical armor set"
		"including 头盔, 胸甲, 护腿, and 靴子"
		"Full set bonuses:"
		"• Greatly increases all school spell damage"
