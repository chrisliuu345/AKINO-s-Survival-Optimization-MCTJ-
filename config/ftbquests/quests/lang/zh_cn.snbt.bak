	quest.0000000009000015.title: "Fire School"
	quest.0000000009000016.quest_desc: [
		"Fire Runes contain the energy of flames"
		"and are the core material for Fire School spell books"
		"On the Arcane 铁砧"
		"inscribe Blank Runes with fire-related materials"
		"to obtain Fire Runes"
		"A sufficient stockpile of Fire Runes"
