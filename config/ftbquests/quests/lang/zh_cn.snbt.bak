	quest.0000000009000013.title: "Legendary Ink"
	quest.0000000009000014.quest_desc: [
		"Protection Runes and Cooldown Runes are important auxiliary runes"
		"providing extra traits to magical equipment and spell books"
		"Protection Rune — Inscribed on armor"
		"grants magical damage reduction"
		"Cooldown Rune — Inscribed on spell books"
		"shortens spell cooldown times"
		"Balance offense and defense to stand undefeated!"
	]
	quest.0000000009000014.quest_subtitle: "Defensive Rune Inscription"
	quest.0000000009000014.title: "Protection Secrets"
	quest.0000000009000015.quest_desc: [
		"Fire School — The power of flames, explosions, and destruction"
		"The Blaze 法术 书 is the Fire Schools exclusive spell book"
		"focused on high fire damage output"
		"Fire school signature spells:"
		"• Fireball — Launches a burning fireball"
		"• Blaze Storm — Area persistent burning"
		"• Fire Wave — Fan-shaped flame blast"
		"Master the flames and incinerate all enemies!"
	]
