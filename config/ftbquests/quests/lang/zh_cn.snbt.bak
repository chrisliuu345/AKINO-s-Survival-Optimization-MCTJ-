	quest.0000000009000045.quest_desc: [
		"Collect all six school spell books"
		"proving 你已经 mastered all magical schools"
		"Submit the following six spell books:"
		"• Blaze 法术 书 — Fire School"
		"• Ice 法术 书 — Ice School"
		"• 铜 法术 书 — Lightning School"
		"• Evoker 法术 书 — Holy School"
		"• Dragonskin 法术 书 — Blood School"
