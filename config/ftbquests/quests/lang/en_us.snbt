	chapter.7F7CC502D3C7E320.title: "Building Arts"
	quest.0000000000000002.quest_desc: [
		"Press J to open the Quest Book (this screen)"
		""
		"Left side: Chapter list"
		"Right side: Quest tree for current chapter"
		""
		"Quest types:"
		"• Item Submission — Turn in required items"
		"• Kill Mob — Defeat specified monsters"
		"• Checkmark — Confirm you understand the feature"
		""
		"Complete quests to earn rewards (items, XP)"
		"Finish all quests for chapter graduation reward"
	]
	quest.0000000000000002.quest_subtitle: "How to Use Quests"
	quest.0000000000000002.title: "Quest Book Guide"
	quest.0000000000000003.quest_desc: [
		"JEI is one of the most essential tools in this pack"
		"Displayed on the right side of inventory/crafting interfaces"
		""
		"Hotkeys:"
		"• R — View item recipes"
		"• U — View item uses"
		"• A — Bookmark/unbookmark recipes"
		"• @modname — Search by mod"
		""
		"Type #tagname in the search box"
		"to view all items under that tag"
	]
	quest.0000000000000003.quest_subtitle: "Recipes  Uses"
	quest.0000000000000003.title: "JEI Recipes"
	quest.0000000000000004.quest_desc: [
		"Jade displays target info at the top of the screen"
		""
		"When looking at blocks:"
		"• Block name and source mod"
		"• Mining progress and required tool"
		"• Container item preview"
		"• Crop growth status"
		""
		"When looking at entities:"
		"• Mob name and health"
		"• Player name and armor value"
		""
		"Numpad 0 (Num0) toggles display on/off"
	]
	quest.0000000000000004.quest_subtitle: "Block  Entity Info"
	quest.0000000000000004.title: "Jade Info Panel"
	quest.0000000000000005.quest_desc: [
		"Xaero provides two map systems"
		""
		"Minimap (top-right corner):"
		"• Press Y to open minimap settings"
		"• Press B to create a waypoint"
		"• Shows nearby mobs and players"
		""
		"World Map:"
		"• Press M to open fullscreen world map"
		"• Explored areas are auto-mapped"
		"• Unified waypoint management"
		""
		"Use waypoints wisely during exploration"
		"Important locations are never lost!"
	]
	quest.0000000000000005.quest_subtitle: "Never Get Lost"
	quest.0000000000000005.title: "Xaero Maps"
	quest.0000000000000006.quest_desc: [
		"Sophisticated Inventory"
		"Adds smart sorting buttons to your backpacks and containers"
		""
		"Features:"
		"• One-click organize inventory/chests"
		"• Quick stack to nearby containers"
		"• Middle mouse button sorting"
		"• Customizable sorting rules"
		""
		"Open any container interface"
		"Look for sort buttons in the top-left/top-right corners"
		"Say goodbye to messy inventories!"
	]
	quest.0000000000000006.quest_subtitle: "Smart Inventory Management"
	quest.0000000000000006.title: "Inventory Sorting"
	quest.0000000000000007.quest_desc: [
		"Curios adds accessory slots to your character"
		"Press E to open inventory, then click the Curios icon"
		"(the small ring icon on the left)"
		""
		"Available slots:"
		"• Ring x2"
		"• Necklace x1"
		"• Belt x1"
		"• Bracelet x1"
		"• Other special slots"
		""
		"Iron's Spellbooksand"
		"Puffish Attributes gear"
		"all require Curios slots to equip"
	]
	quest.0000000000000007.quest_subtitle: "Rings  Necklaces"
	quest.0000000000000007.title: "Curios Accessories"
	quest.0000000000000008.quest_desc: [
		"Press K to open the skill tree panel"
		""
		"Earn skill points by gaining experience"
		"Spend skill points in the tree to:"
		"• Increase health/armor"
		"• Boost attack damage/movement speed"
		"• Unlock special abilities"
		""
		"Skill tree categories:"
		"• Combat — Damage  Defense"
		"• Gathering — Mining  Speed"
		"• Magic — Mana  Spell Enhancement"
	]
	quest.0000000000000008.quest_subtitle: "Character Progression"
	quest.0000000000000008.title: "Puffish Skills"
	quest.0000000000000009.quest_desc: [
		"Waystones provides a teleport waystone system"
		""
		"Naturally generated waystones can be found at:"
		"• Village centers"
		"• Wilderness roadsides"
		"• Near special structures"
		""
		"How to use:"
		"• Right-click a waystone to open teleport UI"
		"• Spend a small amount of XP to teleport"
		"• You can also craft Warp Stones for portable use"
		""
		"Once your teleport network is established"
		"long-distance travel becomes instant!"
	]
	quest.0000000000000009.quest_subtitle: "Fast Travel Network"
	quest.0000000000000009.title: "Waystones Travel"
	quest.0000000000000010.quest_desc: [
		"The FallingTree mod changes how you chop trees"
		""
		"Simply use an axe to break the bottom-most"
		"log block at the base of the tree"
		"and the entire tree comes tumbling down!"
		""
		"Supports trees from all mods"
		"(including BYG, Aether, etc.)"
		""
		"Note:"
		"• Requires an axe (bare hands will not work)"
		"• Sneaking (Shift) prevents chain chopping"
		"• Leaves will naturally drop saplings"
	]
	quest.0000000000000010.quest_subtitle: "One-Chop Tree Cutting"
	quest.0000000000000010.title: "FallingTree"
	quest.0000000000000011.quest_desc: [
		"Mouse Tweaks shortcuts:"
		"• Shift + Left-drag — Bulk transfer"
		"• Shift + Right-click — Quick move stacks"
		"• Scroll wheel — Place single items precisely"
		""
		"TrashSlot:"
		"• Bottom-right of inventory/container screen"
		"• Drag items in to delete them"
		"• Or use Ctrl+Shift+Click on items"
		"to quickly send them to the trash"
	]
	quest.0000000000000011.quest_subtitle: "Shortcuts  Trash Slot"
	quest.0000000000000011.title: "Mouse Tweaks  Trash"
	quest.0000000000000012.quest_desc: [
		"Trade Cycling lets you quickly refresh"
		"villager trades"
		""
		"In the villager trading GUI"
		"click the refresh button next to a trade"
		"Each refresh costs one emerald"
		""
		"No more repeatedly breaking and placing"
		"workstation blocks"
		"Find that enchanted book you need quickly!"
	]
	quest.0000000000000012.title: "Refresh Villager Trades"
	quest.0000000000000013.quest_desc: [
		"Press F7 to toggle the spawn overlay"
		""
		"Color meanings:"
		"• Yellow X — Safe at day, mobs spawn at night"
		"• Red X — Mobs can spawn at any time!"
		"• No mark — Bright enough, fully safe"
		""
		"Make sure your base area has no red X marks!"
		"Place torches to eliminate all red zones"
		""
		"One of the most practical tools in survival"
	]
	quest.0000000000000013.quest_subtitle: "Spawn Proofing"
	quest.0000000000000013.title: "Light Overlay (F7)"
	quest.0000000000000014.quest_desc: [
		"You're in Grave Danger mod"
		"Generates a grave upon death"
		""
		"Upon death:"
		"• All items are stored in the grave"
		"• The grave marks your death location"
		"• Right-click the grave to recover all items"
		""
		"No more fear of lava or the void!"
		"Your items are safely preserved"
		"but remember to retrieve them before gearing up"
	]
	quest.0000000000000014.quest_subtitle: "Safe Death Recovery"
	quest.0000000000000014.title: "Grave System"
	quest.0000000000000015.quest_desc: [
		"Congratulations on completing the tutorial!"
		""
		"You now understand:"
		"• FTB Quest Book and JEI recipe system"
		"• Jade and Xaero map info tools"
		"• Curios accessories and skill system"
		"• Waystones teleport network"
		"• FallingTree chopping and shortcuts"
		"• Trade cycling, F7 light overlay, grave protection"
		""
		"All 13 chapters are now unlocked!"
		"From vanilla survival to ultimate boss battles"
		"Start your adventure at your own pace!"
	]
	quest.0000000000000015.quest_subtitle: "Unlock All Chapters"
	quest.0000000000000015.title: "Tutorial Complete"
	quest.0000000000000016.quest_desc: [
		"Reset your Combat Arts and Survival Expert skill trees to zero."
		"All spent points will be refunded."
		"Your experience and levels are preserved."
		"Cost: 10 XP levels per use."
	]
	quest.0000000000000016.quest_subtitle: "Refund All Skill Points"
	quest.0000000000000016.title: "Skill Reset"
	quest.0000000001000001.quest_desc: [
		"Welcome to the world of blocks!"
		"First, you need to craft a Crafting Table."
		""
		"Use logs to craft planks,"
		"then use 4 planks to make a Crafting Table."
		"Right-click to place it, right-click to open the crafting grid."
		""
		"This is the starting point of all crafting!"
	]
	quest.0000000001000001.quest_subtitle: "First Steps"
	quest.0000000001000001.title: "First Steps"
	quest.0000000001000002.quest_desc: [
		"Find a tree,"
		"break the log blocks with your hand or a tool."
		""
		"Each oak tree provides 4-7 logs."
		"Logs craft into planks,"
		"the basic building material."
		""
		"Don't forget to plant saplings too!"
	]
	quest.0000000001000002.quest_subtitle: "Get Wood"
	quest.0000000001000002.title: "Gathering Wood"
	quest.0000000001000003.quest_desc: [
		"The first step into the Stone Age!"
		""
		"Mine stone to get cobblestone,"
		"craft a stone pickaxe, axe, and sword."
		"Stone pickaxe can mine iron ore,"
		"stone axe chops trees 3x faster than by hand,"
		"stone sword is a reliable early-game weapon."
		""
		"Use a wooden pickaxe to mine stone, then upgrade to stone tools!"
	]
	quest.0000000001000003.quest_subtitle: "Stone Age"
	quest.0000000001000003.title: "Stone Age"
	quest.0000000001000004.quest_desc: [
		"Darkness breeds monsters, torches bring safety!"
		""
		"Craft torches with coal/charcoal and sticks."
		"One coal makes 4 torches."
		"Torches are essential for cave exploration,"
		"and also prevent mob spawning."
		""
		"Make sure your home has adequate lighting!"
	]
	quest.0000000001000004.quest_subtitle: "Torchlight"
	quest.0000000001000004.title: "Torchlight"
	quest.0000000001000005.quest_desc: [
		"Craft a furnace with 8 cobblestone."
		""
		"Smelt logs in the furnace to make charcoal,"
		"charcoal burns 8x longer than raw logs!"
		""
		"Furnaces can smelt iron ore and cook food,"
		"one of the most important survival tools."
		""
		"Produce 16 charcoal to prepare for the future."
	]
	quest.0000000001000005.quest_subtitle: "Furnace Smelting"
	quest.0000000001000005.title: "Furnace Smelting"
	quest.0000000001000006.quest_desc: [
		"Long nights call for a warm bed."
		""
		"Craft a bed with 3 wool and 3 planks."
		"Kill sheep or use shears to get wool."
		""
		"Right-click a bed to set your spawn point,"
		"right-click at night to sleep and skip the night."
		""
		"Without a bed, the night is full of monsters..."
	]
	quest.0000000001000006.quest_subtitle: "Sweet Dreams"
	quest.0000000001000006.title: "Sweet Dreams"
	quest.0000000001000007.quest_desc: [
		"Inventory full? You need a storage system!"
		""
		"Craft a chest with 8 planks,"
		"a chest provides 27 storage slots."
		""
		"Barrels are a cheaper alternative,"
		"crafted with 6 planks and 2 wooden slabs."
		""
		"Organize your storage warehouse!"
	]
	quest.0000000001000007.quest_subtitle: "Storage Solutions"
	quest.0000000001000007.title: "Storage Solutions"
	quest.0000000001000008.quest_desc: [
		"Enter the Iron Age and boost your productivity!"
		""
		"Find iron ore below Y=56 underground,"
		"smelt iron ore into iron ingots in a furnace."
		""
		"Iron pickaxe can mine diamond, gold, and redstone,"
		"iron durability is over twice that of stone."
		""
		"Prioritize crafting an iron pickaxe!"
	]
	quest.0000000001000008.quest_subtitle: "Iron Age"
	quest.0000000001000008.title: "Iron Age"
	quest.0000000001000009.quest_desc: [
		"Plant seeds, harvest the future!"
		""
		"Craft a wooden hoe with 2 sticks and 2 planks."
		"Right-click grass with a hoe to till farmland,"
		""
		"Breaking grass has a chance to drop wheat seeds."
		"Farmland needs water nearby to stay hydrated,"
		""
		"One water block can hydrate a 9x9 area of farmland."
	]
	quest.0000000001000009.quest_subtitle: "Farming Basics"
	quest.0000000001000009.title: "Farming Basics"
	quest.0000000001000010.quest_desc: [
		"Golden waves of wheat sway in the breeze."
		""
		"Growing wheat requires patience,"
		"ripe wheat turns from green to golden."
		""
		"Harvest wheat to get more seeds,"
		"gradually expand your farmland."
		""
		"Use wheat to attract cows and sheep for breeding!"
	]
	quest.0000000001000010.quest_subtitle: "Golden Wheat"
	quest.0000000001000010.title: "Golden Wheat Field"
	quest.0000000001000011.quest_desc: [
		"Process wheat into delicious bread!"
		""
		"Craft 1 bread using 3 wheat at a crafting table."
		"Each bread restores 5 hunger points."
		""
		"Bread is the most stable mid-game food source,"
		"portable and doesn't take much inventory space."
		""
		"Build a wheat farm and never go hungry again!"
	]
	quest.0000000001000011.quest_subtitle: "The Baker"
	quest.0000000001000011.title: "The Baker"
	quest.0000000001000012.quest_desc: [
		"Build an animal farm,"
		"say goodbye to hunting!"
		""
		"Use wheat to attract cows and sheep,"
		"carrots to attract pigs,"
		"seeds to attract chickens."
		""
		"Feed two of the same animal to breed them,"
		"gain a stable source of meat and materials."
	]
	quest.0000000001000012.quest_subtitle: "Animal Husbandry"
	quest.0000000001000012.title: "Animal Husbandry"
	quest.0000000001000013.quest_desc: [
		"Nothing beats the smell of grilled meat!"
		""
		"Cooking raw meat in a furnace greatly boosts hunger restoration."
		"Cooked beef restores 8 hunger, the best food!"
		""
		"Cooked porkchop and cooked chicken are great too."
		"Build an automated grilling system,"
		""
		"Never go hungry again!"
	]
	quest.0000000001000013.quest_subtitle: "Grilled Feast"
	quest.0000000001000013.title: "Grilled Feast"
	quest.0000000001000014.quest_desc: [
		"Grab a fishing rod and enjoy some time at the river!"
		""
		"Craft a fishing rod with sticks and string,"
		"right-click water to cast the bobber."
		""
		"Wait for the bobber to dip then quickly reel in."
		"Fishing yields raw fish, treasure, even enchanted books!"
		""
		"Cod and salmon are a cat's favorite."
	]
	quest.0000000001000014.quest_subtitle: "Way of the Fisher"
	quest.0000000001000014.title: "Way of the Fisher"
	quest.0000000001000015.quest_desc: [
		"Find pumpkin and melon seeds in mineshafts or villages."
		""
		"Growing pumpkins and melons requires adjacent farmland,"
		"their stems grow fruit on adjacent blocks."
		""
		"Craft pumpkin pie with pumpkin, sugar, and egg,"
		"a quality food that restores 8 hunger!"
		""
		"32 melon slices to fill your backpack."
	]
	quest.0000000001000015.quest_subtitle: "Pumpkin  Melon"
	quest.0000000001000015.title: "Pumpkin  Melon"
	quest.0000000001000016.quest_desc: [
		"You are a true livestock expert!"
		""
		"Right-click a cow with an iron bucket to get milk,"
		"milk clears all potion effects."
		""
		"Collect 32 eggs for sustainable chicken hatching,"
		"16 leather can be used for books and equipment."
		""
		"Use eggs, sugar, and milk to craft a celebration cake!"
	]
	quest.0000000001000016.quest_subtitle: "Livestock Expert"
	quest.0000000001000016.title: "Livestock Expert"
	quest.0000000001000017.quest_desc: [
		"The best defense is raising your shield!"
		""
		"Craft a shield with 6 planks and 1 iron ingot."
		"Hold right-click to raise the shield and fully block attacks,"
		"including skeleton arrows and creeper explosions!"
		""
		"A shield is a must-have for exploring dangerous areas,"
		""
		"Don't face a group of skeleton archers bare-handed!"
	]
	quest.0000000001000017.quest_subtitle: "Shield Defense"
	quest.0000000001000017.title: "Shield Defense"
	quest.0000000001000018.quest_desc: [
		"Wear a full set of iron armor and protect yourself!"
		""
		"A full set requires 24 iron ingots."
		"Provides 15 armor points (max 20),"
		"significantly reducing damage taken."
		""
		"Prioritize crafting the chestplate for the most protection!"
		""
		"With iron armor, mining is no longer terrifying."
	]
	quest.0000000001000018.quest_subtitle: "Iron Armor Set"
	quest.0000000001000018.title: "Iron Armor Set"
	quest.0000000001000019.quest_desc: [
		"A good weapon is key to survival!"
		""
		"Stone sword deals 5 attack damage,"
		"1 more than wooden sword, 4 more than bare hands."
		""
		"Keep your weapon on you at all times,"
		"ready to counter zombies and skeletons at night."
		""
		"Even better when paired with a shield!"
	]
	quest.0000000001000019.quest_subtitle: "Stone Sword Upgrade"
	quest.0000000001000019.title: "Stone Sword Upgrade"
	quest.0000000001000020.quest_desc: [
		"Ranged combat is the safest way to fight!"
		""
		"Craft a bow with sticks and string."
		"Bows can be charged for more damage,"
		"a fully charged shot deals 9-10 damage."
		""
		"Prepare plenty of arrows (64+),"
		"defeat monsters and Endermen from a distance."
		""
		"Arrows can be enchanted with Infinity for unlimited use!"
	]
	quest.0000000001000020.quest_subtitle: "The Archer"
	quest.0000000001000020.title: "The Archer"
	quest.0000000001000021.quest_desc: [
		"Brave warrior, take up arms and hunt monsters!"
		""
		"Kill 15 zombies for rotten flesh and XP,"
		"kill 15 skeletons for bones and arrows,"
		"kill 8 spiders for string and spider eyes."
		""
		"These drops can be used for crafting and trading."
		"Bones tame wolves, string makes bows and fishing rods."
		""
		"Hunt monsters at night for best results!"
	]
	quest.0000000001000021.quest_subtitle: "Monster Hunter"
	quest.0000000001000021.title: "Monster Hunter"
	quest.0000000001000022.quest_desc: [
		"Ssssss-BOOM! Keep creepers away from your home!"
		""
		"Kill 8 creepers and collect 32 gunpowder."
		"Creepers explode after 3 seconds when close,"
		"use a bow for safer ranged attacks."
		""
		"Gunpowder is used to craft TNT and firework rockets."
		""
		"Beware! Creepers don't burn in daylight!"
	]
	quest.0000000001000022.quest_subtitle: "Creeper Bane"
	quest.0000000001000022.title: "Creeper Bane"
	quest.0000000001000023.quest_desc: [
		"The anvil is key to weapon and tool upgrades!"
		""
		"Requires 3 iron blocks and 4 iron ingots (31 total),"
		"anvils can rename items, repair tools,"
		"and combine enchanted books."
		""
		"Anvils gradually degrade with use,"
		"eventually becoming a damaged anvil."
		""
		"Invest XP at the anvil to improve your gear!"
	]
	quest.0000000001000023.quest_subtitle: "Anvil Smithing"
	quest.0000000001000023.title: "Anvil Smithing"
	quest.0000000001000024.quest_desc: [
		"Congratulations! You've entered the Diamond Age!"
		""
		"Find diamond ore near Y=-58,"
		"mine it with an iron pickaxe or better."
		""
		"Diamond pickaxe can mine obsidian,"
		"a requirement for entering the Nether."
		""
		"Diamond pickaxe has 1561 durability,"
		"6x that of an iron pickaxe!"
	]
	quest.0000000001000024.quest_subtitle: "Diamond Age"
	quest.0000000001000024.title: "Diamond Age"
	quest.0000000001000026.quest_desc: [
		"The Nether is a scorching and dangerous realm."
		""
		"Collect 32 netherrack as building and crafting material."
		"Glowstone dust is used for redstone lamps and arrow effects."
		""
		"Soul sand is needed to summon the Wither,"
		"and is the soil for growing nether wart."
		""
		"Watch out for lava and ghasts in the Nether!"
	]
	quest.0000000001000026.quest_subtitle: "Nether Exploration"
	quest.0000000001000026.title: "Nether Exploration"
	quest.0000000001000027.quest_desc: [
		"Find blaze spawners in Nether fortresses."
		""
		"Blazes charge up before shooting fireballs,"
		"dodge or block with a shield!"
		""
		"Kill 8 blazes for 8 blaze rods,"
		"blaze rods are essential for brewing and crafting ender eyes."
		""
		"Craft blaze powder for brewing fuel."
	]
	quest.0000000001000027.quest_subtitle: "Blaze Hunter"
	quest.0000000001000027.title: "Blaze Hunter"
	quest.0000000001000028.quest_desc: [
		"Hunt Wither Skeletons in Nether fortresses."
		""
		"Wither skeletons are 3 blocks tall, carry stone swords,"
		"and their attacks inflict the Wither effect."
		""
		"Kill 5 Wither Skeletons and get one skull."
		"Wither skeleton skulls have only a 2.5% drop rate,"
		"you may need to kill many!"
		""
		"Three skulls are needed to summon the Wither."
	]
	quest.0000000001000028.quest_subtitle: "Wither Skeleton"
	quest.0000000001000028.title: "Wither Skeleton"
	quest.0000000001000029.quest_desc: [
		"Piglins love gold!"
		""
		"Drop gold ingots near piglins,"
		"they will pick them up and throw back items in exchange."
		""
		"Piglin bartering yields ender pearls, soul sand,"
		"glowstone dust, nether quartz, and other valuables."
		""
		"Wear gold armor and piglins won't attack you."
		"Prepare 16 gold ingots for large-scale bartering!"
	]
	quest.0000000001000029.quest_subtitle: "Piglin Bartering"
	quest.0000000001000029.title: "Piglin Bartering"
	quest.0000000001000030.quest_desc: [
		"Nether quartz is an ore found throughout the Nether."
		""
		"Quartz ore can be found at any height in the Nether."
		"Quartz is used to craft redstone comparators,"
		"daylight detectors, and diorite."
		""
		"Quartz blocks are beautiful building materials,"
		"collect 64 quartz for building and crafting."
		""
		"Mining quartz ore also gives good XP!"
	]
	quest.0000000001000030.quest_subtitle: "Nether Quartz"
	quest.0000000001000030.title: "Nether Quartz"
	quest.0000000001000031.quest_desc: [
		"Mine the most powerful ore — Ancient Debris!"
		""
		"Ancient debris only generates in the Nether at Y=8-22,"
		"search at Y=15 using bed explosions or TNT."
		""
		"Ancient debris has extreme blast resistance,"
		"cannot be destroyed by any explosion."
		""
		"Smelt in a furnace into netherite scrap,"
		"4 scraps craft 1 netherite ingot."
	]
	quest.0000000001000031.quest_subtitle: "Ancient Debris"
	quest.0000000001000031.title: "Ancient Debris"
	quest.0000000001000032.quest_desc: [
		"Obtain the most powerful material in the game!"
		""
		"Upgrade diamond gear to netherite at a smithing table."
		"Netherite gear does not burn in lava,"
		"and has higher durability and armor values."
		""
		"Use 1 netherite ingot to upgrade one piece of gear,"
		"preserving existing enchantments and durability."
		""
		"Wear full netherite and conquer everything!"
	]
	quest.0000000001000032.quest_subtitle: "Netherite"
	quest.0000000001000032.title: "Netherite"
	quest.0000000001000033.quest_desc: [
		"Potion brewing is a powerful support system!"
		""
		"Craft a brewing stand with blaze rods and cobblestone."
		"Place water bottles in the bottom of the stand,"
		"and brewing ingredients on top."
		""
		"Use nether wart to make awkward potions as a base,"
		"then add other ingredients for specific effects."
		""
		"Glass bottles can be obtained from water sources or witches."
	]
	quest.0000000001000033.quest_subtitle: "Brewing Basics"
	quest.0000000001000033.title: "Brewing Basics"
	quest.0000000001000034.quest_desc: [
		"Dive deep into the art of potion brewing!"
		""
		"Craft at least one bottle of any potion."
		"Collect dragon's breath to make lingering potions,"
		"lingering potions create a potion cloud on the ground."
		""
		"Common potions: Strength, Swiftness, Regeneration,"
		"Fire Resistance, Night Vision, and Slow Falling."
		""
		"Enhance with glowstone dust, extend with redstone!"
	]
	quest.0000000001000034.quest_subtitle: "Advanced Brewing"
	quest.0000000001000034.title: "Advanced Brewing"
	quest.0000000001000035.quest_desc: [
		"Challenge the world's most dangerous boss — the Wither!"
		""
		"Summon using 3 wither skeleton skulls and 4 soul sand."
		"The Wither shoots explosive wither skulls,"
		"causing massive destruction and the Wither effect."
		""
		"Summon underground or far from your base,"
		"prepare golden apples, strength, and regeneration potions."
		""
		"Defeat the Wither to obtain a Nether Star!"
	]
	quest.0000000001000035.quest_subtitle: "Wither Battle"
	quest.0000000001000035.title: "Wither Battle"
	quest.0000000001000036.quest_desc: [
		"Activate your beacon with a Nether Star!"
		""
		"Place the beacon on top of a pyramid made of"
		"iron/gold/diamond/emerald/netherite blocks."
		""
		"The pyramid needs at least 3x3 (9 blocks),"
		"and can go up to a 4-tier pyramid."
		""
		"Beacons provide permanent area buffs:"
		"Speed, Haste, Resistance, Strength, Jump Boost, and Regeneration."
		""
		"Collect 36 iron blocks to build the beacon base!"
	]
	quest.0000000001000036.quest_subtitle: "Beacon Light"
	quest.0000000001000036.title: "Beacon Light"
	quest.0000000001000037.quest_desc: [
		"Long black figures flicker in the night."
		""
		"Endermen only attack when you look at their head!"
		"They are neutral when you don't look at them."
		""
		"Kill 10 Endermen for ender pearls."
		"Ender pearls are key to finding the stronghold."
		""
		"Build a 2-block-high shelter to safely fight Endermen,"
		"since they are 3 blocks tall and can't fit in!"
	]
	quest.0000000001000037.quest_subtitle: "Enderman Hunter"
	quest.0000000001000037.title: "Enderman Hunter"
	quest.0000000001000038.quest_desc: [
		"Find the portal to the End!"
		""
		"Craft eyes of ender with blaze powder and ender pearls."
		"Right-click with an eye of ender to throw it into the air,"
		"it will fly towards the nearest stronghold."
		""
		"You need up to 12 eyes of ender"
		"to activate the End portal frames."
		""
		"Follow the eyes of ender to find the underground stronghold!"
	]
	quest.0000000001000038.quest_subtitle: "Journey to the End"
	quest.0000000001000038.title: "Journey to the End"
	quest.0000000001000039.quest_desc: [
		"Delve into the underground stronghold to find the portal room!"
		""
		"The stronghold is filled with silverfish spawners,"
		"kill 5 silverfish and pass through their spawning areas."
		""
		"Collect 16 end stone as a memento."
		"Place eyes of ender in the portal frames to activate."
		""
		"Prepare thoroughly before entering the portal!"
		"Bring a bow, shield, and plenty of food."
	]
	quest.0000000001000039.quest_subtitle: "Stronghold Exploration"
	quest.0000000001000039.title: "Stronghold Exploration"
	quest.0000000001000040.quest_desc: [
		"Face the Ender Dragon and end her reign!"
		""
		"Destroy the End Crystals (on top of obsidian pillars) with a bow or snowballs,"
		"the crystals constantly heal the dragon."
		""
		"The dragon perches on the central bedrock pillar,"
		"this is the best time to attack her."
		""
		"After defeating the dragon, collect the dragon head as a trophy!"
		"The dragon egg appears on the bedrock pillar."
		""
		"Watch out for the dragon's breath attack!"
	]
	quest.0000000001000040.quest_subtitle: "Dragonslayer"
	quest.0000000001000040.title: "Dragonslayer"
	quest.0000000001000041.quest_desc: [
		"Travel through the End Gateway to the outer islands!"
		""
		"The outer islands are covered with chorus plants,"
		"collect 32 chorus fruit for eating and planting."
		""
		"Search for End Cities on the outer islands,"
		"kill shulkers for shulker shells,"
		"collect 16 purpur blocks for building."
		""
		"The End Cities also hold the precious Elytra!"
	]
	quest.0000000001000041.quest_subtitle: "End Outer Islands"
	quest.0000000001000041.title: "End Outer Islands"
	quest.0000000001000042.quest_desc: [
		"The sky is yours! Don the Elytra and soar!"
		""
		"Find the Elytra in an End City ship."
		"Wear the Elytra, jump from a high place, and press space to glide."
		""
		"Use firework rockets with Elytra for propelled flight,"
		"craft 32 firework rockets as flight fuel."
		""
		"Elytra can also combine with a Riptide trident for fast flight."
		"From now on, the sky is your domain!"
	]
	quest.0000000001000042.quest_subtitle: "Elytra Flight"
	quest.0000000001000042.title: "Elytra Flight"
	quest.0000000001000043.quest_desc: [
		"Shulkers are one of the most fearsome End mobs!"
		""
		"Shulkers cling to the walls of End Cities,"
		"shooting homing projectiles that make targets levitate."
		""
		"Shulker shells are the only material for shulker boxes,"
		"shulker boxes are portable containers — an expandable backpack!"
		""
		"Craft 4 shulker boxes for storage expansion."
		"Shulker boxes retain their contents even when broken."
	]
	quest.0000000001000043.quest_subtitle: "Shulker Farm"
	quest.0000000001000043.title: "Shulker Farm"
	quest.0000000001000044.quest_desc: [
		"You have fully conquered the End dimension!"
		""
		"Display a dragon head, elytra, 8 shulker boxes,"
		"and 64 ender pearls,"
		"proving you have mastered everything in the End."
		""
		"From defeating the Ender Dragon to exploring the outer islands,"
		"you have endured a long and difficult journey."
		""
		"The End holds no more secrets!"
	]
	quest.0000000001000044.quest_subtitle: "End Conquest"
	quest.0000000001000044.title: "End Conquest"
	quest.0000000001000045.quest_desc: [
		"Villagers are your best trading partners!"
		""
		"Find a village and interact with villagers to trade."
		"Trade crops and minerals with villagers for emeralds."
		""
		"Collect 16 emeralds and 4 emerald blocks."
		"Different villager professions offer different trades."
		""
		"Repeat trades to unlock better trading options,"
		"discounted trades are even more worthwhile!"
	]
	quest.0000000001000045.quest_subtitle: "Villager Trading"
	quest.0000000001000045.title: "Villager Trading"
	quest.0000000001000046.quest_desc: [
		"The librarian is the guardian of knowledge."
		""
		"Craft a lectern with 9 books and 6 planks,"
		"a lectern lets unemployed villagers become librarians."
		""
		"Collect 16 bookshelves to empower your enchanting table."
		"Bookshelves are key to boosting enchantment levels."
		""
		"Trade with librarians to obtain enchanted books!"
	]
	quest.0000000001000046.quest_subtitle: "The Librarian"
	quest.0000000001000046.title: "The Librarian"
	quest.0000000001000047.quest_desc: [
		"Man's best friend — tame a wolf!"
		""
		"Find wild wolves in taiga and forest biomes,"
		"right-click with bones for a chance to tame them."
		""
		"Tamed wolves will follow and protect you,"
		"automatically attacking anything that hurts you or you attack."
		""
		"Prepare 16 bones for taming attempts,"
		"and wheat to breed your tamed wolves."
	]
	quest.0000000001000047.quest_subtitle: "Tame the Wolf"
	quest.0000000001000047.title: "Tame the Wolf"
	quest.0000000001000048.quest_desc: [
		"Creepers fear cats more than players!"
		""
		"Find stray cats near villages,"
		"sneak close and tame them with raw cod or raw salmon."
		""
		"Cats follow their owner when sleeping and bring little gifts,"
		"creepers and phantoms actively avoid cats."
		""
		"Prepare 16 fish for taming attempts,"
		"there are 11 different cat variants!"
	]
	quest.0000000001000048.quest_subtitle: "Tame the Cat"
	quest.0000000001000048.title: "Tame the Cat"
	quest.0000000001000049.quest_desc: [
		"Enchanting is the ultimate way to enhance gear!"
		""
		"Craft an enchanting table with 4 obsidian, 2 diamonds, and 1 book."
		"Surround the table with bookshelves for high-level enchantments,"
		"level 30 enchants require 15 bookshelves around it."
		""
		"Enchanting costs XP and lapis lazuli,"
		"greatly improving gear power and durability."
		""
		"Enchanting swords, pickaxes, bows, and armor is core gameplay!"
	]
	quest.0000000001000049.quest_subtitle: "Path of Enchanting"
	quest.0000000001000049.title: "Path of Enchanting"
	quest.0000000001000050.quest_desc: [
		"Master the ultimate art of enchanting!"
		""
		"Obtain 4 enchanted books — through fishing,"
		"villager trading, or the enchanting table."
		""
		"Use an anvil to apply enchanted books to gear."
		""
		"Collect 64 lapis lazuli as enchantment fuel,"
		"master the strategy of stacking multiple enchantments."
		""
		"Recommended enchants: Efficiency V, Unbreaking III, Sharpness V!"
	]
	quest.0000000001000050.quest_subtitle: "Enchanting Master"
	quest.0000000001000050.title: "Enchanting Master"
	quest.0000000001000051.quest_desc: [
		"Equipment always wears down, learn to repair it!"
		""
		"Craft a grindstone with 2 sticks, 1 stone slab, and 2 planks."
		"The grindstone removes enchantments and returns some XP."
		""
		"Repair gear at an anvil using base materials:"
		"use iron ingots to repair iron tools and armor."
		""
		"Stockpile 32 iron ingots for repairs."
		"The Mending enchantment auto-repairs gear!"
	]
	quest.0000000001000051.quest_subtitle: "Repair Equipment"
	quest.0000000001000051.title: "Repair Equipment"
	quest.0000000001000052.quest_desc: [
		"Diamonds make the highest-tier equipment!"
		""
		"Diamond chestplate provides 8 armor points,"
		"2 more than iron chestplate, with significant damage reduction."
		""
		"Diamond gear has far higher durability than iron,"
		"it will accompany you through most of the game."
		""
		"With diamond armor, you can challenge"
		"Nether fortresses, the End, and other dangerous areas!"
	]
	quest.0000000001000052.quest_subtitle: "Diamond Armor"
	quest.0000000001000052.title: "Diamond Armor"
	quest.0000000001000053.quest_desc: [
		"Wear a full set of diamond armor and shine!"
		""
		"Full diamond requires 24 diamonds,"
		"providing 20 max armor points."
		""
		"Diamond helmet, leggings, and boots,"
		"plus the diamond chestplate, complete the diamond set."
		""
		"Full diamond reduces damage by 80%!"
		"The minimum setup for challenging the Wither and Ender Dragon."
	]
	quest.0000000001000053.quest_subtitle: "Full Diamond Set"
	quest.0000000001000053.title: "Full Diamond Set"
	quest.0000000001000054.quest_desc: [
		"A true symbol of wealth — the Diamond Block!"
		""
		"Craft 1 diamond block using 9 diamonds."
		"Show off your vast diamond reserves."
		""
		"Diamond blocks can be used in beacon bases,"
		"and are the best choice for luxurious builds."
		""
		"Flaunt your wealth and gathering prowess!"
	]
	quest.0000000001000054.quest_subtitle: "Diamond Block"
	quest.0000000001000054.title: "Diamond Block"
	quest.0000000001000055.quest_desc: [
		"Congratulations! You have completed Vanilla Survival Basics!"
		""
		"From your first log to defeating the Wither and Ender Dragon,"
		"you have mastered everything in vanilla Minecraft."
		""
		"You have displayed a diamond block, nether star,"
		"dragon head, and enchanted golden apple —"
		"the highest honors of your journey."
		""
		"New adventures await you ahead!"
	]
	quest.0000000001000055.quest_subtitle: "Chapter Graduation"
	quest.0000000001000055.title: "Chapter One Graduation"
	quest.0000000002000001.quest_desc: [
		"Welcome to the Cooking  Water chapter!"
		""
		"This chapter covers four systems:"
		"• Farmer's Delight — Farm to table"
		"• Kaleidoscope Cookery — Gourmet cuisine"
		"• Kaleidoscope Tavern — Bar management"
		"• Thirst Was Taken — Water system"
	]
	quest.0000000002000001.quest_subtitle: "Chapter Entry"
	quest.0000000002000001.title: "Culinary Journey"
	quest.0000000002000002.quest_desc: [
		"The Cutting Board is the first tool you need for"
		"food preparation in Farmer's Delight."
		""
		"Place it down and use a knife on the Cutting Board"
		"to chop ingredients into smaller pieces for cooking."
	]
	quest.0000000002000002.quest_subtitle: "Prepare your ingredients"
	quest.0000000002000002.title: "Kitchen Basics"
	quest.0000000002000003.quest_desc: [
		"The Skillet is used for frying and searing foods."
		""
		"Place it above a heat source like a Stove or campfire."
		"Add ingredients directly to fry meat, eggs, and more."
	]
	quest.0000000002000003.quest_subtitle: "Frying made easy"
	quest.0000000002000003.title: "Skillet Cooking"
	quest.0000000002000004.quest_desc: [
		"The Stove is the central cooking station providing"
		"permanent heat for all cooking appliances."
		""
		"It eliminates the need for campfires and can keep"
		"multiple pots, pans, and skillets running at once."
	]
	quest.0000000002000004.quest_subtitle: "Permanent cooking heat"
	quest.0000000002000004.title: "Stove Heat"
	quest.0000000002000005.quest_desc: [
		"Place the Cooking Pot on a Stove to unlock"
		"its full potential for soups, stews, and feasts."
		""
		"Add water, ingredients, and a heat source to cook"
		"complex meals that restore plenty of hunger."
	]
	quest.0000000002000005.quest_subtitle: "Hearty meals await"
	quest.0000000002000005.title: "FD Crops"
	quest.0000000002000006.quest_desc: [
		"The Basket is a portable storage container designed"
		"for food items and crops."
		""
		"Use it to organize your kitchen and carry harvested"
		"crops from your farm back to base."
	]
	quest.0000000002000006.quest_subtitle: "Portable food storage"
	quest.0000000002000006.title: "Crop Seeds"
	quest.0000000002000007.quest_desc: [
		"Rich Soil is created by letting Organic Compost"
		"decompose naturally over time."
		""
		"It grows crops significantly faster than regular"
		"farmland and provides natural moisture retention."
	]
	quest.0000000002000007.quest_subtitle: "Supercharged farmland"
	quest.0000000002000007.title: "Rich Soil"
	quest.0000000002000008.quest_desc: [
		"Organic Compost is made from crop leftovers,"
		"rotten food, and other organic materials."
		""
		"Spread it on the ground and wait for it to turn"
		"into Rich Soil for accelerated crop growth."
	]
	quest.0000000002000008.quest_subtitle: "Nature's fertilizer"
	quest.0000000002000008.title: "Kitchen Knives"
	quest.0000000002000009.quest_desc: [
		"Rice is a staple grain that grows in shallow"
		"water on Rich Soil."
		""
		"Harvest Rice to make Cooked Rice which is the"
		"foundation for Fried Rice and many other dishes."
	]
	quest.0000000002000009.quest_subtitle: "Staple crop farming"
	quest.0000000002000009.title: "Simple Cooking"
	quest.000000000200000A.quest_desc: [
		"Onions are a versatile vegetable used in many"
		"Farmer's Delight recipes."
		""
		"They add flavor to soups, stews, sandwiches,"
		"and salads throughout your cooking journey."
	]
	quest.000000000200000A.quest_subtitle: "Versatile vegetable"
	quest.000000000200000A.title: "Onion"
	quest.000000000200000B.quest_desc: [
		"Tomatoes are a garden staple for sauces, salads,"
		"and sandwiches."
		""
		"Plant Tomato Seeds on Rich Soil for a bountiful"
		"harvest used in pasta dishes and burgers."
	]
	quest.000000000200000B.quest_subtitle: "Sauce and salad staple"
	quest.000000000200000B.title: "Tomato"
	quest.000000000200000C.quest_desc: [
		"Cabbage leaves can be harvested multiple times"
		"from a single plant without replanting."
		""
		"Use them for Cabbage Rolls, salads, and various"
		"vegetable dishes in your kitchen."
	]
	quest.000000000200000C.quest_subtitle: "Leafy green harvest"
	quest.000000000200000C.title: "Cabbage"
	quest.000000000200000D.quest_desc: [
		"The Flint Knife is your basic cutting tool for"
		"processing ingredients on the Cutting Board."
		""
		"Use it to chop vegetables, cut meat, and harvest"
		"extra resources from grass and plants."
	]
	quest.000000000200000D.quest_subtitle: "Basic cutting tool"
	quest.000000000200000D.title: "Flint Knife"
	quest.000000000200000E.quest_desc: [
		"The Iron Knife is more durable than flint and"
		"processes ingredients faster."
		""
		"Upgrade your tools to speed up food preparation"
		"and reduce wear on your cutting equipment."
	]
	quest.000000000200000E.quest_subtitle: "Durable kitchen tool"
	quest.000000000200000E.title: "Iron Knife"
	quest.000000000200000F.quest_desc: [
		"The Diamond Knife is a high-tier cutting tool"
		"with excellent durability and speed."
		""
		"It makes short work of any ingredient preparation"
		"and is a worthwhile long-term investment."
	]
	quest.000000000200000F.quest_subtitle: "Precision cutting"
	quest.000000000200000F.title: "Diamond Knife"
	quest.0000000002000010.quest_desc: [
		"The Netherite Knife is the ultimate cutting tool"
		"with supreme durability and unmatched speed."
		""
		"It is the final upgrade for your kitchen arsenal."
	]
	quest.0000000002000010.quest_subtitle: "Ultimate kitchen blade"
	quest.0000000002000010.title: "Salads"
	quest.0000000002000011.quest_desc: [
		"Roast Chicken is a hearty meal that provides"
		"great nutrition and satisfaction."
		""
		"Cook a whole chicken in the Cooking Pot with"
		"vegetables for this filling feast."
	]
	quest.0000000002000011.quest_subtitle: "Hearty protein meal"
	quest.0000000002000011.title: "Soups"
	quest.0000000002000012.quest_desc: [
		"Steak and Potatoes is a classic protein-rich meal"
		"combining beef with hearty potatoes."
		""
		"Cook beef and potatoes together in the Cooking Pot"
		"for this satisfying and nutritious dish."
	]
	quest.0000000002000012.quest_subtitle: "Classic comfort food"
	quest.0000000002000012.title: "Seafood"
	quest.0000000002000013.quest_desc: [
		"The Hamburger is a complete meal with bread,"
		"meat, and fresh vegetables."
		""
		"It provides excellent saturation for long"
		"adventures and mining expeditions."
	]
	quest.0000000002000013.quest_subtitle: "Complete handheld meal"
	quest.0000000002000013.title: "Noodles  Dumplings"
	quest.0000000002000014.quest_desc: [
		"Mixed Salad combines various vegetables for a"
		"light but nutritious meal."
		""
		"Quick to prepare with cabbage, tomato, and onion,"
		"it is perfect for early-game food supply."
	]
	quest.0000000002000014.quest_subtitle: "Light and nutritious"
	quest.0000000002000014.title: "Rice Dishes"
	quest.0000000002000015.quest_desc: [
		"Fruit Salad adds natural sweetness to your diet"
		"with a variety of fresh fruits."
		""
		"A refreshing meal that provides good nutrition"
		"and a tasty break from savory dishes."
	]
	quest.0000000002000015.quest_subtitle: "Sweet and refreshing"
	quest.0000000002000015.title: "Meat Platters"
	quest.0000000002000016.quest_desc: [
		"Stuffed Pumpkin is a festive feast item that"
		"combines pumpkin with rich ingredients."
		""
		"It serves as a decorative and nourishing meal,"
		"marking mastery of Farmer's Delight cooking."
	]
	quest.0000000002000016.quest_subtitle: "Festive feast item"
	quest.0000000002000016.title: "Sandwiches"
	quest.0000000002000017.quest_desc: [
		"The Kaleidoscope Stove is a multi-functional"
		"cooking station for advanced cuisine."
		""
		"It supports Woks, Stockpots, Steamers, and Frying"
		"Pans for diverse Chinese-style cooking methods."
	]
	quest.0000000002000017.quest_subtitle: "Kaleidoscope cooking station"
	quest.0000000002000017.title: "Drinks"
	quest.0000000002000018.quest_desc: [
		"The Wok is used for high-heat stir-frying on a"
		"Kaleidoscope Stove."
		""
		"Combine with Oil and ingredients to quickly cook"
		"flavorful Chinese stir-fry dishes."
	]
	quest.0000000002000018.quest_subtitle: "High-heat stir-frying"
	quest.0000000002000018.title: "Bakery"
	quest.0000000002000019.quest_desc: [
		"The Stockpot is used for slow-cooking rich broths"
		"and soups on the Kaleidoscope Stove."
		""
		"It is essential for preparing stocks that form"
		"the flavor base of many Chinese dishes."
	]
	quest.0000000002000019.quest_subtitle: "Slow-cooking broths"
	quest.0000000002000019.title: "Storage"
	quest.000000000200001A.quest_desc: [
		"The Steamer cooks food with steam, preserving"
		"nutrients and delicate textures."
		""
		"Use it to make Dumplings, Buns, and other steamed"
		"delicacies from Chinese cuisine."
	]
	quest.000000000200001A.quest_subtitle: "Steam-cooked delicacies"
	quest.000000000200001A.title: "Steamer"
	quest.000000000200001B.quest_desc: [
		"The Teapot brews tea from various ingredients"
		"for unique buffs and effects."
		""
		"Tea pairs perfectly with desserts and provides"
		"a relaxing break from cooking."
	]
	quest.000000000200001B.quest_subtitle: "Brew soothing tea"
	quest.000000000200001B.title: "Teapot"
	quest.000000000200001C.quest_desc: [
		"The Kaleidoscope Chopping Board processes"
		"ingredients for advanced recipes."
		""
		"Use it with a Kitchen Knife to prepare dumpling"
		"wrappers and other specialty ingredients."
	]
	quest.000000000200001C.quest_subtitle: "Precision prep surface"
	quest.000000000200001C.title: "KaC Chopping Board"
	quest.000000000200001D.quest_desc: [
		"The Kaleidoscope Kitchen Knife is designed for"
		"precision cutting of ingredients."
		""
		"It is used on the Chopping Board to prepare"
		"ingredients for Chinese cuisine recipes."
	]
	quest.000000000200001D.quest_subtitle: "KaC precision blade"
	quest.000000000200001D.title: "Kitchen Knife"
	quest.000000000200001E.quest_desc: [
		"Cooking Oil is a fundamental ingredient required"
		"for stir-frying and pan-frying."
		""
		"Extract it from seeds using the Millstone and"
		"store it in an Oil Pot near your stove."
	]
	quest.000000000200001E.quest_subtitle: "Essential stir-fry ingredient"
	quest.000000000200001E.title: "Cooking Oil"
	quest.000000000200001F.quest_desc: [
		"The Frying Pan is for pan-frying dumplings, meats,"
		"and other ingredients to golden perfection."
		""
		"It requires Oil and a heat source from the"
		"Kaleidoscope Stove to operate."
	]
	quest.000000000200001F.quest_subtitle: "Golden pan-frying"
	quest.000000000200001F.title: "Frying Pan"
	quest.0000000002000020.quest_desc: [
		"Egg Fried Rice is a classic simple dish made"
		"with rice, egg, and a splash of oil."
		""
		"A quick and satisfying meal that is easy to"
		"prepare in bulk for your adventures."
	]
	quest.0000000002000020.quest_subtitle: "Classic simple dish"
	quest.0000000002000020.title: "Organic Composting"
	quest.0000000002000021.quest_desc: [
		"Mapo Tofu is a spicy Sichuan dish featuring"
		"tofu and minced meat in a bold sauce."
		""
		"It provides strong nourishment and represents"
		"advanced Chinese cooking techniques."
	]
	quest.0000000002000021.quest_subtitle: "Culinary Master"
	quest.0000000002000021.title: "FD Master"
	quest.0000000002000022.quest_desc: [
		"Kung Pao Chicken is a spicy stir-fry with"
		"chicken, peanuts, and colorful vegetables."
		""
		"A protein-rich dish that restores significant"
		"hunger and showcases wok mastery."
	]
	quest.0000000002000022.quest_subtitle: "Nutty spicy stir-fry"
	quest.0000000002000022.title: "KaC Kitchen"
	quest.0000000002000023.quest_desc: [
		"Dim Sum is a collection of small steamed dishes"
		"representing the art of tea-time cuisine."
		""
		"Made using the Chopping Board and Steamer, it"
		"provides excellent nutrition in small portions."
	]
	quest.0000000002000023.quest_subtitle: "Steamed bite-sized treats"
	quest.0000000002000023.title: "Chinese Cuisine"
	quest.0000000002000024.quest_desc: [
		"Sakura Fubuki is an elegant dessert featuring"
		"delicate cherry blossom flavors."
		""
		"A high-tier dish that showcases mastery of"
		"Kaleidoscope Cookery and dessert artistry."
	]
	quest.0000000002000024.quest_subtitle: "Cherry blossom elegance"
	quest.0000000002000024.title: "Japanese Cuisine"
	quest.0000000002000025.quest_desc: [
		"Mochi is a sweet rice cake dessert with"
		"various fillings and a soft chewy texture."
		""
		"A classic Japanese treat that rounds out the"
		"dessert menu in Kaleidoscope Cookery."
	]
	quest.0000000002000025.quest_subtitle: "Sweet rice cake dessert"
	quest.0000000002000025.title: "Western Cuisine"
	quest.0000000002000026.quest_desc: [
		"The Bar Counter is the centerpiece of your"
		"tavern from Kaleidoscope Tavern."
		""
		"Place it down to begin setting up your personal"
		"bar and serving area for drinks and guests."
	]
	quest.0000000002000026.quest_subtitle: "Tavern centerpiece"
	quest.0000000002000026.title: "KaC Desserts"
	quest.0000000002000027.quest_desc: [
		"The Bar Cabinet stores bottles, glasses, and"
		"bar tools for your tavern."
		""
		"It helps organize your brewing ingredients and"
		"keeps everything close at hand while serving."
	]
	quest.0000000002000027.quest_subtitle: "Tavern storage"
	quest.0000000002000027.title: "Barley Tea"
	quest.0000000002000028.quest_desc: [
		"The Cellar Cabinet is designed for aging drinks"
		"in cool underground storage."
		""
		"It preserves wine and spirits, improving their"
		"quality and effects over time."
	]
	quest.0000000002000028.quest_subtitle: "Aging and preservation"
	quest.0000000002000028.title: "KaC Decor"
	quest.0000000002000029.quest_desc: [
		"The Black Bar Stool provides seating for your"
		"tavern guests at the Bar Counter."
		""
		"Place several around your bar for a complete"
		"and inviting tavern atmosphere."
	]
	quest.0000000002000029.quest_subtitle: "Seating for guests"
	quest.0000000002000029.title: "KaT Tavern"
	quest.000000000200002A.quest_desc: [
		"The Black Sofa adds comfort seating to your"
		"tavern lounge and relaxation area."
		""
		"Create a cozy atmosphere for guests enjoying"
		"their drinks after a long adventure."
	]
	quest.000000000200002A.quest_subtitle: "Lounge comfort"
	quest.000000000200002A.title: "Sofa"
	quest.000000000200002B.quest_desc: [
		"Empty Bottles are crafted from glass and are"
		"essential for brewing beverages."
		""
		"Fill them with various ingredients and age them"
		"in the Cellar Cabinet to create fine drinks."
	]
	quest.000000000200002B.quest_subtitle: "Brewing essentials"
	quest.000000000200002B.title: "Empty Bottle"
	quest.000000000200002C.quest_desc: [
		"Brandy is a distilled wine spirit served in"
		"the tavern with unique status effects."
		""
		"Age wine in the Cellar Cabinet and distill it"
		"to produce this refined beverage."
	]
	quest.000000000200002C.quest_subtitle: "Distilled wine spirit"
	quest.000000000200002C.title: "Brandy"
	quest.000000000200002D.quest_desc: [
		"Champagne is a sparkling wine crafted for"
		"celebrations and special occasions."
		""
		"It offers special buffs and represents the"
		"pinnacle of brewing craftsmanship."
	]
	quest.000000000200002D.quest_subtitle: "Sparkling celebration"
	quest.000000000200002D.title: "Champagne"
	quest.000000000200002E.quest_desc: [
		"Bloody Mary is a complex cocktail combining"
		"tomato juice with spices and spirits."
		""
		"It provides unique effects and showcases your"
		"growing mixology skills in the tavern."
	]
	quest.000000000200002E.quest_subtitle: "Savory cocktail"
	quest.000000000200002E.title: "Bloody Mary"
	quest.000000000200002F.quest_desc: [
		"Depth Charge is a powerful drink served by"
		"dropping a shot into a glass of beer."
		""
		"It offers significant effects and is the"
		"ultimate tavern concoction for brave patrons."
	]
	quest.000000000200002F.quest_subtitle: "Ultimate tavern drink"
	quest.000000000200002F.title: "Depth Charge"
	quest.0000000002000030.quest_desc: [
		"Empty Glassware is used to serve drinks"
		"professionally in your tavern."
		""
		"Craft various glasses and mugs to present"
		"your beverages with elegance and style."
	]
	quest.0000000002000030.quest_subtitle: "Serve in style"
	quest.0000000002000030.title: "Bar Seating"
	quest.0000000002000031.quest_desc: [
		"The Chalkboard displays the menu of your tavern"
		"for guests to see."
		""
		"Write down your available drinks and dishes to"
		"create a welcoming pub atmosphere."
	]
	quest.0000000002000031.quest_subtitle: "Tavern menu display"
	quest.0000000002000031.title: "Bar Cocktails"
	quest.0000000002000032.quest_desc: [
		"Incense provides relaxing ambiance in your"
		"tavern with pleasant aromas."
		""
		"Craft Butterfly or Catnip incense to create"
		"different atmospheric effects for your guests."
	]
	quest.0000000002000032.quest_subtitle: "Aromatic ambiance"
	quest.0000000002000032.title: "Bar Reserve"
	quest.0000000002000033.quest_desc: [
		"The Clay Bowl is the first container for"
		"collecting and drinking water."
		""
		"Scoop water from sources to begin quenching"
		"your thirst and surviving in the world."
	]
	quest.0000000002000033.quest_subtitle: "First water container"
	quest.0000000002000033.title: "Tavern Decor"
	quest.0000000002000034.quest_desc: [
		"The Terracotta Bowl is an upgraded water"
		"container with greater capacity."
		""
		"It holds more water and is more durable than"
		"the basic Clay Bowl for longer journeys."
	]
	quest.0000000002000034.quest_subtitle: "Upgraded water container"
	quest.0000000002000034.title: "Tavern Garden"
	quest.0000000002000035.quest_desc: [
		"The Terracotta Water Bowl holds purified"
		"drinking water for safe consumption."
		""
		"Keep it filled to maintain your thirst bar"
		"during long mining trips and adventures."
	]
	quest.0000000002000035.quest_subtitle: "Purified drinking water"
	quest.0000000002000035.title: "Tavern Paintings"
	quest.0000000002000036.quest_desc: [
		"The Sand Filter purifies dirty water into clean"
		"drinking water using sand and gravel layers."
		""
		"Essential for survival when clean water sources"
		"are scarce or distant from your base."
	]
	quest.0000000002000036.quest_subtitle: "Water purification"
	quest.0000000002000036.title: "Bar Trinkets"
	quest.0000000002000037.quest_desc: [
		"The Sleeping Bag from Comforts allows you to"
		"sleep anywhere without resetting your spawn."
		""
		"Perfect for exploration and travel when you"
		"are far from your bed at base."
	]
	quest.0000000002000037.quest_subtitle: "Sleep anywhere"
	quest.0000000002000037.title: "KaC/KaT Master"
	quest.0000000002000038.quest_desc: [
		"The Hammock is a portable sleeping solution"
		"that can be strung between trees or posts."
		""
		"It offers comfortable rest in the wilderness"
		"without resetting your spawn point."
	]
	quest.0000000002000038.quest_subtitle: "String up and rest"
	quest.0000000002000038.title: "Thirst System"
	quest.0000000002000039.quest_desc: [
		"The Waystone is a teleportation anchor for"
		"creating a fast travel network."
		""
		"Place Waystones in important locations and"
		"activate them to enable teleportation."
	]
	quest.0000000002000039.quest_subtitle: "Teleportation anchor"
	quest.0000000002000039.title: "Upgraded Bowls"
	quest.000000000200003A.quest_desc: [
		"The Warp Stone is a portable device that lets"
		"you teleport to any activated Waystone."
		""
		"Carry it with you to return home or travel"
		"between bases from anywhere in the world."
	]
	quest.000000000200003A.quest_subtitle: "Portable teleportation"
	quest.000000000200003A.title: "Warp Stone"
	quest.0000000002000040.title: "Sand Filter"
	quest.0000000002000041.title: "Water Master"
	quest.0000000002000042.title: "Sleeping Gear"
	quest.0000000002000043.title: "Rope  Nail"
	quest.0000000002000044.title: "Waystones"
	quest.0000000002000045.title: "Survival Master"
	quest.0000000002000046.title: "More BBQ"
	quest.0000000002000047.title: "Skewers"
	quest.0000000002000048.title: "Ice  Cookies"
	quest.0000000002000049.title: "Milk  Broth"
	quest.0000000002000050.quest_desc: [
		"Congratulations! You have mastered the culinary arts!"
		""
		"From farm to tavern, you are the ultimate culinary master!"
	]
	quest.0000000002000050.quest_subtitle: "Chapter Complete"
	quest.0000000002000050.title: "Culinary Graduation"
	quest.0000000003000001.quest_desc: [
		"The vanilla chest era is coming to an end!"
		""
		"This chapter introduces modern storage systems:"
		""
		"Sophisticated Backpacks:"
		"- Multi-tier upgradeable portable backpacks"
		"- Auto-pickup, auto-feed, fluid storage"
		"- Upgrade slots for custom functionality"
		""
		"Sophisticated Storage:"
		"- Multi-tier barrels, chests, and shulker boxes"
		"- Storage Controller for unified network management"
		"- Wireless/wired storage access terminals"
		""
		"Prepare 4 vanilla chests as your foundation"
		"and begin your storage revolution!"
	]
	quest.0000000003000001.quest_subtitle: "Farewell to messy chests"
	quest.0000000003000001.title: "Storage Revolution"
	quest.0000000003000002.quest_desc: [
		"This is your first Sophisticated Backpack!"
		""
		"Right-click to open the backpack interface."
		"The basic backpack provides 27 slots of storage,"
		"equivalent to a small chest."
		""
		"Core features of Sophisticated Backpacks:"
		"- Upgrade slots (1 slot initially)"
		"- Install pickup upgrades, crafting upgrades, etc."
		"- Sneak + right-click to place on the ground"
		"- Retains all items and upgrades when broken"
		""
		"Submit a basic backpack and begin your upgrade journey!"
	]
	quest.0000000003000002.quest_subtitle: "Sophisticated Backpack Intro"
	quest.0000000003000002.title: "Basic Backpack"
	quest.0000000003000003.quest_desc: [
		"Upgrade your basic backpack to an iron backpack!"
		""
		"Iron Backpack attributes:"
		"- Storage: 54 slots (double chest size)"
		"- Upgrade slots: 2"
		"- Stronger material, metallic appearance"
		""
		"Crafting method:"
		"Surround a basic backpack with iron ingots"
		"(Check JEI for exact recipe)"
		""
		"Each upgrade dramatically improves"
		"both capacity and functionality!"
	]
	quest.0000000003000003.quest_subtitle: "Iron Backpack - More Space"
	quest.0000000003000003.title: "Iron Upgrade"
	quest.0000000003000004.quest_desc: [
		"Upgrade from iron backpack to gold backpack!"
		""
		"Gold Backpack attributes:"
		"- Storage: 81 slots"
		"- Upgrade slots: 3"
		"- Golden appearance, luxurious look"
		""
		"The gold material backpack features"
		"special spatial folding magic,"
		"providing 50% more capacity than iron!"
		""
		"Surround an iron backpack with gold ingots to craft."
	]
	quest.0000000003000004.quest_subtitle: "Gold Backpack - Speed and Luxury"
	quest.0000000003000004.title: "Gold Upgrade"
	quest.0000000003000005.quest_desc: [
		"Upgrade from gold backpack to diamond backpack!"
		""
		"Diamond Backpack attributes:"
		"- Storage: 108 slots"
		"- Upgrade slots: 4"
		"- Diamond material, improved blast resistance"
		""
		"The diamond backpack satisfies nearly all"
		"daily adventure storage needs."
		"With upgrade modules, it becomes even more powerful."
		""
		"But for the ultimate..."
		"there is one more upgrade tier waiting for you!"
	]
	quest.0000000003000005.quest_subtitle: "Diamond Backpack - Top Capacity"
	quest.0000000003000005.title: "Diamond Upgrade"
	quest.0000000003000006.quest_desc: [
		"The ultimate form of Sophisticated Backpacks!"
		""
		"Netherite Backpack attributes:"
		"- Storage: 135 slots"
		"- Upgrade slots: 5"
		"- Immune to fire and lava destruction"
		"- Void resistance - survives falling into the void"
		""
		"Upgrade requires a Netherite Upgrade Smithing Template."
		"Combine a diamond backpack with a netherite ingot."
		""
		"With this, you will hardly ever need"
		"any additional portable storage!"
	]
	quest.0000000003000006.quest_subtitle: "Ultimate Portable Warehouse"
	quest.0000000003000006.title: "Netherite Upgrade"
	quest.0000000003000007.quest_desc: [
		"Sophisticated Storage offers a multi-tier container system."
		""
		"The Barrel is the fundamental container of Sophisticated Storage."
		""
		"Features:"
		"- Placed and used like vanilla barrels"
		"- Supports multi-tier material upgrades (Iron/Gold/Diamond/Netherite)"
		"- Each upgrade tier adds more storage space"
		"- Retains items and upgrades when broken"
		"- Can be connected to the storage network for unified management"
		""
		"Craft 2 basic barrels to get started!"
	]
	quest.0000000003000007.quest_subtitle: "Sophisticated Storage Basics"
	quest.0000000003000007.title: "Barrels"
	quest.0000000003000008.quest_desc: [
		"Sophisticated Storage barrels/chests/shulker boxes"
		"support four material upgrade tiers:"
		""
		"Iron - Basic upgrade, extra space"
		"Gold - Larger capacity, faster access"
		"Diamond - Major expansion, enhanced blast resistance"
		"Netherite - Ultimate upgrade, immune to fire"
		""
		"Each upgrade requires the corresponding mineral block."
		"Gather all four materials"
		"and prepare your storage network!"
	]
	quest.0000000003000008.quest_subtitle: "Four Upgrade Materials"
	quest.0000000003000008.title: "Barrel Upgrades"
	quest.0000000003000009.quest_desc: [
		"The Storage Controller is the heart of the entire storage system!"
		""
		"Once placed, it manages all"
		"connected storage containers in its vicinity."
		""
		"Functions:"
		"- Unified item search interface"
		"- Cross-container item management"
		"- Supports storage links to extend network range"
		"- Supports wireless terminal remote access"
		""
		"With a controller, you no longer need to remember"
		"what is stored in each chest."
		"Everything is managed through one interface!"
	]
	quest.0000000003000009.quest_subtitle: "Core of Storage Network"
	quest.0000000003000009.title: "Storage Controller"
	quest.0000000003000010.quest_desc: [
		"Storage Links extend the controller's coverage range."
		""
		"By default, the controller only manages"
		"containers within a limited surrounding range."
		"Using Storage Links you can:"
		"- Connect distant containers to the network"
		"- Bridge across floors and rooms"
		"- Build large-scale automated warehouses"
		""
		"Each link connects to one container group."
		"Craft 4 Storage Links"
		"to lay the foundation for a large storage network!"
	]
	quest.0000000003000010.quest_subtitle: "Expand Your Storage Network"
	quest.0000000003000010.title: "Storage Link"
	quest.0000000003000011.quest_desc: [
		"Put all your storage knowledge into practice!"
		""
		"Building a complete storage network requires:"
		"- 16 Chests - as basic storage units"
		"- 4 Barrels - as auxiliary storage containers"
		""
		"Place these containers around the controller"
		"and use storage links to extend the network range."
		""
		"Your first automated warehouse"
		"is about to go online!"
		""
		"Say goodbye to rummaging through chests!"
	]
	quest.0000000003000011.quest_subtitle: "Build Automated Warehouse"
	quest.0000000003000011.title: "Storage Network"
	quest.0000000003000012.quest_desc: [
		"Congratulations! You have become a Storage Master!"
		""
		"You have mastered:"
		"- The five-tier upgrade system of Sophisticated Backpacks"
		"- The multi-tier container upgrades of Sophisticated Storage"
		"- Storage Controllers and Links network architecture"
		"- Automated warehouse construction methods"
		""
		"With a Netherite Backpack and Storage Controller,"
		"you are one of the foremost"
		"item management experts on this server!"
		""
		"Take your portable warehouse and storage network"
		"and go conquer greater goals!"
	]
	quest.0000000003000012.quest_subtitle: "The True Storage Master"
	quest.0000000003000012.title: "Storage Master Graduation"
	quest.0000000003000013.quest_desc: ["Craft a Storage Link to connect more blocks to the network."]
	quest.0000000003000013.quest_subtitle: "Connect Your Network"
	quest.0000000003000013.title: "Storage Link"
	quest.0000000003000014.quest_desc: [
		"Congratulations! You have mastered storage in this world."
		""
		"Claim your reward for completing the Storage Master chapter."
	]
	quest.0000000003000014.quest_subtitle: "Complete the Chapter"
	quest.0000000003000014.title: "Storage Master Graduation"
	quest.0000000004000001.quest_desc: [
		"Macaw's is a suite of modular building mods"
		"providing windows, doors, fences, furniture, and bridges."
		""
		"Macaw's mods installed in this pack:"
		"- Windows - Windows and shutters"
		"- Doors - Multiple door styles"
		"- Fences - Fences and hedges"
		"- Furniture - Indoor furniture"
		"- Bridges - Bridge construction"
		""
		"Let's start with the most basic: windows!"
	]
	quest.0000000004000001.quest_subtitle: "Macaw's Modular"
	quest.0000000004000001.title: "Building Basics"
	quest.0000000004000002.quest_desc: [
		"Macaw's Windows offers many window styles."
		""
		"Begin your window journey with oak variants:"
		"- Oak Window - Basic window frame"
		"- Oak Shutter - Openable window shutters"
		"- Oak Window 2 - Large double window"
		""
		"Different wood types have different colors and textures,"
		"matching any architectural style."
	]
	quest.0000000004000002.quest_subtitle: "Macaw's Windows"
	quest.0000000004000002.title: "Oak Windows"
	quest.0000000004000003.quest_desc: [
		"Try windows in different wood styles!"
		""
		"Birch and spruce are the most common variants."
		"Different woods suit different buildings:"
		"- Birch - Bright modern style"
		"- Spruce - Classic warm style"
	]
	quest.0000000004000003.quest_subtitle: "Different Wood Styles"
	quest.0000000004000003.title: "Window Variants"
	quest.0000000004000004.quest_desc: [
		"Macaw's Doors offers diverse door styles,"
		"far beyond vanilla wooden doors."
		""
		"Main styles:"
		"- Modern Door - Clean lines"
		"- Barn Door - Rustic style"
		"- Classic Door - Traditional design"
		"- Glass Door - Transparent design"
	]
	quest.0000000004000004.quest_subtitle: "Macaw's Doors"
	quest.0000000004000004.title: "Elegant Doors"
	quest.0000000004000005.quest_desc: [
		"Macaw's Fences provides exquisite boundary designs,"
		"far beyond vanilla fences."
		""
		"Fence styles:"
		"- Picket Fence - Classic American style"
		"- Hedge - Natural greenery"
		"- Horse Fence - Pasture style"
		""
		"Mix different materials to create unique boundaries!"
	]
	quest.0000000004000005.quest_subtitle: "Macaw's Fences"
	quest.0000000004000005.title: "Fences and Hedges"
	quest.0000000004000006.quest_desc: [
		"Macaw's Furniture provides a complete furniture set"
		"covering living room, kitchen, study, and bedroom."
		""
		"Basic furniture set:"
		"- Chair + Desk - Study room set"
		"- Wardrobe + Counter - Kitchen set"
		"- Bookshelf - Study decoration"
		"- Wardrobe - Bedroom essential"
	]
	quest.0000000004000006.quest_subtitle: "Macaw's Furniture"
	quest.0000000004000006.title: "Interior Furniture"
	quest.0000000004000007.quest_desc: [
		"Continue expanding your furniture collection!"
		""
		"- Coffee Table - Living room centerpiece"
		"- Drawer - Bedroom storage"
		"- Double Drawer Cabinet - Kitchen upgrade"
	]
	quest.0000000004000007.quest_subtitle: "More Furniture"
	quest.0000000004000007.title: "Tables and Cabinets"
	quest.0000000004000008.quest_desc: [
		"Macaw's Bridges lets you build beautiful bridges!"
		""
		"Bridge types:"
		"- Wood Bridge - Simple and practical"
		"- Rope Bridge - Canyon crossings"
		"- Covered Bridge - Roofed walkway"
		"- Stone Bridge - Sturdy and durable"
	]
	quest.0000000004000008.quest_subtitle: "Macaw's Bridges"
	quest.0000000004000008.title: "Bridge Engineering"
	quest.0000000004000009.quest_desc: [
		"Add decorative details to your windows!"
		""
		"- Louvered Shutters - Adjustable window panels"
		"- Curtain Rods - Pair with curtains"
		"- Glass Windows - Increase natural lighting"
	]
	quest.0000000004000009.quest_subtitle: "Shutters and Curtains"
	quest.0000000004000009.title: "Window Decor"
	quest.0000000004000010.quest_desc: [
		"Experiment with furniture in different wood types."
		"Each wood species has a unique grain pattern."
		""
		"Craft birch and spruce furniture"
		"to enrich your architectural design variety."
	]
	quest.0000000004000010.quest_subtitle: "Diverse Decoration"
	quest.0000000004000010.title: "Furniture Styles"
	quest.0000000004000011.quest_desc: [
		"Create a complete building ensemble,"
		"with indoor and outdoor decoration in harmony."
		""
		"Submit more advanced furniture as proof"
		"of your design capabilities."
	]
	quest.0000000004000011.quest_subtitle: "Outdoor Furniture"
	quest.0000000004000011.title: "Garden Decor"
	quest.0000000004000012.quest_desc: [
		"Integrate all Macaw's elements together"
		"to build a complete structure."
		""
		"Submit core building materials as proof of mastery:"
		"Windows + Doors + Furniture + Bridges"
	]
	quest.0000000004000012.quest_subtitle: "Integrated Building"
	quest.0000000004000012.title: "Building Integration"
	quest.0000000004000013.quest_desc: [
		"Congratulations! You have become a Macaw's Building Master!"
		""
		"You have mastered:"
		"- Multiple window types and shutters"
		"- Modern to classic door designs"
		"- Fence and hedge combinations"
		"- Interior furniture arrangement"
		"- Bridge construction techniques"
		""
		"Use these skills to create"
		"your own unique architectural masterpieces!"
	]
	quest.0000000004000013.quest_subtitle: "Chapter 4 Complete"
	quest.0000000004000013.title: "Building Master Graduation"
	quest.0000000005000001.quest_desc: [
		"BYG (Oh The Biomes We've Gone) adds over 40 new biomes to Minecraft!"
		""
		"From sakura groves to barren badlands, tropical rainforests to frozen tundras"
		"Each biome has unique flora and building material resources"
		""
		"Ready your compass, gear up and set out"
		"This chapter will take you across four climate zones"
		"Temperate, Tropical, Cold, Magical — 22 wood types to collect!"
	]
	quest.0000000005000001.quest_subtitle: "New Era Exploration"
	quest.0000000005000001.title: "New Era Exploration"
	quest.0000000005000002.quest_desc: [
		"BYG adds 22 brand-new wood types"
		"Far surpassing vanilla wood types, offering limitless building possibilities"
		""
		"Aspen is the most common wood in BYG"
		"With its elegant golden-yellow hue and fine grain"
		"Perfect for classical-style architecture"
		""
		"Collect Aspen Logs and craft Aspen Planks"
		"As the first step of your BYG wood journey"
	]
	quest.0000000005000002.quest_subtitle: "BYG Wood Guide"
	quest.0000000005000002.title: "BYG Wood Guide"
	quest.0000000005000003.quest_desc: [
		"The BYG world is home to a vast variety of plants"
		"Each plant is adapted to its native biome"
		""
		"Aloe Vera — grows in arid warm biomes"
		"Allium Flower Bush — the iconic flower of temperate grasslands"
		""
		"These plants are not only beautiful but also food ingredients"
		"Begin your flora collection journey!"
	]
	quest.0000000005000003.quest_subtitle: "BYG Flora Basics"
	quest.0000000005000003.title: "BYG Flora Basics"
	quest.0000000005000004.quest_desc: [
		"BYG not only expands biomes but also brings a unique food system"
		"Use biome plants to create delicious dishes"
		""
		"Aloe Vera Juice — a refreshing desert beverage"
		"Blueberry Pie — a sweet treat from temperate biomes"
		""
		"Gather enough ingredients and taste BYG's unique flavors"
		"Good food is the best comfort on the road of exploration"
	]
	quest.0000000005000004.quest_subtitle: "BYG Culinary Exploration"
	quest.0000000005000004.title: "BYG Culinary Exploration"
	quest.0000000005000005.quest_desc: [
		"BYG biomes hide rich mineral treasures"
		"Rare minerals and unique plants await your discovery"
		""
		"Emeralds — precious minerals in tropical biomes"
		"Diamonds — hidden deep beneath cold biomes"
		"Oddion Bulb — a magical plant from magical biomes"
		""
		"These three resources are spread across different climate zones"
		"Ready your pickaxe and delve deep underground!"
	]
	quest.0000000005000005.quest_subtitle: "BYG Mineral Treasures"
	quest.0000000005000005.title: "BYG Mineral Treasures"
	quest.0000000005000006.quest_desc: [
		"Temperate biomes are the most colorful regions in BYG"
		"Distinct seasonal climates nurture diverse woods and plants"
		""
		"Aspen Forest — golden leaves swaying in the breeze"
		"Maple Forest — picturesque red autumn leaves"
		"Sakura Forest — pink petals falling like snow"
		""
		"Collect Aspen as the beginning of your temperate journey"
		"Many more woods await discovery in the temperate zone"
	]
	quest.0000000005000006.quest_subtitle: "Temperate Biomes"
	quest.0000000005000006.title: "Temperate Biomes"
	quest.0000000005000007.quest_desc: [
		"Aspen is the most representative wood in BYG"
		"Golden wood grain as warm and smooth as jade"
		""
		"Stockpile Aspen logs and planks as building reserves"
		"And collect Aspen saplings for artificial forestry"
		""
		"Aspen Planks are ideal for Nordic-style architecture"
		"Pair with dark woods for stunning contrast effects"
		""
		"A chest full of Aspen — have you done it?"
	]
	quest.0000000005000007.quest_subtitle: "Aspen Depth"
	quest.0000000005000007.title: "Aspen Depth"
	quest.0000000005000008.quest_desc: [
		"Maple is the signature wood of temperate biomes"
		"Reddish-brown wood with a unique warm tone"
		""
		"Maple forests are most spectacular in autumn"
		"Entire forests dyed in flaming red"
		""
		"Collect Maple Logs and Maple Saplings"
		"Plant a maple forest around your base"
		"Feel the natural beauty of the changing seasons"
	]
	quest.0000000005000008.quest_subtitle: "Maple Collection"
	quest.0000000005000008.title: "Maple Collection"
	quest.0000000005000009.quest_desc: [
		"Sakura is the most romantic wood in BYG"
		"Pale pink wood like blooming cherry blossoms"
		""
		"Pink petal particles float through the Sakura biome"
		"One of the most beautiful biomes in the BYG world"
		""
		"Collect Sakura logs and Araucaria saplings"
		"Araucaria is an ancient conifer species"
		"Growing alongside Sakura, creating a unique landscape"
	]
	quest.0000000005000009.quest_subtitle: "Sakura Collection"
	quest.0000000005000009.title: "Sakura Collection"
	quest.0000000005000010.quest_desc: [
		"Pine grows at the border of temperate and cold zones"
		"Dark green needles and thick trunks are highly distinctive"
		""
		"Pine is an excellent material for cabins and resorts"
		"Dark grain brings a sense of stability and nature"
		""
		"Collect Pine Logs and Pine Saplings"
		"Add a new variety to your temperate building material library"
	]
	quest.0000000005000010.quest_subtitle: "Pine Collection"
	quest.0000000005000010.title: "Pine Collection"
	quest.0000000005000011.quest_desc: [
		"Temperate biomes boast the richest plant resources"
		"From low herbs to tall shrubs, everything is here"
		""
		"Aloe Vera — a medicinal plant of temperate dry zones"
		"Alpine Bellflower — the blue sprite of alpine meadows"
		"Angelica — an aromatic herb of moist forests"
		""
		"These three plants are found in different temperate microclimates"
		"Finding them requires traversing every corner of the temperate zone"
	]
	quest.0000000005000011.quest_subtitle: "Temperate Flora"
	quest.0000000005000011.title: "Temperate Flora"
	quest.0000000005000012.quest_desc: [
		"Temperate plants are not just for viewing"
		"They can be crafted into uniquely flavored dishes"
		""
		"Aloe Vera Juice — cool and refreshing"
		"Green Apple Pie — sweet and tangy"
		""
		"Craft these delicacies using temperate biome produce"
		"Don't forget to treat yourself on the journey"
		"Good food is the best energy supply for adventurers"
	]
	quest.0000000005000012.quest_subtitle: "Temperate Cuisine"
	quest.0000000005000012.title: "Temperate Cuisine"
	quest.0000000005000013.quest_desc: [
		"Your pursuit of Maple shouldn't stop here"
		"A true building master needs massive reserves"
		""
		"Collect a full stack of Maple Logs and plenty of saplings"
		"This is not just a test of patience"
		"But proof of deep exploration into temperate biomes"
		""
		"Maple's red grain is the soul of premium architecture"
		"Make it a core material in your building collection"
	]
	quest.0000000005000013.quest_subtitle: "Maple Depth"
	quest.0000000005000013.title: "Maple Depth"
	quest.0000000005000014.quest_desc: [
		"Sakura's romance is worth deep exploration"
		""
		"Stockpile Sakura logs as premium building reserves"
		"And gather plenty of Araucaria saplings"
		"Create a Sakura avenue around your base"
		""
		"Sakura wood is the finishing touch in architecture"
		"Pink wood is very rare, the top choice for luxury decoration"
	]
	quest.0000000005000014.quest_subtitle: "Sakura Depth"
	quest.0000000005000014.title: "Sakura Depth"
	quest.0000000005000015.quest_desc: [
		"Aspen is the most versatile building material in temperate biomes"
		"Now you need industrial-grade reserves"
		""
		"Two stacks of Aspen Logs, two stacks of Aspen Planks"
		"This requires clear-cutting an entire Aspen forest"
		""
		"Enough materials means you can build at any scale"
		"Temperate-style villages, castles, or vacation cabins"
		"Aspen will be your most reliable building material"
	]
	quest.0000000005000015.quest_subtitle: "Aspen Building Materials"
	quest.0000000005000015.title: "Aspen Building Materials"
	quest.0000000005000016.quest_desc: [
		"You have traveled through every corner of temperate biomes"
		"Now it's time to show your true strength"
		""
		"Collect the three great temperate woods: Aspen, Maple, Sakura"
		"At least one full stack of each"
		""
		"This requires traversing Aspen, Maple, and Sakura forests"
		"Proving you have fully conquered temperate biomes"
		"You are a true Temperate Biome Master!"
	]
	quest.0000000005000016.quest_subtitle: "Temperate Biome Master"
	quest.0000000005000016.title: "Temperate Biome Master"
	quest.0000000005000017.quest_desc: [
		"This is the ultimate temperate biome collection challenge"
		"A complete test combining woods and plants"
		""
		"Aloe Vera x32 + Bellflower x16 + Angelica x16 + Aspen Sapling x16"
		"Covering all signature resources of temperate biomes"
		""
		"From plants to wood, from ingredients to building materials"
		"Everything about temperate biomes is now in your grasp"
		"Congratulations on completing the entire temperate zone exploration!"
	]
	quest.0000000005000017.quest_subtitle: "Temperate Complete Collection"
	quest.0000000005000017.title: "Temperate Complete Collection"
	quest.0000000005000018.quest_desc: [
		"Tropical biomes are the most fertile regions in BYG"
		"Hot and rainy climate nurtures lush rainforest vegetation"
		""
		"Palm — the iconic tree of tropical beaches"
		"Mahogany — precious hardwood of the dense jungle"
		"Jacaranda — a dreamy tree with purple blossoms"
		""
		"Tropical biomes also provide ingredients for many foods"
		"The most worthwhile region for adventurers to visit"
	]
	quest.0000000005000018.quest_subtitle: "Tropical Biomes"
	quest.0000000005000018.title: "Tropical Biomes"
	quest.0000000005000019.quest_desc: [
		"Mahogany is a precious wood of tropical biomes"
		"Dark brown grain, stable and noble"
		""
		"In reality, Mahogany is the top choice for fine furniture"
		"In BYG, it holds equally high architectural value"
		""
		"Collect Mahogany Logs and saplings"
		"Add a core species to your tropical building material library"
	]
	quest.0000000005000019.quest_subtitle: "Mahogany Collection"
	quest.0000000005000019.title: "Mahogany Collection"
	quest.0000000005000020.quest_desc: [
		"Palm is the hallmark of tropical coastlines"
		"Tall trunks and fan-shaped fronds are distinctly tropical"
		""
		"Palm wood is a core material for tropical resorts"
		"Paired with Aspen or Sakura for unique visual effects"
		""
		"Collect large quantities of Palm logs and saplings"
		"Create a tropical seaside oasis in your base"
	]
	quest.0000000005000020.quest_subtitle: "Palm Collection"
	quest.0000000005000020.title: "Palm Collection"
	quest.0000000005000021.quest_desc: [
		"Jacaranda is the most beautiful tree in tropical biomes"
		"Blooming purple flowers envelop the crown like mist"
		""
		"Jacaranda wood has light purple grain"
		"The most elegant decorative material in architecture"
		""
		"Collect Jacaranda logs and saplings"
		"Adorn your world with this purple dream"
	]
	quest.0000000005000021.quest_subtitle: "Jacaranda Collection"
	quest.0000000005000021.title: "Jacaranda Collection"
	quest.0000000005000022.quest_desc: [
		"Ironwood is the hardest wood in tropical biomes"
		"Dark gray grain, as tough as iron"
		""
		"Legend says tools made from Ironwood are tougher than iron"
		"Though just a legend, Ironwood's architectural value is unquestionable"
		""
		"Collect Ironwood Logs and saplings"
		"This is proof of deep tropical exploration"
	]
	quest.0000000005000022.quest_subtitle: "Ironwood Collection"
	quest.0000000005000022.title: "Ironwood Collection"
	quest.0000000005000023.quest_desc: [
		"Tropical plants grow with exceptional vigor"
		"Hot and humid conditions create perfect growing environments"
		""
		"Amaranth — a purplish-red plant unique to the tropics"
		"Aloe Vera — a frequent visitor of tropical arid zones"
		"Allium Flower Bush — the purple carpet of tropical savannas"
		""
		"Each plant has a unique appearance and use"
		"Tropical plants are an indispensable page in your flora guide"
	]
	quest.0000000005000023.quest_subtitle: "Tropical Flora"
	quest.0000000005000023.title: "Tropical Flora"
	quest.0000000005000024.quest_desc: [
		"Tropical biomes produce the sweetest food ingredients"
		"Abundant fruits and plants offer limitless culinary possibilities"
		""
		"Blueberry Pie — a sweet gift of tropical berries"
		"Aloe Vera Juice — a cooling desert drink"
		""
		"Tropical cuisine is an energy source for long explorations"
		"And the best gift to share with friends"
	]
	quest.0000000005000024.quest_subtitle: "Tropical Cuisine"
	quest.0000000005000024.title: "Tropical Cuisine"
	quest.0000000005000025.quest_desc: [
		"Mahogany's value is worth deep harvesting"
		"As the noblest wood of tropical biomes"
		"It deserves a full row of space in your warehouse"
		""
		"Collect a full stack of Mahogany Logs"
		"Plus plenty of saplings for artificial planting"
		""
		"Premium wood is the cornerstone of top architecture"
		"Mahogany will be the star of your architectural works"
	]
	quest.0000000005000025.quest_subtitle: "Mahogany Depth"
	quest.0000000005000025.title: "Mahogany Depth"
	quest.0000000005000026.quest_desc: [
		"Jacaranda's purple charm is irresistible"
		"Now is the time for deep collection"
		""
		"A full stack of Jacaranda logs and plenty of saplings"
		"Enabling you to build purple structures at any scale"
		""
		"Jacaranda wood is the finishing touch of tropical architecture"
		"Light up your world with this purple romance"
	]
	quest.0000000005000026.quest_subtitle: "Jacaranda Depth"
	quest.0000000005000026.title: "Jacaranda Depth"
	quest.0000000005000027.quest_desc: [
		"Ironwood's toughness deserves your full effort"
		""
		"Collect Ironwood Logs and saplings"
		"Reserves only achievable by a true tropical hardwood collector"
		""
		"Ironwood represents strength and durability"
		"Buildings made from Ironwood will stand the test of time"
	]
	quest.0000000005000027.quest_subtitle: "Ironwood Depth"
	quest.0000000005000027.title: "Ironwood Depth"
	quest.0000000005000028.quest_desc: [
		"You have mastered all four famed woods of the tropical biome"
		"Now comes the final comprehensive test"
		""
		"Mahogany x64 + Palm x64 + Jacaranda x64"
		"Three tropical woods, one full stack each"
		""
		"This requires penetrating deep into the rainforest"
		"Felling hundreds of precious tropical trees"
		"You are a true Tropical Biome Master!"
	]
	quest.0000000005000028.quest_subtitle: "Tropical Biome Master"
	quest.0000000005000028.title: "Tropical Biome Master"
	quest.0000000005000029.quest_desc: [
		"Cold biomes are covered in blankets of snow"
		"Hardy trees grow in this icy world"
		""
		"Fir — the monarch of cold coniferous forests"
		"Holly — an emerald miracle in the snow"
		"Cypress — the sentinel at the wetland-cold boundary"
		""
		"Cold zone woods feature darker tones"
		"The perfect choice for winter-themed builds"
	]
	quest.0000000005000029.quest_subtitle: "Cold Biomes"
	quest.0000000005000029.title: "Cold Biomes"
	quest.0000000005000030.quest_desc: [
		"Fir is the most important wood resource in cold biomes"
		"Dark green needles and straight trunks are highly distinctive"
		""
		"Collect large quantities of Fir logs and saplings"
		"Fir planks are the classic material for Nordic cabins"
		""
		"Cold zone wood may be hard to harvest"
		"But the architectural payoff is absolutely worth it"
	]
	quest.0000000005000030.quest_subtitle: "Fir Depth"
	quest.0000000005000030.title: "Fir Depth"
	quest.0000000005000031.quest_desc: [
		"Holly is the distinctive wood of cold biomes"
		"Pure white wood like condensed ice and snow"
		""
		"Holly trees bear red berries in winter"
		"Red and white crowns stand out strikingly in the snow"
		""
		"Collect Holly logs and saplings"
		"Holly is an excellent material for white buildings"
	]
	quest.0000000005000031.quest_subtitle: "Holly Collection"
	quest.0000000005000031.title: "Holly Collection"
	quest.0000000005000032.quest_desc: [
		"Cypress grows at the border of cold zones and wetlands"
		"Grayish-brown wood with unique water-adapted grain"
		""
		"In reality, cypress trees can live for thousands of years"
		"In BYG, it carries the same weight of history"
		""
		"Collect Cypress Logs and saplings"
		"Add this ancient species to your cold building material library"
	]
	quest.0000000005000032.quest_subtitle: "Cypress Collection"
	quest.0000000005000032.title: "Cypress Collection"
	quest.0000000005000033.quest_desc: [
		"Even in snow and ice, life blooms"
		"Cold biomes nurture unique cold-resistant plants"
		""
		"Alpine Bellflower — blooming above the snow line"
		"Angelica — an aromatic plant of cold forests"
		"Snowball x32 — a symbol of cold climates"
		""
		"These plants prove life can survive in the harshest environments"
		"Collect them as a tribute to nature"
	]
	quest.0000000005000033.quest_subtitle: "Cold Flora"
	quest.0000000005000033.title: "Cold Flora"
	quest.0000000005000034.quest_desc: [
		"Holly's pure white is worth pursuing deeply"
		"White wood is extremely rare in Minecraft"
		""
		"Collect large quantities of Holly logs and saplings"
		"White building materials will greatly expand your architectural options"
		""
		"Holly is the core material for ice palaces and winter wonderlands"
		"Let the pure white wood adorn your cold zone builds"
	]
	quest.0000000005000034.quest_subtitle: "Holly Depth"
	quest.0000000005000034.title: "Holly Depth"
	quest.0000000005000035.quest_desc: [
		"Fir is the most reliable building material in cold biomes"
		"Now it's time for industrial-scale harvesting"
		""
		"Two stacks of Fir Logs, plus plenty of saplings"
		"This requires clear-cutting a mountain of fir forest"
		""
		"Fir's deep tones form a stunning contrast with white snow"
		"Build your own cozy cabin in the cold zone"
	]
	quest.0000000005000035.quest_subtitle: "Fir Building Materials"
	quest.0000000005000035.title: "Fir Building Materials"
	quest.0000000005000036.quest_desc: [
		"The frozen cold biomes have been fully conquered by you"
		"All three cold wood pillars are essential"
		""
		"Fir x64 + Holly x64 + Cypress x64"
		"Display the collection results of all three cold woods"
		""
		"From coniferous forests to ice plains, wetlands to snowy mountains"
		"You are a true Cold Biome Master!"
		"Not even ice and snow can stop your spirit of exploration"
	]
	quest.0000000005000036.quest_subtitle: "Cold Biome Master"
	quest.0000000005000036.title: "Cold Biome Master"
	quest.0000000005000037.quest_desc: [
		"Magical biomes are the most mysterious corners of the BYG world"
		"Magical energy permeates every plant and every tree"
		""
		"Blue Enchanted Wood — shimmering with magical light"
		"Green Enchanted Wood — the condensation of natural magic"
		"Spirit Wood — a vessel for spirit energy"
		""
		"These woods are not only unique in appearance"
		"But also contain powerful magical energy"
		"Step into magical biomes and feel the power of magic"
	]
	quest.0000000005000037.quest_subtitle: "Magical Biomes"
	quest.0000000005000037.title: "Magical Biomes"
	quest.0000000005000038.quest_desc: [
		"Enchanted woods are the core resources of magical biomes"
		""
		"Green Enchanted Wood — enchanted timber containing nature's power"
		"Ebony — mysterious hardwood, black as ink"
		""
		"These two woods, one light and one dark, create a stunning contrast"
		"Ideal materials for building magic towers and wizard academies"
		""
		"Collect them and begin your magical architectural journey"
	]
	quest.0000000005000038.quest_subtitle: "Enchanted Wood Collection"
	quest.0000000005000038.title: "Enchanted Wood Collection"
	quest.0000000005000039.quest_desc: [
		"Spirit and Skyris"
		"Are the two most unconventional woods in magical biomes"
		""
		"Spirit wood emits a ghostly blue glow"
		"Skyris bears sky-blue grain"
		""
		"These two woods break the color boundaries of traditional wood"
		"Bringing unprecedented visual impact to architecture"
		"The unique charm of magical biomes"
	]
	quest.0000000005000039.quest_subtitle: "Spirit Wood Collection"
	quest.0000000005000039.title: "Spirit Wood Collection"
	quest.0000000005000040.quest_desc: [
		"Enchanted tree saplings are equally precious"
		"Saplings represent life and infinite future possibilities"
		""
		"Blue Enchanted Sapling — blue sprouts shimmering with magical energy"
		"Green Enchanted Sapling — emerald leaves radiating nature's light"
		"Ebony Sapling — dark sprouts holding ancient secrets"
		""
		"Collect these saplings and grow magical trees at your base"
		"Let the shade of magic shelter your home"
	]
	quest.0000000005000040.quest_subtitle: "Enchanted Saplings"
	quest.0000000005000040.title: "Enchanted Saplings"
	quest.0000000005000041.quest_desc: [
		"Spirit and Skyris, two otherworldly woods"
		"Now requiring your deep harvesting"
		""
		"Spirit x64 + Skyris x64 + Spirit Sapling x16"
		"These ghostly blue woods will completely transform your architectural language"
		""
		"Spirit wood emits a faint glow in the dark"
		"Skyris makes buildings appear to float among the clouds"
		"The final wood collection challenge of magical biomes"
	]
	quest.0000000005000041.quest_subtitle: "Spirit Wood Depth"
	quest.0000000005000041.title: "Spirit Wood Depth"
	quest.0000000005000042.quest_desc: [
		"Magical biome plants are equally filled with magical aura"
		""
		"Oddion Bulb — a magical plant emitting a faint glow"
		"Allium Flower Bush x32 — exceptionally lush under magical energy"
		"Amaranth x32 — displaying deeper purple in magical biomes"
		""
		"These plants are precious ingredients for brewing magical potions"
		"And top-tier decorations for magical-style gardening"
	]
	quest.0000000005000042.quest_subtitle: "Magical Flora"
	quest.0000000005000042.title: "Magical Flora"
	quest.0000000005000043.quest_desc: [
		"Deep collection of enchanted woods will test your perseverance"
		""
		"Blue Enchanted x64 + Green Enchanted x64 + Ebony x64"
		"Three magical woods, one full stack each"
		""
		"The perfect combination of blue, green, and black wood"
		"Dream materials for building top-tier magical architecture"
		""
		"Rare woods of magical biomes require patience to find"
		"But the sense of achievement is unmatched"
	]
	quest.0000000005000043.quest_subtitle: "Enchanted Wood Depth"
	quest.0000000005000043.title: "Enchanted Wood Depth"
	quest.0000000005000044.quest_desc: [
		"The ultimate test of magical biomes has arrived"
		"Gathering all magical resources in one place"
		""
		"Blue Enchanted x64 + Ebony x64 + Spirit x64 + Oddion Bulb x16"
		"The perfect fusion of wood and plants"
		""
		"This requires venturing into every corner of magical biomes"
		"From enchanted forests to spirit swamps, enchanted highlands to shadow canyons"
		"You are a true Magical Biome Master!"
	]
	quest.0000000005000044.quest_subtitle: "Magical Biome Master"
	quest.0000000005000044.title: "Magical Biome Master"
	quest.0000000005000045.quest_desc: [
		"You are a true Wood Collector!"
		"You have collected countless woods across four climate zones"
		""
		"Now demonstrate your mastery of all BYG wood species"
		"Collect 10 different saplings, at least one of each:"
		""
		"Aspen, Mahogany, Fir, Blue Enchanted, Palm"
		"Holly, Jacaranda, Maple, Sakura, Ebony"
		""
		"From temperate to tropical, cold to magical"
		"Out of 22 BYG woods, you have mastered 10 core species"
		"Saplings are seeds of future forests and marks of your exploration"
	]
	quest.0000000005000045.quest_subtitle: "Wood Collector"
	quest.0000000005000045.title: "Wood Collector"
	quest.0000000005000046.quest_desc: [
		"The complete collection of the four famed tropical woods"
		"Each log represents exploration into the deep jungle"
		""
		"Mahogany x64 + Palm x64 + Jacaranda x64 + Ironwood x64"
		"Four woods, one full stack each"
		""
		"Palm beaches' tropical charm, Jacaranda's purple romance"
		"Mahogany's noble elegance, Ironwood's indestructibility"
		"All the essence of tropical biomes is in your hands"
	]
	quest.0000000005000046.quest_subtitle: "Tropical Wood Set"
	quest.0000000005000046.title: "Tropical Wood Set"
	quest.0000000005000047.quest_desc: [
		"Four wood pillars in the frozen world"
		"Each one has endured the test of wind and snow"
		""
		"Fir x64 + Holly x64 + Cypress x64 + Pine x64"
		"Four cold woods, one full stack each"
		""
		"Fir's depth, Holly's purity, Cypress's antiquity, Pine's stability"
		"The diversity of cold biomes far exceeds your imagination"
		"Collection complete, the cold biome journey ends perfectly"
	]
	quest.0000000005000047.quest_subtitle: "Cold Wood Set"
	quest.0000000005000047.title: "Cold Wood Set"
	quest.0000000005000048.quest_desc: [
		"Rainbow Eucalyptus is the most colorful wood in BYG"
		"The trunk displays a rainbow-like multicolored grain"
		""
		"In reality, rainbow eucalyptus grows in tropical regions"
		"Bark peels to reveal green, blue, purple, orange, red, and more"
		""
		"BYG faithfully recreates this natural wonder"
		"Collect Rainbow Eucalyptus logs and saplings"
		"The most precious gift of tropical biomes"
	]
	quest.0000000005000048.quest_subtitle: "Rainbow Eucalyptus"
	quest.0000000005000048.title: "Rainbow Eucalyptus"
	quest.0000000005000049.quest_desc: [
		"Redwood is the towering giant of the BYG world"
		"Trees can reach dozens of meters tall with immensely thick trunks"
		""
		"Redwood forests are the most spectacular sight in BYG tropical biomes"
		"Walk among the giant redwoods and feel nature's majesty"
		""
		"Collect Redwood Logs and saplings"
		"Redwood is the core material for mega-builds"
		"And an important milestone in your tropical exploration"
	]
	quest.0000000005000049.quest_subtitle: "Redwood Giants"
	quest.0000000005000049.title: "Redwood Giants"
	quest.0000000005000050.quest_desc: [
		"Baobab is the most unique tree in BYG"
		"Massive trunk and unique shape are highly recognizable"
		""
		"Baobab is known in reality as the \"Tree of Life\""
		"Storing large amounts of water in the arid tropical savanna"
		""
		"Collect Baobab logs and saplings"
		"A rare species among the 22 BYG woods"
		"Adding a bold stroke to your wood collection catalog"
	]
	quest.0000000005000050.quest_subtitle: "All Wood Master"
	quest.0000000005000050.title: "All Wood Master"
	quest.0000000005000051.quest_desc: [
		"Plants from all four climate zones converge here"
		"This is the ultimate flora collection challenge of BYG"
		""
		"Aloe x32 + Allium Bush x32 + Bellflower x32 + Amaranth x32 + Angelica x32 + Oddion Bulb x16"
		"The complete collection of six signature BYG plants"
		""
		"From temperate aloe to magical oddion bulbs"
		"Your footprints cover every corner of the BYG world"
		""
		"The diversity of plants witnesses ecological prosperity"
		"You are a true BYG botanist!"
	]
	quest.0000000005000051.quest_subtitle: "BYG Complete Flora"
	quest.0000000005000051.title: "BYG Complete Flora"
	quest.0000000005000052.quest_desc: [
		"The ultimate fusion challenge of wood and plants"
		"Proving you have traversed every type of biome in BYG"
		""
		"Aspen x64 + Mahogany x64 + Fir x64"
		"Blue Enchanted x64 + Aloe x64 + Amaranth x64"
		""
		"Four climate zones, six signature resources"
		"Each material represents a story of exploration"
		""
		"Temperate elegance, tropical passion, cold resilience, magical mystery"
		"You are a true Biome Collector!"
	]
	quest.0000000005000052.quest_subtitle: "Biome Collector"
	quest.0000000005000052.title: "Biome Collector"
	quest.0000000005000053.quest_desc: [
		"The final wood collection challenge — in the name of building materials"
		"What you need is industrial-grade material reserves"
		""
		"Aspen x128 + Maple x128 + Aspen Planks x128 + Mahogany x128"
		"A terrifying reserve of two stacks each for four woods"
		""
		"This requires felling over a thousand trees"
		"The ultimate test of patience, perseverance, and planning"
		""
		"With these woods, you can build a town of any scale"
		"You are a true Building Materials Master!"
	]
	quest.0000000005000053.quest_subtitle: "Building Materials Master"
	quest.0000000005000053.title: "Building Materials Master"
	quest.0000000005000054.quest_desc: [
		"BYG is not only a holy land for biome exploration"
		"But also a paradise for food lovers"
		""
		"Aloe Juice x16 + Blueberry Pie x16 + Green Apple Pie x16"
		"Allium Oddion Soup x16 + Aloe Vera x64"
		""
		"The complete collection of five BYG foods/ingredients"
		"From thirst-quenching drinks to sweet pastries"
		"From exotic soups to core ingredients"
		""
		"Your kitchen can now host a BYG-themed banquet!"
		"You are a true BYG Culinary Master"
	]
	quest.0000000005000054.quest_subtitle: "Culinary Master"
	quest.0000000005000054.title: "Culinary Master"
	quest.0000000005000055.quest_desc: [
		"Congratulations! You have fully conquered the BYG world"
		"From 22 wood types to all biome plants, from exotic cuisine to building materials master"
		""
		"This is the final graduation ceremony of the BYG chapter"
		"Collect the following materials to prove your footprints cover every inch of land:"
		""
		"Grass Block x64 — You have walked through every BYG biome"
		"Dirt x64 — You have dug through the soil of all climate zones"
		"Aspen Log x64 — The beginning and end of your BYG wood journey"
		"Mahogany x64 — A precious collection from the tropical jungle"
		"Fir x64 — The ultimate proof of cold zone conquest"
		"Aloe Vera x64 — The culmination of all climate zone plants"
		""
		"Oh The Biomes We've Gone — All Conquered!"
		"You are the undisputed BYG World Exploration Master!"
	]
	quest.0000000005000055.quest_subtitle: "BYG World Graduation"
	quest.0000000005000055.title: "BYG World Graduation"
	quest.0000000005000056.quest_desc: ["Collect an Ebony Log."]
	quest.0000000005000056.quest_subtitle: "Ebony Wood"
	quest.0000000005000056.title: "Ebony"
	quest.0000000005000057.quest_desc: ["Collect an Ebony Sapling."]
	quest.0000000005000057.quest_subtitle: "Renewable Ebony"
	quest.0000000005000057.title: "Ebony Sapling"
	quest.0000000005000058.quest_desc: [
		"Collect a Spirit Sapling."
		""
		"One of the rarest saplings in BYG."
	]
	quest.0000000005000058.quest_subtitle: "Spirit Sapling"
	quest.0000000005000058.title: "Spirit"
	quest.0000000005000059.quest_desc: [
		"Congratulations! You have explored the full diversity of BYG."
		""
		"Claim your reward for completing the BYG Biomes  Building chapter."
	]
	quest.0000000005000059.quest_subtitle: "Complete the Chapter"
	quest.0000000005000059.title: "BYG Graduation"
	quest.0000000006000001.quest_desc: [
		"Welcome to the YUNG's Structures exploration chapter!"
		""
		"YUNG's mods enhance vanilla structures."
		"Better Mineshafts creates complex abandoned mine networks."
		"Better Dungeons adds new challenges to dungeons."
		"YUNG's Extras optimizes surface structure generation."
		""
		"This mod does not add new items."
		"All quests are completed by submitting vanilla items."
		"You need to delve underground, explore dungeons, and conquer ruins."
		""
		"Craft a diamond pickaxe and prepare for adventure!"
	]
	quest.0000000006000001.quest_subtitle: "YUNG's Underground"
	quest.0000000006000001.title: "Underground Exploration"
	quest.0000000006000002.quest_desc: [
		"YUNG's Better Mineshafts remasters abandoned mineshafts."
		""
		"Compared to vanilla mineshafts, YUNG's version features:"
		"• Multi-layered intersecting tunnels and complex branches"
		"• Suspended walkways and wooden support structures"
		"• Rich ore veins running throughout"
		"• Minecart systems and transport rail networks"
		""
		"Collect these items to prove you have explored the mineshaft:"
		"• 16 Rails — transport tracks in the mineshaft"
		"• 32 Oak Planks — support wood of the mineshaft"
		"• 8 Cobwebs — spider silk deep in the mineshaft"
		""
		"Beware of cave spiders in the mineshafts!"
	]
	quest.0000000006000002.quest_subtitle: "Abandoned Mineshaft"
	quest.0000000006000002.title: "Abandoned Mineshaft"
	quest.0000000006000003.quest_desc: [
		"YUNG's mineshafts are filled with rich ore veins."
		""
		"Search carefully for minerals exposed on tunnel walls."
		"Different ore resources are distributed across mine levels."
		"Tunnel intersections are often hotspots for ore veins."
		""
		"Collect these common mine ores:"
		"• 32 Coal — basic fuel, found everywhere"
		"• 16 Raw Iron — the most important transition metal"
		"• 8 Raw Gold — precious product of rare veins"
		""
		"Tip: Bring multiple pickaxes, the veins are long!"
	]
	quest.0000000006000003.quest_subtitle: "Ore Veins"
	quest.0000000006000003.title: "Ore Veins"
	quest.0000000006000004.quest_desc: [
		"YUNG's mineshafts preserve complete minecart transport systems."
		""
		"Deep in the mineshafts you will discover:"
		"• Minecarts sitting quietly on the rails"
		"• Chest minecarts containing loot"
		"• Multiple rails intersecting to form transport networks"
		""
		"Collect these items to prove minecart exploration:"
		"• 4 Minecarts — transport vehicles in the mineshaft"
		"• 2 Chest Minecarts — loot-carrying minecarts"
		"• 32 Rails — complete rail network materials"
		""
		"Chest minecarts contain a wide variety of items,"
		"search carefully and don't miss any!"
	]
	quest.0000000006000004.quest_subtitle: "Minecart Treasure"
	quest.0000000006000004.title: "Minecart Treasures"
	quest.0000000006000005.quest_desc: [
		"YUNG's Better Dungeons remasters the dungeon system."
		""
		"YUNG dungeon features:"
		"• Larger and more complex than vanilla dungeons"
		"• More rooms and corridor connections"
		"• Multiple spawner types distributed across different areas"
		"• More treasure chests but greater challenges"
		""
		"First step to finding a dungeon — collect mossy cobblestone."
		"Mossy cobblestone is the signature block of dungeons,"
		"usually appearing on dungeon walls and floors."
		""
		"Submit 16 mossy cobblestone to prove you found the dungeon entrance!"
	]
	quest.0000000006000005.quest_subtitle: "Dungeon Challenge"
	quest.0000000006000005.title: "Dungeon Challenge"
	quest.0000000006000006.quest_desc: [
		"Zombie dungeons are the most common dungeon type."
		""
		"Zombie spawners are typically located in the dungeon center."
		"YUNG dungeons have far more zombies than vanilla,"
		"requiring you to face waves of zombie attacks."
		""
		"Combat strategy:"
		"• Bring enough weapons and food"
		"• Prioritize placing torches on spawners to reduce spawning"
		"• Avoid being surrounded in melee combat"
		"• Shields effectively block zombie damage"
		""
		"Kill 10 zombies and collect 16 rotten flesh,"
		"showing your results from the zombie dungeon!"
	]
	quest.0000000006000006.quest_subtitle: "Zombie Dungeon"
	quest.0000000006000006.title: "Zombie Dungeon"
	quest.0000000006000007.quest_desc: [
		"Skeleton dungeons are nests of ranged attack mobs."
		""
		"Skeleton spawners continuously summon archers,"
		"especially dangerous in YUNG's complex corridors."
		"Multiple skeletons can shoot from different angles."
		""
		"Combat strategy:"
		"• Advance with a shield to effectively block arrows"
		"• Quickly close the distance for melee combat"
		"• Use corners and pillars as cover"
		"• Wear armor with projectile protection"
		""
		"Kill 10 skeletons and collect 16 bones!"
	]
	quest.0000000006000007.quest_subtitle: "Skeleton Dungeon"
	quest.0000000006000007.title: "Skeleton Dungeon"
	quest.0000000006000008.quest_desc: [
		"Spider dungeons are small but dangerous challenges."
		""
		"Spiders can pass through 1-block-wide gaps"
		"and can climb walls, leaving nowhere to hide."
		"YUNG dungeons have fewer spiders but greater threat."
		""
		"Combat strategy:"
		"• Don't get surrounded by spiders, keep moving back"
		"• Spiders attack fast, watch your blocking rhythm"
		"• Cave spiders (blue) inflict poison"
		"• Milk can cure poison status"
		""
		"Kill 5 spiders and collect 16 string!"
	]
	quest.0000000006000008.quest_subtitle: "Spider Dungeon"
	quest.0000000006000008.title: "Spider Dungeon"
	quest.0000000006000009.quest_desc: [
		"You have conquered three dungeons, but a true sweeper never stops!"
		""
		"Now combine all dungeon challenges into one:"
		"• Kill 20 zombies — complete zombie dungeon sweep"
		"• Kill 15 skeletons — skeleton dungeon archery suppression"
		"• Kill 10 spiders — spider dungeon agility hunting"
		"• Collect 32 mossy cobblestone — proof of dungeon building materials"
		""
		"This is a comprehensive test of dungeon combat ability."
		"Complete this quest to prove you have become a true"
		"Dungeon Conqueror!"
		""
		"YUNG's dungeons are far from over,"
		"ancient ruins on the surface await you..."
	]
	quest.0000000006000009.quest_subtitle: "Dungeon Sweeper"
	quest.0000000006000009.title: "Dungeon Sweeper"
	quest.0000000006000010.quest_desc: [
		"YUNG's Extras remasters surface structures like desert temples."
		""
		"Unlike vanilla desert temples, YUNG's version features:"
		"• More complex internal mazes and traps"
		"• Richer loot chests"
		"• Redesigned exterior and structural layers"
		"• Various mechanisms and hidden passages"
		""
		"First collect desert temple building materials:"
		"• 32 Sandstone — the main block of desert temples"
		"• 8 Chiseled Sandstone — decorative carvings of the temple"
		""
		"Head to the desert to find these ancient temples!"
	]
	quest.0000000006000010.quest_subtitle: "Ruin Hunter"
	quest.0000000006000010.title: "Relic Hunter"
	quest.0000000006000011.quest_desc: [
		"YUNG's remastered desert temple — more traps, better treasure!"
		""
		"Signature features of desert temples:"
		"• TNT trap chamber beneath the central hall"
		"• Hidden treasure chests in the four corners"
		"• Altar area decorated with chiseled sandstone"
		"• Possible multi-level basement generation"
		""
		"YUNG version improvements:"
		"• Traps are more complex and varied"
		"• Loot pool greatly expanded"
		"• More explorable rooms added"
		"• Significantly higher golden apple appearance rate"
		""
		"Submit these items to prove you fully explored the desert temple!"
	]
	quest.0000000006000011.quest_subtitle: "Desert Temple"
	quest.0000000006000011.title: "Desert Temple"
	quest.0000000006000012.quest_desc: [
		"YUNG's remastered jungle temple — vine-covered ancient puzzles."
		""
		"Unique mechanics of jungle temples:"
		"• Tripwire hook traps protecting treasure"
		"• Dispensers linked with redstone mechanisms"
		"• Multi-layered structure hidden in dense jungle"
		"• Vine-covered walls and corridors"
		""
		"YUNG version enhances temple exploration:"
		"• More trap mechanisms and puzzle rooms"
		"• Improved mechanism logic is more realistic"
		"• May lead to hidden basements"
		""
		"Collect the three signature items of jungle temples!"
	]
	quest.0000000006000012.quest_subtitle: "Jungle Temple"
	quest.0000000006000012.title: "Jungle Temple"
	quest.0000000006000013.quest_desc: [
		"YUNG's remastered witch hut — mysterious dwelling in the swamp."
		""
		"Witch hut features:"
		"• Unique wooden hut structure in swamp biomes"
		"• Contains a witch and her brewing equipment"
		"• Flower pots may contain planted mushrooms"
		"• Black cats occasionally wander nearby"
		""
		"YUNG version improves the hut design:"
		"• More layered hut structure"
		"• Enhanced eerie atmosphere of the swamp hut"
		"• Hut interior may contain more loot"
		""
		"Kill 3 witches and collect their brewing materials!"
	]
	quest.0000000006000013.quest_subtitle: "Witch Hut"
	quest.0000000006000013.title: "Witch Hut"
	quest.0000000006000014.quest_desc: [
		"YUNG's remastered ocean monument — grand guardian fortress in the deep."
		""
		"Ocean monument structural features:"
		"• Pyramid-shaped prismarine main structure"
		"• Interior filled with maze-like corridors and rooms"
		"• 23 giant prismarine pillars surrounding it"
		"• 8 gold blocks hidden at the top"
		""
		"Guardians and Elder Guardians:"
		"• Guardians shoot laser beams at intruders"
		"• Elder Guardians are the boss-level guardians of the monument"
		"• Both drop prismarine shards and fish"
		"• Mining fatigue is removed after leaving monument range"
		""
		"Kill guardians and elder guardians,"
		"prove you have conquered the deep!"
	]
	quest.0000000006000014.quest_subtitle: "Ocean Monument"
	quest.0000000006000014.title: "Ocean Monument"
	quest.0000000006000015.quest_desc: [
		"You have explored all four YUNG remastered surface structures!"
		""
		"Reviewing your ruin exploration journey:"
		"• Desert Temple — hall of golden apples and TNT"
		"• Jungle Temple — maze of tripwire hooks and vines"
		"• Witch Hut — witch's lair of potions and glowstone"
		"• Ocean Monument — abyss of prismarine and guardians"
		""
		"Now submit symbolic items from these four structures,"
		"4 of each, proving you have traveled the world:"
		"• 4 TNT — desert monument"
		"• 4 Tripwire Hooks — jungle mechanism"
		"• 4 Glowstone Dust — witch magic"
		"• 8 Prismarine Shards — deep sea ruins"
		""
		"The surface has submitted, it's time to return underground!"
	]
	quest.0000000006000015.quest_subtitle: "Surface Ruin Master"
	quest.0000000006000015.title: "Surface Master"
	quest.0000000006000016.quest_desc: [
		"Although the ruins are under control, the underground still holds unknown challenges."
		""
		"YUNG's cave enhancements make the underground more dangerous:"
		"• Cave spiders swarm in the depths of abandoned mines"
		"• Cobweb-filled corners hide treasure"
		"• Spawners continue to produce monsters"
		""
		"Cave spiders are smaller than regular spiders,"
		"appearing blue with a poisonous bite."
		"They usually appear near spider spawners in mineshafts."
		""
		"Kill 5 cave spiders,"
		"collect 16 cobwebs and 1 spawner,"
		"showing you have conquered the deepest caves!"
	]
	quest.0000000006000016.quest_subtitle: "Cave Explorer"
	quest.0000000006000016.title: "Cave Explorer"
	quest.0000000006000017.quest_desc: [
		"YUNG's mineshafts reach the deepest levels of the world."
		"Follow the mine tunnels deeper to find the most precious minerals!"
		""
		"Deep mining targets:"
		"• 8 Diamonds — top-tier gems from the mines"
		"• 4 Ancient Debris — the only source of netherite"
		"• 64 Raw Iron — massive metal resources from the mine"
		""
		"The deeper zones of YUNG's mineshafts have higher ore density."
		"Using Better Mineshafts' mine tunnels this is the best time"
		"to efficiently mine deep-level resources."
		""
		"Diamonds are densest around Y=-54,"
		"ancient debris generates in deep Nether mineshaft levels."
		"Bring an Efficiency-enchanted diamond pickaxe for best results!"
	]
	quest.0000000006000017.quest_subtitle: "Deep Miner"
	quest.0000000006000017.title: "Deep Miner"
	quest.0000000006000018.quest_desc: [
		"🏆 YUNG's Structure Exploration Chapter — Final Trial!"
		""
		"You have conquered every corner of YUNG's remastered world:"
		"• Complex mine tunnels and minecart treasures of abandoned mineshafts"
		"• Monster legions and mossy chambers of the three dungeons"
		"• Ancient mechanisms of desert temples and jungle temples"
		"• Mysterious brewing and swamp magic of witch huts"
		"• Guardians and abyssal mazes of ocean monuments"
		"• Cobweb nests of cave spiders"
		"• Diamonds and ancient debris from the deepest mineshafts"
		""
		"Now submit the ultimate proof of four structure types:"
		"• 64 Mossy Cobblestone — proof of dungeon conquest"
		"• 64 Sandstone — memento of desert ruins"
		"• 32 Prismarine Shards — traces of deep sea conquest"
		"• 64 Rails — glory of mineshaft exploration"
		""
		"You have conquered YUNG's entire structure world!"
		"Underground, desert, jungle, or deep sea,"
		"no secret corner remains untrodden by your feet."
		"You are the true Conqueror of YUNG's!"
	]
	quest.0000000006000018.quest_subtitle: "YUNG's Conqueror"
	quest.0000000006000018.title: "YUNG's Conqueror"
	quest.0000000007000001.quest_desc: [
		"Welcome to the Dimension Journey chapter! Explore all of Minecraft's dimensions:"
		"Nether fortresses, End portals, the Deep Dark, and remastered structures."
		"Get ready for the challenges ahead!"
	]
	quest.0000000007000001.quest_subtitle: "Enter the Unknown"
	quest.0000000007000001.title: "Dimension Exploration"
	quest.0000000007000002.quest_desc: [
		"YUNG's Better Nether Fortresses brings a fresh look to Nether fortresses."
		"Explore the revamped fortresses, collect nether bricks and blaze rods,"
		"and prove you have conquered this land of fire."
	]
	quest.0000000007000002.quest_subtitle: "Conquer the Fortress"
	quest.0000000007000002.title: "Nether Fortress"
	quest.0000000007000003.quest_desc: [
		"Build a blaze farm in the fortress for efficient blaze rod farming."
		"Blaze powder is essential for potion brewing and crafting Eyes of Ender."
	]
	quest.0000000007000003.quest_subtitle: "Harvest Blaze Rods"
	quest.0000000007000003.title: "Blaze Farm"
	quest.0000000007000004.quest_desc: [
		"Wither skeletons lurk in the dark corners of Nether fortresses."
		"Defeat them to collect wither skulls, required for summoning the Wither."
	]
	quest.0000000007000004.quest_subtitle: "Collect Skulls"
	quest.0000000007000004.title: "Wither Skeleton"
	quest.0000000007000005.quest_desc: [
		"Mass-collect resources from the Nether fortress:"
		"Nether bricks for building, nether wart for brewing,"
		"and soul sand for summoning the Wither and crafting soul torches."
	]
	quest.0000000007000005.quest_subtitle: "Gather Nether Materials"
	quest.0000000007000005.title: "Nether Brick Hoard"
	quest.0000000007000006.quest_desc: [
		"Use Eyes of Ender to track down the stronghold."
		"YUNG's Better Strongholds makes strongholds grander,"
		"with complex corridors and hidden rooms."
		"Follow the Eye of Ender to find the portal room."
	]
	quest.0000000007000006.quest_subtitle: "Locate the Portal"
	quest.0000000007000006.title: "Stronghold Search"
	quest.0000000007000007.quest_desc: [
		"Explore every corner of the stronghold."
		"Beware of silverfish ambushes - they lurk in the stone bricks."
		"Collect end stone to prove you have reached the stronghold depths."
	]
	quest.0000000007000007.quest_subtitle: "Navigate the Labyrinth"
	quest.0000000007000007.title: "Stronghold Exploration"
	quest.0000000007000008.quest_desc: [
		"Find the End portal frame, fill each empty frame with an Eye of Ender."
		"There are 12 frames; prepare extra Eyes of Ender just in case."
	]
	quest.0000000007000008.quest_subtitle: "Activate the Gateway"
	quest.0000000007000008.title: "Portal Activation"
	quest.0000000007000009.quest_desc: [
		"Enter the End and face the Ender Dragon!"
		"YUNG's Better End Island makes the main island more spectacular."
		"Destroy the crystals, defeat the dragon, claim its head  egg."
	]
	quest.0000000007000009.quest_subtitle: "Slay the Dragon"
	quest.0000000007000009.title: "End Battle"
	quest.0000000007000010.quest_desc: [
		"Travel through the End Gateway to the outer islands."
		"Explore chorus forests and End cities, collect chorus fruit and purpur."
		"Find shulkers in End cities to obtain shulker shells."
	]
	quest.0000000007000010.quest_subtitle: "Explore End Cities"
	quest.0000000007000010.title: "End Outer Islands"
	quest.0000000007000011.quest_desc: [
		"Repurposed Structures adds diverse variants of vanilla structures."
		"Explore different styles of villages, outposts, and more."
		"Collect signature items from these structures."
	]
	quest.0000000007000011.quest_subtitle: "Discover Modified Dungeons"
	quest.0000000007000011.title: "Repurposed Structures"
	quest.0000000007000012.quest_desc: [
		"Structory and Structurify generate new buildings and ruins."
		"Explore these unique structures; collect iron, lanterns, and cobblestone."
	]
	quest.0000000007000012.quest_subtitle: "Explore Ancient Remnants"
	quest.0000000007000012.title: "Extra Structures"
	quest.0000000007000013.quest_desc: [
		"Your footprints cover the End, remastered, and extra structures."
		"Craft maps, a compass, and a spyglass from collected materials."
		"Become a true adventurer!"
	]
	quest.0000000007000013.quest_subtitle: "Explore All Structures"
	quest.0000000007000013.title: "Structure Explorer"
	quest.0000000007000014.quest_desc: [
		"Deep underground lies the mysterious Deep Dark biome."
		"Sculk blocks here sense sound and vibrations."
		"Collect sculk blocks to prove you have found the Deep Dark."
	]
	quest.0000000007000014.quest_subtitle: "Enter the Darkness"
	quest.0000000007000014.title: "Deep Dark Entry"
	quest.0000000007000015.quest_desc: [
		"Delve deeper into the Deep Dark for sculk materials."
		"The sculk catalyst is the core of the Deep Dark."
		"It turns surrounding blocks into sculk when creatures die nearby."
	]
	quest.0000000007000015.quest_subtitle: "Harness Sculk Power"
	quest.0000000007000015.title: "Sculk Collection"
	quest.0000000007000016.quest_desc: [
		"⚠ Deadly challenge! The Warden is one of MC's most powerful mobs,"
		"with extremely high health and melee damage."
		"Trigger a sculk shrieker three times to summon the Warden."
		"Full netherite gear is highly recommended!"
	]
	quest.0000000007000016.quest_subtitle: "Deadly Encounter"
	quest.0000000007000016.title: "Warden Challenge"
	quest.0000000007000017.quest_desc: [
		"The Deeper Darker mod expands the Deep Dark content,"
		"adding the brand-new Otherside dimension."
		"Collect reinforced deepslate and echo shards from ancient cities."
		"Prepare for the journey to the Otherside."
	]
	quest.0000000007000017.quest_subtitle: "The Deepest Depths"
	quest.0000000007000017.title: "Otherside"
	quest.0000000007000018.quest_desc: [
		"Venture into the Otherside, challenge mightier abyssal creatures."
		"Mass-collect sculk, reinforced deepslate, and echo shards."
		"Prove you have conquered everything in the Otherside."
	]
	quest.0000000007000018.quest_subtitle: "A Mysterious Dimension"
	quest.0000000007000018.title: "Void Master"
	quest.0000000007000019.quest_desc: [
		"You have conquered the Nether, End, and Deep Dark dimensions."
		"Bring together a Nether Star, Dragon Head, and Echo Shards"
		"to symbolize your complete mastery of all dimensions."
	]
	quest.0000000007000019.quest_subtitle: "Milestone Achievement"
	quest.0000000007000019.title: "Dimensional Link"
	quest.0000000007000020.quest_desc: [
		"🎉 Ultimate achievement! You have conquered all MC dimensions!"
		"Craft a netherite block, beacon, and 64 Eyes of Ender."
		"Declare yourself the true Dimension Conqueror!"
		"A feat worthy of a server-wide broadcast!"
	]
	quest.0000000007000020.quest_subtitle: "Master of All Dimensions"
	quest.0000000007000020.title: "Dimension Conqueror"
	quest.0000000008000001.quest_desc: [
		"Welcome to the world of Create!"
		"Andesite Alloy is the most essential base material in Create,"
		"crafted by combining Andesite with Iron Ingots (or Zinc Ingots) in a crafting table."
		"Andesite Casing is the structural foundation for all kinetic devices."
		"Ready to enter the age of steam and gears?"
	]
	quest.0000000008000001.quest_subtitle: "Mechanical Basics"
	quest.0000000008000001.title: "Mechanical Basics"
	quest.0000000008000002.quest_desc: [
		"Andesite Alloy is the "
		"iron"
		" of Create — almost every mechanical component depends on it."
		"Craft by combining Andesite with Iron Ingots (or Zinc Ingots) in a crafting table."
		"Recommended to mass-produce; you will consume large amounts later."
	]
	quest.0000000008000002.quest_subtitle: "Andesite Alloy"
	quest.0000000008000002.title: "Andesite Alloy"
	quest.0000000008000003.quest_desc: [
		"Andesite Casing is the backbone of the power system, encasing shafts and transmitting kinetic energy."
		"Craft Andesite Alloy with Logs in a crafting table to make Andesite Casings."
		"Casings can be placed on shafts, giving them directionality."
	]
	quest.0000000008000003.quest_subtitle: "Casing Crafting"
	quest.0000000008000003.title: "Casing Crafting"
	quest.0000000008000004.quest_desc: [
		"Craft Andesite Alloy into block form for decoration or compact storage."
		"Andesite Alloy Blocks are also used in later advanced component recipes."
	]
	quest.0000000008000004.quest_subtitle: "Alloy Block"
	quest.0000000008000004.title: "Alloy Block"
	quest.0000000008000005.quest_desc: [
		"The Water Wheel is the most basic source of Stress in Create."
		"Place a Water Wheel in flowing water; the water pushes it to generate kinetic energy."
		"Transmit this power to other components via shafts."
		"Water Wheels provide gentle and stable Stress output, ideal for early game."
	]
	quest.0000000008000005.quest_subtitle: "Power Source"
	quest.0000000008000005.title: "Power Source"
	quest.0000000008000006.quest_desc: [
		"The Large Water Wheel is an upgrade — bigger size, stronger Stress output."
		"Crafted from a regular Water Wheel and Logs."
		"A reliable mid-game power option for lines requiring higher Stress."
	]
	quest.0000000008000006.quest_subtitle: "Large Water Wheel"
	quest.0000000008000006.title: "Large Water Wheel"
	quest.0000000008000007.quest_desc: [
		"Shafts are the "
		"veins"
		" of the Create power system, carrying Stress from sources to machines."
		"Cogwheels change transmission direction, essential for complex power networks."
		"Shafts must align with the power source direction; cogwheels handle 90-degree turns."
	]
	quest.0000000008000007.quest_subtitle: "Power Transmission"
	quest.0000000008000007.title: "Power Transmission"
	quest.0000000008000008.quest_desc: [
		"The Gearbox is a central hub of the power system, allowing shafts in four directions."
		"Large and small cogwheels together can change rotation speed ratios."
		"Use gearboxes to build compact and efficient power networks."
	]
	quest.0000000008000008.quest_subtitle: "Gearbox"
	quest.0000000008000008.title: "Gearbox"
	quest.0000000008000009.quest_desc: [
		"The Gearshift switches speeds based on redstone signal, enabling dynamic control."
		"The Clutch is used to connect or disconnect power transmission."
		"These two components are key to achieving automated control."
	]
	quest.0000000008000009.quest_subtitle: "Advanced Transmission"
	quest.0000000008000009.title: "Advanced Transmission"
	quest.0000000008000010.quest_desc: [
		"The Rotation Speed Controller is the ultimate transmission component for precise RPM control."
		"The Sequenced Gearshift provides multi-stage shifting based on redstone strength."
		"Master speed control to run every machine in your production line at peak efficiency."
	]
	quest.0000000008000010.quest_subtitle: "Speed Control"
	quest.0000000008000010.title: "Speed Control"
	quest.0000000008000011.quest_desc: [
		"Belts are the foundation of item transport in Create."
		"Connect two shafts with a Belt to build an item transport line."
		"Chain Conveyors can transport items vertically."
		"Belts automatically pick up dropped items and transport them in the set direction."
	]
	quest.0000000008000011.quest_subtitle: "Belt Network"
	quest.0000000008000011.title: "Belt Network"
	quest.0000000008000012.quest_desc: [
		"The Windmill Bearing is one of the most powerful mid-game power sources."
		"Place the bearing at the center of a rotating structure with Sail Frames to generate massive Stress."
		"More Sail Frames = more Stress output from the windmill."
		"The windmill is a crucial step toward full automation."
	]
	quest.0000000008000012.quest_subtitle: "Windmill Upgrade"
	quest.0000000008000012.title: "Windmill Upgrade"
	quest.0000000008000013.quest_desc: [
		"The Blaze Burner is the core heat source for Steam Engines and Encased Fans."
		"An empty burner must be filled with a Blaze Rod to ignite."
		"Feeding it fuel keeps it burning and generating high heat."
		"Super-heated state (feed Blaze Cake) greatly increases processing speeds."
	]
	quest.0000000008000013.quest_subtitle: "Blaze Burner"
	quest.0000000008000013.title: "Blaze Burner"
	quest.0000000008000014.quest_desc: [
		"The Steam Engine is the most powerful Stress source in Create!"
		"Place the Steam Engine on a Fluid Tank heated by a Blaze Burner below."
		"Supply water and heat; the engine will produce enormous Stress (SU)."
		"A max-level steam boiler can power an entire factory."
	]
	quest.0000000008000014.quest_subtitle: "Steam Engine"
	quest.0000000008000014.title: "Steam Engine"
	quest.0000000008000015.quest_desc: [
		"Blaze Cake is the ultimate fuel that puts Blaze Burners into super-heated mode."
		"In super-heated mode, Encased Fans and Mixers process at greatly increased speeds."
		"Producing Blaze Cake requires a complete automation setup."
		"This is proof that you have mastered advanced power."
	]
	quest.0000000008000015.quest_subtitle: "Ultimate Power"
	quest.0000000008000015.title: "Ultimate Power"
	quest.0000000008000016.quest_desc: [
		"The Millstone is Creates earliest processing device."
		"Place a Millstone on a shaft and supply power to begin grinding."
		"Wheat in a Millstone grinds into Flour — the first step in food processing."
		"Millstones can also crush ores, bone blocks, and many other materials."
	]
	quest.0000000008000016.quest_subtitle: "Millstone Processing"
	quest.0000000008000016.title: "Millstone Processing"
	quest.0000000008000017.quest_desc: [
		"Mix Flour with water using a Mixer to produce Dough."
		"Dough can be baked into Bread in a smoker airflow from an Encased Fan."
		"This is the starting point for Creates automated food production line."
	]
	quest.0000000008000017.quest_subtitle: "Dough Making"
	quest.0000000008000017.title: "Dough Making"
	quest.0000000008000018.quest_desc: [
		"The Encased Fan is Creates multi-purpose processing device."
		"Airflow passing through water/lava/fire performs washing, smelting, or smoking respectively."
		"Iron Sheets are produced by fan-smelting Iron Ingots, used for various mechanical components."
		"Encased Fans enable bulk processing, greatly improving efficiency."
	]
	quest.0000000008000018.quest_subtitle: "Bulk Blasting"
	quest.0000000008000018.title: "Bulk Blasting"
	quest.0000000008000019.quest_desc: [
		"The Mechanical Press compresses items into sheets or blocks."
		"Place Iron Ingots on a belt or depot, press them to produce Iron Sheets."
		"The Press is the core device for sheet production and a prerequisite for Precision Mechanisms."
	]
	quest.0000000008000019.quest_subtitle: "Mechanical Press"
	quest.0000000008000019.title: "Mechanical Press"
	quest.0000000008000020.quest_desc: [
		"Golden Sheets are important materials for advanced mechanical components."
		"Press Gold Ingots through a Mechanical Press to obtain Golden Sheets."
		"Golden Sheets are used for Precision Mechanisms, Electron Tubes, and other advanced parts."
	]
	quest.0000000008000020.quest_subtitle: "Golden Sheets"
	quest.0000000008000020.title: "Golden Sheets"
	quest.0000000008000021.quest_desc: [
		"Copper Sheets are used for Copper Casings and fluid pipes."
		"Zinc Ingots are the key ingredient for Brass — Brass = Copper + Zinc."
		"Stockpile plenty of Copper Sheets and Zinc Ingots to prepare for the Brass age."
	]
	quest.0000000008000021.quest_subtitle: "Copper  Zinc"
	quest.0000000008000021.title: "Copper  Zinc"
	quest.0000000008000022.quest_desc: [
		"Zinc is a new ore added by Create, found widely underground."
		"Mine Zinc Ore for Raw Zinc, smelt it into Zinc Ingots."
		"Zinc Ingots are essential for Brass — no Zinc means no Brass age!"
	]
	quest.0000000008000022.quest_subtitle: "Zinc Mining"
	quest.0000000008000022.title: "Zinc Mining"
	quest.0000000008000023.quest_desc: [
		"Craft Zinc Ingots into block form for decoration or compact storage."
		"Raw Zinc Blocks are the compressed form of Raw Zinc."
		"Zinc Blocks also make for a decent decorative building material."
	]
	quest.0000000008000023.quest_subtitle: "Zinc Blocks"
	quest.0000000008000023.title: "Zinc Blocks"
	quest.0000000008000024.quest_desc: [
		"The Mechanical Mixer is one of the most essential processing devices in Create."
		"Place a Mixer above a Basin and supply power to mix items."
		"The Mixer is the automated way to craft Andesite Alloy and Brass."
		"Mastering the Mixer means mastering the key to full automation."
	]
	quest.0000000008000024.quest_subtitle: "Mechanical Mixer"
	quest.0000000008000024.title: "Mechanical Mixer"
	quest.0000000008000025.quest_desc: [
		"Brass is Creates advanced material, marking entry into the high-level mechanical age."
		"Mix Copper Ingots and Zinc Ingots in a Mixer (with heat) to produce Brass Ingots."
		"Brass is essential for Precision Mechanisms, Brass Casings, and advanced logistics components."
		"Stockpile plenty of Brass — it is the foundation of your factory empire."
	]
	quest.0000000008000025.quest_subtitle: "Brass Smelting"
	quest.0000000008000025.title: "Brass Smelting"
	quest.0000000008000026.quest_desc: [
		"Brass Casings are the framework for advanced machines, stronger and more refined than Andesite."
		"Craft Brass Ingots with Logs in a crafting table."
		"Brass Casings are used for Funnels, Tunnels, and Railway Casings."
	]
	quest.0000000008000026.quest_subtitle: "Brass Casing"
	quest.0000000008000026.title: "Brass Casing"
	quest.0000000008000027.quest_desc: [
		"The Brass Funnel is Creates most powerful logistics component, supporting filtered item transfer."
		"Brass Tunnels split item flows, distributing items by category."
		"Funnels with belts enable precise input/output control."
	]
	quest.0000000008000027.quest_subtitle: "Brass Funnel"
	quest.0000000008000027.title: "Brass Funnel"
	quest.0000000008000028.quest_desc: [
		"The Andesite Funnel is a basic early-game logistics component, similar to vanilla hoppers."
		"Andesite Tunnels are used for simple item splitting."
		"Before the Brass age, Andesite Funnels are the workhorses of automated logistics."
	]
	quest.0000000008000028.quest_subtitle: "Andesite Funnel"
	quest.0000000008000028.title: "Andesite Funnel"
	quest.0000000008000029.quest_desc: [
		"The Precision Mechanism is Creates ultimate crafting material."
		"Assemble Golden Sheets, a Gearbox, Iron Ingots, and a Large Cogwheel on a crafting table (or auto-crafter)."
		"The crafting process is complex, requiring belts to deliver items in sequence to specific positions."
		"Precision Mechanisms are the key to unlocking Mechanical Drills, Mechanical Arms, and other advanced machines."
	]
	quest.0000000008000029.quest_subtitle: "Precision Mechanism"
	quest.0000000008000029.title: "Precision Mechanism"
	quest.0000000008000030.quest_desc: [
		"The Mechanical Drill is Creates automated mining device."
		"Placed on moving structures (Mechanical Piston or Minecart Contraption), it automatically breaks blocks."
		"Combined with Mechanical Bearings, it enables large-scale automated mining."
	]
	quest.0000000008000030.quest_subtitle: "Mechanical Drill"
	quest.0000000008000030.title: "Mechanical Drill"
	quest.0000000008000031.quest_desc: [
		"The Mechanical Harvester automatically harvests mature crops for fully automated farming."
		"The Mechanical Saw cuts trees and processes planks — the core of automated forestry."
		"Both can be mounted on moving structures for large-scale operations."
	]
	quest.0000000008000031.quest_subtitle: "Harvest  Saw"
	quest.0000000008000031.title: "Harvest  Saw"
	quest.0000000008000032.quest_desc: [
		"The Mechanical Plough auto-tills soil — pair with Harvesters for fully automated farms."
		"The Mechanical Roller crushes items and blocks, making Iron Sheets or flattening paths."
		"Both are powerful tools on moving structures."
	]
	quest.0000000008000032.quest_subtitle: "Plough  Roller"
	quest.0000000008000032.title: "Plough  Roller"
	quest.0000000008000033.quest_desc: [
		"Copper Casings are used for fluid pipes, Steam Engines, and other fluid-related devices."
		"Craft Copper Sheets with Logs in a crafting table."
		"Copper Casings are indispensable in fluid systems."
	]
	quest.0000000008000033.quest_subtitle: "Copper Casing"
	quest.0000000008000033.title: "Copper Casing"
	quest.0000000008000034.quest_desc: [
		"Chutes are pipes that use gravity to transport items vertically."
		"Smart Chutes filter items by condition, like a vertical version of the Brass Funnel."
		"Chutes + Belts = a complete 3D logistics network."
	]
	quest.0000000008000034.quest_subtitle: "Chute System"
	quest.0000000008000034.title: "Chute System"
	quest.0000000008000035.quest_desc: [
		"The Deployer uses the item in its hand on the block or entity in front of it."
		"It can right-click interact, place blocks, use tools — essentially a mechanized player right-click."
		"Alongside belts, the Deployer is the core of Precision Mechanism automation."
	]
	quest.0000000008000035.quest_subtitle: "Deployer"
	quest.0000000008000035.title: "Deployer"
	quest.0000000008000036.quest_desc: [
		"The Mechanical Arm is Creates ultimate logistics component."
		"It can pick up items from any location and precisely place them at a target."
		"Set input and output points; the arm handles item transfer automatically."
		"An indispensable intelligent logistics hub in complex factory lines."
	]
	quest.0000000008000036.quest_subtitle: "Mechanical Arm"
	quest.0000000008000036.title: "Mechanical Arm"
	quest.0000000008000037.quest_desc: [
		"The Crushing Wheel is the core ore-processing device — a pair crushes ores for increased yield."
		"Raw Iron crushed into Crushed Iron Ore smelts 1:1 into Iron Ingots."
		"This is the key technology for ore multiplication."
	]
	quest.0000000008000037.quest_subtitle: "Crushing Wheel"
	quest.0000000008000037.title: "Crushing Wheel"
	quest.0000000008000038.quest_desc: [
		"Verify the crushing wheels yield multiplication on various ores."
		"Crush Gold, Copper, and Zinc ore to prove your ore processing line is fully operational."
		"Each crushed ore smelts 1:1 into its respective metal ingot."
	]
	quest.0000000008000038.quest_subtitle: "Ore Doubling"
	quest.0000000008000038.title: "Ore Doubling"
	quest.0000000008000039.quest_desc: [
		"Fluid Pipes are Creates liquid transport network."
		"The Mechanical Pump extracts and transports fluids."
		"Build a fluid pipe network to transport water, lava, and other liquids where needed."
	]
	quest.0000000008000039.quest_subtitle: "Fluid System"
	quest.0000000008000039.title: "Fluid System"
	quest.0000000008000040.quest_desc: [
		"The Hose Pulley can draw fluids from infinite water sources or large fluid pools."
		"The Spout injects fluids into Basins for automated fluid mixing."
		"Fluid Valves control the flow in fluid networks."
		"A full fluid setup enables fully automated fluid processing in your factory."
	]
	quest.0000000008000040.quest_subtitle: "Hose  Spout"
	quest.0000000008000040.title: "Hose  Spout"
	quest.0000000008000041.quest_desc: [
		"Fluid Tanks are Creates liquid storage containers."
		"Multiple tanks can be stacked and connected to form large tank arrays."
		"Steam Engines must be placed on top of Fluid Tanks to function."
		"Stockpile enough Fluid Tanks to prepare for steam power."
	]
	quest.0000000008000041.quest_subtitle: "Fluid Tanks"
	quest.0000000008000041.title: "Fluid Tanks"
	quest.0000000008000042.quest_desc: [
		"The Item Vault is Creates high-capacity storage container."
		"A single vault stores vast quantities of items; multiple can be stacked."
		"Paired with Portable Storage Interfaces, cross-dimensional item transfer is possible!"
	]
	quest.0000000008000042.quest_subtitle: "Item Vault"
	quest.0000000008000042.title: "Item Vault"
	quest.0000000008000043.quest_desc: [
		"Portable Storage Interfaces allow moving structures (like minecart contraptions) to exchange items with stationary containers."
		"Portable Fluid Interfaces exchange fluids between moving structures and stationary tanks."
		"This is the core technology for automated minecart loading and unloading."
	]
	quest.0000000008000043.quest_subtitle: "Storage Interface"
	quest.0000000008000043.title: "Storage Interface"
	quest.0000000008000044.quest_desc: [
		"The Mechanical Piston pushes attached blocks back and forth for linear motion."
		"The Sticky Mechanical Piston can push and pull blocks (similar to sticky pistons)."
		"Mechanical Pistons are the foundation for building moving structures (drills, harvesters)."
	]
	quest.0000000008000044.quest_subtitle: "Mechanical Piston"
	quest.0000000008000044.title: "Mechanical Piston"
	quest.0000000008000045.quest_desc: [
		"The Gantry Shaft is a shaft that moves structures along a track."
		"The Gantry Carriage attaches to the gantry shaft and carries the moving structure."
		"Used to build large cranes, moving platforms, and other engineering devices."
	]
	quest.0000000008000045.quest_subtitle: "Gantry Crane"
	quest.0000000008000045.title: "Gantry Crane"
	quest.0000000008000046.quest_desc: [
		"Combine Mechanical Arms and Deployers to build a complete automated assembly line."
		"Mechanical Arms handle item transport; Deployers handle precise operations."
		"Together they can automate complex recipes like Precision Mechanisms and Brass."
		"This is the milestone where your factory moves toward full automation."
	]
	quest.0000000008000046.quest_subtitle: "Automation Workshop"
	quest.0000000008000046.title: "Automation Workshop"
	quest.0000000008000047.quest_desc: [
		"Combine Smart Chutes, Brass Funnels, and Item Vaults to build a complete auto-sorting storage system."
		"Smart Chutes handle intelligent vertical item transport."
		"Brass Funnels handle precise horizontal item filtering."
		"Item Vaults provide massive storage capacity."
		"Master these three components to truly master Create logistics."
	]
	quest.0000000008000047.quest_subtitle: "Logistics Master"
	quest.0000000008000047.title: "Logistics Master"
	quest.0000000008000048.quest_desc: [
		"The Create Railway System is a complete upgrade over vanilla rails!"
		"Regular Tracks lay the railway; Controller Rails enable automatic direction switching."
		"Train Doors and Trapdoors make your trains fully functional."
		"Railways connect factory zones, enabling long-distance transport."
	]
	quest.0000000008000048.quest_subtitle: "Railway System"
	quest.0000000008000048.title: "Railway System"
	quest.0000000008000049.quest_desc: [
		"The Station is the stopping and dispatching center for trains."
		"The Signal system controls train movement and stops."
		"Track Observers detect train passage status."
		"Build a complete railway dispatch network for multi-train automation."
	]
	quest.0000000008000049.quest_subtitle: "Train Station"
	quest.0000000008000049.title: "Train Station"
	quest.0000000008000050.quest_desc: [
		"The Schematic System lets you save, copy, and build complex structures."
		"The Schematic Table saves/edits schematics; the Schematic and Quill records structure data."
		"The Schematicannon automatically places blocks according to a schematic!"
		"Empty Schematics and Schematics are the media for recording and storing structure data."
		"Master the Schematic system and large factory construction becomes twice as efficient."
	]
	quest.0000000008000050.quest_subtitle: "Schematic System"
	quest.0000000008000050.title: "Schematic System"
	quest.0000000008000051.quest_desc: [
		"The Wrench rotates and dismantles Create mechanical components (Sneak + Right-click)."
		"Engineers Goggles display Stress values and RPM of the component you are looking at."
		"The Speedometer measures shaft rotation speed."
		"The Stressometer measures Stress consumption and remaining capacity in the power network."
		"These tools are essential diagnostic equipment for every mechanic."
	]
	quest.0000000008000051.quest_subtitle: "Engineer Tools"
	quest.0000000008000051.title: "Engineer Tools"
	quest.0000000008000052.quest_desc: [
		"The Brass Hand is Creates remote operation tool for interacting with components from a distance."
		"The Extendo Grip extends your reach, making it easier to operate large machines."
		"Builders Tea provides a brief Saturation effect — the perfect companion for factory work."
	]
	quest.0000000008000052.quest_subtitle: "Brass Equipment"
	quest.0000000008000052.title: "Brass Equipment"
	quest.0000000008000053.quest_desc: [
		"Final test: Prove your factory is capable of mass production."
		"Mass-produce Brass Ingots and Precision Mechanisms — the hallmark of advanced automation."
		"Stockpile Andesite and Brass Casings so you are ready for any project."
		"Pass this validation to truly earn the title of "
		"Engineer"
		"."
	]
	quest.0000000008000053.quest_subtitle: "Factory Validation"
	quest.0000000008000053.title: "Factory Validation"
	quest.0000000008000054.quest_desc: [
		"The Netherite Backtank is Creates top-tier equipment — it stores compressed air."
		"The Copper Backtank is an affordable alternative."
		"Backtanks provide compressed air for diving, elytra flight, and potato cannons."
		"Wear it and become the coolest engineer in the factory."
	]
	quest.0000000008000054.quest_subtitle: "Ultimate Gear"
	quest.0000000008000054.title: "Ultimate Gear"
	quest.0000000008000055.quest_desc: [
		"From waterwheels to fully automated factories, you have mastered all of Create."
		"Mass-produce Brass Blocks, Precision Mechanisms, Andesite Alloy Blocks, and Rose Quartz Blocks."
		"You are a true master engineer — the worlds resources are at your command."
		"Congratulations on graduating! But this is only the beginning — what miracles will you create next?"
	]
	quest.0000000008000055.quest_subtitle: "Graduation: Master Engineer"
	quest.0000000008000055.title: "Graduation: Master Engineer"
	quest.0000000009000001.quest_desc: [
		"Iron's Spellbooks"
		"is the core magic mod in this pack"
		"providing a complete magic system with six schools"
		""
		"Arcane Ingots are the foundation of all magic"
		"Collect Arcane Debris and Arcane Essence"
		"Smelt them in a furnace into Arcane Ingots"
		""
		"From this moment on, step into the world of magic!"
	]
	quest.0000000009000001.quest_subtitle: "Intro to Irons Spellbooks"
	quest.0000000009000001.title: "Age of Magic"
	quest.0000000009000002.quest_desc: [
		"Arcane Debris is the most basic magical ore in ISB"
		"buried deep underground in ore veins"
		""
		"Appears as a light blue crystalline ore"
		"Mining it drops Arcane Debris directly"
		""
		"Together with Arcane Essence"
		"it is the key ingredient for forging Arcane Ingots"
		""
		"Mine plenty to stockpile resources for your magical journey!"
	]
	quest.0000000009000002.quest_subtitle: "Basic Magic Ore"
	quest.0000000009000002.title: "Arcane Debris"
	quest.0000000009000003.quest_desc: [
		"Arcane Essence is concentrated magical energy"
		"refined further from Arcane Debris"
		""
		"Extremely versatile uses:"
		"• Crafting Arcane Ingots"
		"• Making Arcane Runes"
		"• Base material for various magical items"
		""
		"Recommended to stockpile heavily"
		"High-level magical items demand vast quantities!"
	]
	quest.0000000009000003.quest_subtitle: "Magical Energy Crystal"
	quest.0000000009000003.title: "Arcane Essence"
	quest.0000000009000004.quest_desc: [
		"Arcane Ingots are the core material for all magical equipment"
		"from spellcasting items to armor, everything needs them"
		""
		"Combine Arcane Debris and Arcane Essence"
		"in a furnace to smelt Arcane Ingots"
		""
		"Early game: aim to stockpile at least one stack"
		"to build a solid resource foundation for"
		"future spell books and equipment forging"
	]
	quest.0000000009000004.quest_subtitle: "Magical Metal Industrialization"
	quest.0000000009000004.title: "Arcane Ingot Production"
	quest.0000000009000005.quest_desc: [
		"The Arcane Anvil is ISBs most essential work block"
		"Almost all advanced magical equipment must be forged on it"
		""
		"Main functions:"
		"• Craft advanced spell books"
		"• Upgrade and enhance spell books"
		"• Forge staves and magical weapons"
		"• Craft affinity rings"
		""
		"Place it in your base"
		"and unlock the infinite possibilities of magical forging!"
	]
	quest.0000000009000005.quest_subtitle: "Spell Forging Core"
	quest.0000000009000005.title: "Arcane Anvil"
	quest.0000000009000006.quest_desc: [
		"The Alchemist Cauldron is ISBs new brewing apparatus"
		"More flexible and efficient than the traditional Brewing Stand"
		""
		"Features  advantages:"
		"• No Blaze Powder fuel needed"
		"• Mix multiple magical ingredients simultaneously"
		"• Produce special magical potions"
		"• Supports exclusive recipe reactions"
		""
		"Drop ingredients directly into the cauldron"
		"and wait for the reaction to complete to obtain potions!"
	]
	quest.0000000009000006.quest_subtitle: "Magical Potion Brewing"
	quest.0000000009000006.title: "Alchemist Cauldron"
	quest.0000000009000007.quest_desc: [
		"The Iron Spell Book is your first step into the world of magic"
		""
		"Place the spell book in your offhand slot"
		"Right-click with a wand or empty hand in your main hand to cast"
		""
		"Right-click to open the spell book GUI"
		"Drag spell scrolls into slots to equip spells"
		""
		"Once you equip a spell book"
		"the gates to all six magical schools will open for you!"
	]
	quest.0000000009000007.quest_subtitle: "Entry to Magic"
	quest.0000000009000007.title: "Iron Spell Book"
	quest.0000000009000008.quest_desc: [
		"Arcane Runes are the core material for all spell books"
		"and the foundation of all school runes"
		""
		"Blank Runes are the base plates for inscribing school runes"
		"Perform rune inscription on the Arcane Anvil"
		""
		"All six school spell books"
		"require large quantities of Arcane Runes as a base"
		""
		"Prepare your runes and get ready to explore all magical schools!"
	]
	quest.0000000009000008.quest_subtitle: "School Spell Book Core"
	quest.0000000009000008.title: "Arcane Runes"
	quest.0000000009000009.quest_desc: [
		"Ink is an important material for spell book inscription"
		"used to engrave spells onto spell books"
		""
		"Ink tier determines the spell level that can be inscribed"
		"Common Ink — Basic spells"
		"Uncommon Ink — Advanced spells"
		""
		"Higher-tier inks can be synthesized in the Alchemist Cauldron"
		"Collecting basic inks is the priority for Phase One"
	]
	quest.0000000009000009.quest_subtitle: "Spell Inscription Ink"
	quest.0000000009000009.title: "Basic Inks"
	quest.0000000009000010.quest_desc: [
		"Arcane Recycling is an important magical technique"
		"that can dismantle unwanted spell scrolls"
		""
		"Using Arcane Recycling"
		"revert discarded scrolls back into base magical materials"
		"achieving sustainable recycling of magical resources"
		""
		"This is an essential frugality technique for any mage"
		"Maximize your material utilization efficiency!"
	]
	quest.0000000009000010.quest_subtitle: "Dismantling  Reusing Spells"
	quest.0000000009000010.title: "Scroll Recycling"
	quest.0000000009000011.quest_desc: [
		"Ancient Knowledge Fragments contain lost magical wisdom"
		"and are key items for enhancing spell abilities"
		""
		"They can be found in chests throughout the world"
		"or by searching magical ruins"
		""
		"Collect enough Ancient Knowledge"
		"to unlock higher-tier magical abilities"
		"and advance further along the path of magical cultivation"
	]
	quest.0000000009000011.quest_subtitle: "Lost Magical Fragments"
	quest.0000000009000011.title: "Ancient Knowledge"
	quest.0000000009000012.quest_desc: [
		"Advanced inks let you inscribe more powerful spells"
		"gradually unlocking powerful skills across all schools"
		""
		"Rare Ink — Mid-tier spell inscription"
		"Epic Ink — High-tier spell inscription"
		""
		"In the Alchemist Cauldron"
		"synthesize lower-tier inks into higher-tier ones step by step"
		"Progress layer by layer to unlock the deeper power of magic!"
	]
	quest.0000000009000012.quest_subtitle: "Advanced Spell Inscription"
	quest.0000000009000012.title: "Advanced Inks"
	quest.0000000009000013.quest_desc: [
		"Legendary Ink is the highest-tier inscription material"
		"used to engrave legendary-tier spells"
		""
		"This ink contains immense magical energy"
		"allowing your spell book to unleash its true power"
		""
		"Only the most elite mages"
		"are worthy of using Legendary Ink to inscribe ultimate spells!"
	]
	quest.0000000009000013.quest_subtitle: "Ultimate Spell Engraving"
	quest.0000000009000013.title: "Legendary Ink"
	quest.0000000009000014.quest_desc: [
		"Protection Runes and Cooldown Runes are important auxiliary runes"
		"providing extra traits to magical equipment and spell books"
		""
		"Protection Rune — Inscribed on armor"
		"grants magical damage reduction"
		""
		"Cooldown Rune — Inscribed on spell books"
		"shortens spell cooldown times"
		""
		"Balance offense and defense to stand undefeated!"
	]
	quest.0000000009000014.quest_subtitle: "Defensive Rune Inscription"
	quest.0000000009000014.title: "Protection Secrets"
	quest.0000000009000015.quest_desc: [
		"Fire School — The power of flames, explosions, and destruction"
		""
		"The Blaze Spell Book is the Fire Schools exclusive spell book"
		"focused on high fire damage output"
		""
		"Fire school signature spells:"
		"• Fireball — Launches a burning fireball"
		"• Blaze Storm — Area persistent burning"
		"• Fire Wave — Fan-shaped flame blast"
		""
		"Master the flames and incinerate all enemies!"
	]
	quest.0000000009000015.quest_subtitle: "Fire, Explosions  Destruction"
	quest.0000000009000015.title: "Fire School"
	quest.0000000009000016.quest_desc: [
		"Fire Runes contain the energy of flames"
		"and are the core material for Fire School spell books"
		""
		"On the Arcane Anvil"
		"inscribe Blank Runes with fire-related materials"
		"to obtain Fire Runes"
		""
		"A sufficient stockpile of Fire Runes"
		"is the prerequisite for in-depth fire magic study"
	]
	quest.0000000009000016.quest_subtitle: "Fire School Inscription"
	quest.0000000009000016.title: "Fire Runes"
	quest.0000000009000017.quest_desc: [
		"The Fire Affinity Ring is an important accessory for fire mages"
		"Wearing it resonates with the power of fire"
		""
		"Effects:"
		"• Reduces fire spell mana cost"
		"• Increases fire spell damage output"
		""
		"Followers of the flame"
		"wear this scorching power upon your finger!"
	]
	quest.0000000009000017.quest_subtitle: "Proof of Fire Affinity"
	quest.0000000009000017.title: "Fire Affinity Ring"
	quest.0000000009000018.quest_desc: [
		"Infernal Sorcerer Armor and Paladin Armor"
		"are the battle gear for Fire School mages"
		""
		"Infernal Sorcerer Chestplate — Focused on fire damage bonus"
		"Paladin Chestplate — Focused on fire spell defense"
		""
		"Choose based on your combat style"
		"and pick the right fire armor for you!"
	]
	quest.0000000009000018.quest_subtitle: "Fire School Battle Robes"
	quest.0000000009000018.title: "Infernal Armor"
	quest.0000000009000019.quest_desc: [
		"The Pyrium Staff is the Fire Schools exclusive weapon"
		"forged from nether materials and Arcane Ingots"
		""
		"Wielding the Pyrium Staff"
		"greatly amplifies the power of fire spells"
		""
		"Turning every fireball you cast"
		"into a meteor of destruction!"
	]
	quest.0000000009000019.quest_subtitle: "Fire Mages Staff"
	quest.0000000009000019.title: "Fire Weapons"
	quest.0000000009000020.quest_desc: [
		"Ice School — The art of freezing, slowing, and controlling"
		""
		"The Ice Spell Book is the Ice Schools exclusive spell book"
		"specializing in battlefield control and restricting enemy movement"
		""
		"Ice school signature spells:"
		"• Ice Shard — Fan-shaped ice spike scatter"
		"• Frost Nova — Area frost explosion"
		"• Ice Wall — Creates an ice wall barrier"
		""
		"Freeze everything and dominate the battlefield!"
	]
	quest.0000000009000020.quest_subtitle: "Freeze, Slow  Control"
	quest.0000000009000020.title: "Ice School"
	quest.0000000009000021.quest_desc: [
		"Ice Runes contain the energy of frost"
		"and are the core material for Ice School spell books"
		""
		"On the Arcane Anvil"
		"inscribe Blank Runes with frost-related materials"
		"to obtain Ice Runes"
		""
		"Each Ice Rune"
		"radiates bone-chilling cold"
	]
	quest.0000000009000021.quest_subtitle: "Frost School Inscription"
	quest.0000000009000021.title: "Ice Runes"
	quest.0000000009000022.quest_desc: [
		"The Frost Affinity Ring is an important accessory for ice mages"
		"Wearing it resonates with the power of ice and snow"
		""
		"Effects:"
		"• Reduces ice spell mana cost"
		"• Enhances slow and freeze effects"
		""
		"Masters of frost"
		"wear this wintry power upon your finger!"
	]
	quest.0000000009000022.quest_subtitle: "Proof of Frost Affinity"
	quest.0000000009000022.title: "Ice Affinity Ring"
	quest.0000000009000023.quest_desc: [
		"Cryomancer Armor is the Ice Schools full combat set"
		"including Helmet, Chestplate, Leggings, and Boots"
		""
		"Full set bonuses:"
		"• Greatly increases ice spell damage"
		"• Increases frost resistance"
		"• Immunity to freeze effects"
		""
		"Collect all four pieces"
		"and become the immortal Frost King!"
	]
	quest.0000000009000023.quest_subtitle: "Ice School Full Set"
	quest.0000000009000023.title: "Cryomancer Armor"
	quest.0000000009000024.quest_desc: [
		"The Ice Staff is the Ice Schools exclusive weapon"
		"forged from ice crystal materials and Arcane Ingots"
		""
		"Wielding the Ice Staff"
		"grants bonus effects to all ice spells"
		""
		"Swing it to summon winter blizzards"
		"and freeze enemies in eternal ice!"
	]
	quest.0000000009000024.quest_subtitle: "Frost Mages Staff"
	quest.0000000009000024.title: "Ice Weapons"
	quest.0000000009000025.quest_desc: [
		"Lightning School — The embodiment of lightning, chaining, and speed"
		""
		"The Copper Spell Book is the Lightning Schools exclusive spell book"
		"known for high speed and chain attacks"
		""
		"Lightning school signature spells:"
		"• Lightning Bolt — Single-target piercing shock"
		"• Chain Lightning — Bouncing chain attack"
		"• Thunder Strike — Summons a lightning strike from above"
		""
		"Command the storm and crush enemies with overwhelming force!"
	]
	quest.0000000009000025.quest_subtitle: "Lightning, Chain  Speed"
	quest.0000000009000025.title: "Lightning School"
	quest.0000000009000026.quest_desc: [
		"Lightning Runes contain the energy of lightning"
		"and are the core material for Lightning School spell books"
		""
		"On the Arcane Anvil"
		"inscribe Blank Runes with lightning-related materials"
		"to obtain Lightning Runes"
		""
		"Each rune crackles and sparks"
		"radiating a dazzling glow!"
	]
	quest.0000000009000026.quest_subtitle: "Lightning School Inscription"
	quest.0000000009000026.title: "Lightning Runes"
	quest.0000000009000027.quest_desc: [
		"The Lightning Affinity Ring is an important accessory for lightning mages"
		"Wearing it resonates with the power of lightning"
		""
		"Effects:"
		"• Reduces lightning spell mana cost"
		"• Increases lightning spell chain range"
		""
		"Masters of thunder"
		"wear this electrifying power upon your finger!"
	]
	quest.0000000009000027.quest_subtitle: "Proof of Lightning Affinity"
	quest.0000000009000027.title: "Lightning Affinity Ring"
	quest.0000000009000028.quest_desc: [
		"Electromancer Armor is the Lightning Schools full combat set"
		"including Helmet, Chestplate, Leggings, and Boots"
		""
		"Full set bonuses:"
		"• Greatly increases lightning spell damage"
		"• Increases lightning resistance"
		"• Increases movement speed"
		""
		"Collect all four pieces"
		"and become the eye of the storm — unstoppable!"
	]
	quest.0000000009000028.quest_subtitle: "Lightning School Full Set"
	quest.0000000009000028.title: "Electromancer Armor"
	quest.0000000009000029.quest_desc: [
		"The Graybeard Staff is the Lightning Schools exclusive weapon"
		"forged from thunder materials and Arcane Ingots"
		""
		"Wielding the Graybeard Staff"
		"lightning spells gain devastating amplification"
		""
		"Swing it to call down thunder from the heavens"
		"and make enemies feel the fear of divine punishment!"
	]
	quest.0000000009000029.quest_subtitle: "Thunder Mages Staff"
	quest.0000000009000029.title: "Lightning Weapons"
	quest.0000000009000030.quest_desc: [
		"Holy School — The blessing of healing, purity, and protection"
		""
		"The Evoker Spell Book is the Holy Schools exclusive spell book"
		"focused on healing, buffs, and protection"
		""
		"Holy school signature spells:"
		"• Heal — Restores health"
		"• Cleanse — Removes negative effects"
		"• Holy Shield — Damage-absorbing barrier"
		"• Mass Heal — Area healing aura"
		""
		"Protected by holy light, shining the dawn of hope!"
	]
	quest.0000000009000030.quest_subtitle: "Healing, Purity  Protection"
	quest.0000000009000030.title: "Holy School"
	quest.0000000009000031.quest_desc: [
		"Holy Runes contain sacred energy"
		"and are the core material for Holy School spell books"
		""
		"On the Arcane Anvil"
		"inscribe Blank Runes with holy-related materials"
		"to obtain Holy Runes"
		""
		"These runes emit a warm golden glow"
		"as if conveying heavenly blessings"
	]
	quest.0000000009000031.quest_subtitle: "Holy School Inscription"
	quest.0000000009000031.title: "Holy Runes"
	quest.0000000009000032.quest_desc: [
		"The Holy Affinity Ring is an important accessory for holy mages"
		"Wearing it resonates with the power of the divine"
		""
		"Effects:"
		"• Reduces holy spell mana cost"
		"• Enhances healing effects and shield values"
		""
		"Followers of the holy light"
		"wear this blessed power upon your finger!"
	]
	quest.0000000009000032.quest_subtitle: "Proof of Holy Affinity"
	quest.0000000009000032.title: "Holy Affinity Ring"
	quest.0000000009000033.quest_desc: [
		"Archevoker Armor is the Holy Schools full combat set"
		"including Helmet, Chestplate, Leggings, and Boots"
		""
		"Full set bonuses:"
		"• Greatly increases holy spell healing"
		"• Increases maximum health"
		"• Auto slow health regeneration"
		""
		"Collect all four pieces"
		"and become a walking holy totem!"
	]
	quest.0000000009000033.quest_subtitle: "Holy School Full Set"
	quest.0000000009000033.title: "Archevoker Armor"
	quest.0000000009000034.quest_desc: [
		"The Amethyst Rapier is the Holy Schools exclusive weapon"
		"forged from amethyst and Arcane Ingots"
		""
		"Wielding the Amethyst Rapier"
		"perfectly combines holy spells with melee attacks"
		""
		"Swing your blade in the name of the divine"
		"vanquish evil and defend justice!"
	]
	quest.0000000009000034.quest_subtitle: "Holy Mages Rapier"
	quest.0000000009000034.title: "Holy Weapons"
	quest.0000000009000035.quest_desc: [
		"Blood School — The dark art of life drain, curses, and sacrifice"
		""
		"The Dragonskin Spell Book is the Blood Schools exclusive spell book"
		"specializing in life drain and curses"
		""
		"Blood school signature spells:"
		"• Life Drain — Drains target life"
		"• Blood Curse — Weakens enemy attributes"
		"• Blood Burst — Area bloody explosion"
		"• Blood Shield — Consumes blood for a barrier"
		""
		"Blood for blood — the way to survive in darkness!"
	]
	quest.0000000009000035.quest_subtitle: "Life Drain, Curse  Sacrifice"
	quest.0000000009000035.title: "Blood School"
	quest.0000000009000036.quest_desc: [
		"Blood Runes contain the energy of life"
		"and are the core material for Blood School spell books"
		""
		"On the Arcane Anvil"
		"inscribe Blank Runes with blood-related materials"
		"to obtain Blood Runes"
		""
		"These runes gleam with a dark crimson sheen"
		"as if whispering forbidden secrets"
	]
	quest.0000000009000036.quest_subtitle: "Blood School Inscription"
	quest.0000000009000036.title: "Blood Runes"
	quest.0000000009000037.quest_desc: [
		"The Blood Affinity Ring is an important accessory for blood mages"
		"Wearing it resonates with the power of blood"
		""
		"Effects:"
		"• Reduces blood spell mana cost"
		"• Enhances life drain healing ratio"
		""
		"Masters of blood"
		"wear this dark crimson power upon your finger!"
	]
	quest.0000000009000037.quest_subtitle: "Proof of Blood Affinity"
	quest.0000000009000037.title: "Blood Affinity Ring"
	quest.0000000009000038.quest_desc: [
		"Cultist Armor is the Blood Schools full combat set"
		"including Helmet, Chestplate, Leggings, and Boots"
		""
		"Full set bonuses:"
		"• Greatly increases life drain effect"
		"• Killing enemies restores health"
		"• Increases blood spell damage"
		""
		"Collect all four pieces"
		"nourish your own power with the blood of enemies!"
	]
	quest.0000000009000038.quest_subtitle: "Blood School Full Set"
	quest.0000000009000038.title: "Cultist Armor"
	quest.0000000009000039.quest_desc: [
		"The Blood Staff is the Blood Schools exclusive weapon"
		"forged from blood materials and Arcane Ingots"
		""
		"Wielding the Blood Staff"
		"each spell hit drains life from the target"
		""
		"With the scepter of blood in hand"
		"the life of your enemies is your fuel!"
	]
	quest.0000000009000039.quest_subtitle: "Blood Mages Staff"
	quest.0000000009000039.title: "Blood Weapons"
	quest.0000000009000040.quest_desc: [
		"Nature School — The harmony of thorns, poison, and summons"
		""
		"The Druidic Spell Book is the Nature Schools exclusive spell book"
		"connected to natures power, summoning flora to aid you"
		""
		"Nature school signature spells:"
		"• Thorns — Damage reflection aura"
		"• Poison Ivy — Entangles and poisons enemies"
		"• Natures Boon — Slow persistent regeneration"
		"• Summon Wolves — Calls wolves to fight alongside you"
		""
		"Listen to nature — every plant is your power!"
	]
	quest.0000000009000040.quest_subtitle: "Thorns, Poison  Summons"
	quest.0000000009000040.title: "Nature School"
	quest.0000000009000041.quest_desc: [
		"Nature Runes contain the energy of the earth"
		"and are the core material for Nature School spell books"
		""
		"On the Arcane Anvil"
		"inscribe Blank Runes with nature-related materials"
		"to obtain Nature Runes"
		""
		"These runes radiate emerald-green vitality"
		"as if you can hear the forest breathing"
	]
	quest.0000000009000041.quest_subtitle: "Nature School Inscription"
	quest.0000000009000041.title: "Nature Runes"
	quest.0000000009000042.quest_desc: [
		"The Nature Affinity Ring is an important accessory for nature mages"
		"Wearing it resonates with the power of nature"
		""
		"Effects:"
		"• Reduces nature spell mana cost"
		"• Extends summoned creature duration"
		""
		"Guardians of nature"
		"wear this forests power upon your finger!"
	]
	quest.0000000009000042.quest_subtitle: "Proof of Nature Affinity"
	quest.0000000009000042.title: "Nature Affinity Ring"
	quest.0000000009000043.quest_desc: [
		"Plagued Armor is the Nature Schools combat set"
		"including Helmet, Chestplate, and Boots"
		""
		"Set bonuses:"
		"• Melee attacks inflict poison"
		"• Increases poison spell damage"
		"• Reduces nature spell cost"
		""
		"Put on Plagued Armor"
		"and make toxins your sharpest weapon!"
	]
	quest.0000000009000043.quest_subtitle: "Nature School Battle Set"
	quest.0000000009000043.title: "Plagued Armor"
	quest.0000000009000044.quest_desc: [
		"The Decrepit Scythe is the Nature Schools basic weapon"
		"forged from natural materials and Arcane Ingots"
		""
		"Wielding the Decrepit Scythe"
		"the powers of death and life intertwine on its blade"
		""
		"Swing the scythe to reap everything"
		"at the cost of death, awaken new life!"
	]
	quest.0000000009000044.quest_subtitle: "Nature Mages Scythe"
	quest.0000000009000044.title: "Nature Weapons"
	quest.0000000009000045.quest_desc: [
		"Collect all six school spell books"
		"proving you have mastered all magical schools"
		""
		"Submit the following six spell books:"
		"• Blaze Spell Book — Fire School"
		"• Ice Spell Book — Ice School"
		"• Copper Spell Book — Lightning School"
		"• Evoker Spell Book — Holy School"
		"• Dragonskin Spell Book — Blood School"
		"• Druidic Spell Book — Nature School"
		""
		"Only those who have mastered all schools"
		"are worthy of forging even more powerful advanced spell books!"
	]
	quest.0000000009000045.quest_subtitle: "Master of Six Schools"
	quest.0000000009000045.title: "School Master"
	quest.0000000009000046.quest_desc: [
		"The Gold Spell Book is an upgraded version of the Iron Spell Book"
		"featuring 8 spell slots"
		""
		"2 more slots than the Iron Spell Book"
		"allowing more spell combinations to be equipped"
		""
		"Craft on the Arcane Anvil"
		"requires Gold Ingots and Arcane Runes"
		""
		"More slots mean more spell choices"
		"flexibly switch to handle any situation in combat!"
	]
	quest.0000000009000046.quest_subtitle: "8 Spell Slots"
	quest.0000000009000046.title: "Gold Spell Book"
	quest.0000000009000047.quest_desc: [
		"Spell Slot Upgrade items increase spell book slot count"
		"allowing your spell book to hold more spells"
		""
		"Each use of an upgrade"
		"adds extra slots to your spell book"
		""
		"Ample slots let you have"
		"more tactical options in combat"
	]
	quest.0000000009000047.quest_subtitle: "Expand Spell Capacity"
	quest.0000000009000047.title: "Spell Slot Upgrade"
	quest.0000000009000048.quest_desc: [
		"The Diamond Spell Book is the pinnacle of mid-tier spell books"
		"featuring 10 spell slots"
		""
		"enabling simultaneous use of multiple school spells"
		"for cross-school combos"
		""
		"Craft on the Arcane Anvil"
		"requires Diamonds and a Gold Spell Book as the base"
		""
		"10 slots truly make you"
		"a battlemage versed in many schools!"
	]
	quest.0000000009000048.quest_subtitle: "10 Spell Slots"
	quest.0000000009000048.title: "Diamond Spell Book"
	quest.0000000009000049.quest_desc: [
		"The Netherite Spell Book is the apex of standard spell books"
		"featuring 12 spell slots"
		""
		"Among non-legendary spell books"
		"it has the most slots and largest mana capacity"
		""
		"Craft on the Arcane Anvil"
		"requires Netherite Ingots and a Diamond Spell Book"
		""
		"12 slots let you freely"
		"wield the full power of all six schools!"
	]
	quest.0000000009000049.quest_subtitle: "12 Spell Slots"
	quest.0000000009000049.title: "Netherite Spell Book"
	quest.0000000009000050.quest_desc: [
		"Netherite Mage Armor is ISBs strongest magical armor set"
		"including Helmet, Chestplate, Leggings, and Boots"
		""
		"Full set bonuses:"
		"• Greatly increases all school spell damage"
		"• Extremely high magic resistance"
		"• Increases max mana and regeneration speed"
		""
		"Put on this legendary set"
		"and you are a walking magical fortress!"
	]
	quest.0000000009000050.quest_subtitle: "Ultimate Magic Combat Set"
	quest.0000000009000050.title: "Netherite Mage Armor"
	quest.0000000009000051.quest_desc: [
		"The Necronomicon is ISBs most powerful legendary spell book"
		"containing ancient and forbidden magical knowledge"
		""
		"This is the ultimate tome hidden behind all schools"
		"with mana capacity far exceeding standard spell books"
		""
		"Requires extremely rare materials to craft"
		"including Nether Stars, Dragons Breath, and other legendary components"
		""
		"Legend says only the most powerful mages"
		"can control the power of the Necronomicon"
		""
		"Now, this power belongs to you!"
	]
	quest.0000000009000051.quest_subtitle: "Legendary Forbidden Tome"
	quest.0000000009000051.title: "Necronomicon"
	quest.0000000009000052.quest_desc: [
		"Collect the three rare school affinity rings"
		"to fully experience all known magical schools"
		""
		"• Ender Affinity Ring — Space  Teleportation"
		"• Evoker Affinity Ring — Summons  Commands"
		"• Cultist Ring — Forbidden  Curses"
		""
		"These rare rings expand"
		"the magical domains beyond the six primary schools"
	]
	quest.0000000009000052.quest_subtitle: "Three Arcane Affinity Rings"
	quest.0000000009000052.title: "Rare Rings"
	quest.0000000009000053.quest_desc: [
		"Cinderous Soul Runes are special soul-based runes"
		"containing soul energy tempered by flames"
		""
		"These runes are used to inscribe"
		"the most forbidden and powerful spells"
		""
		"Souls are the ultimate fuel for magic"
		"at the cost of souls, gain supreme power!"
	]
	quest.0000000009000053.quest_subtitle: "Cinderous Soul Power"
	quest.0000000009000053.title: "Soul Runes"
	quest.0000000009000054.quest_desc: [
		"The Auto-loading Crossbow is a special ranged weapon in ISB"
		"cleverly combining magic and machinery"
		""
		"Features:"
		"• Auto-loading — no manual cocking needed"
		"• Can fire magical arrows"
		"• Compatible with various enchantment enhancements"
		""
		"A perfect fusion of technology and magic"
		"silently harvesting enemies from afar!"
	]
	quest.0000000009000054.quest_subtitle: "Auto-loading Crossbow"
	quest.0000000009000054.title: "Crossbow Mage"
	quest.0000000009000055.quest_desc: [
		"Ender Runes and Evocation Runes are advanced school runes"
		"representing the magical powers of space and summoning"
		""
		"Ender Rune — Spatial teleportation and blink spells"
		"Evocation Rune — Summoning and command spells"
		""
		"Master these high-tier runes"
		"and the boundaries of space, time, and life will blur for you!"
	]
	quest.0000000009000055.quest_subtitle: "Space  Evocation Inscription"
	quest.0000000009000055.title: "Ender Runes"
	quest.0000000009000056.quest_desc: [
		"A true mage is not merely one who casts spells"
		"but one who deeply understands magical materials"
		""
		"Collect large quantities of basic magical materials:"
		"• Arcane Ingots x64 — Foundation of magical metal"
		"• Arcane Runes x64 — Spell book core"
		"• Arcane Essence x64 — Source of magical energy"
		""
		"With ample magical material reserves"
		"you can freely forge and experiment with magic"
	]
	quest.0000000009000056.quest_subtitle: "Magic Material Master"
	quest.0000000009000056.title: "Spell Mastery"
	quest.0000000009000057.quest_desc: [
		"Collect and mass-produce affinity rings"
		"to become a true accessory expert"
		""
		"Required submissions:"
		"• Basic Affinity Rings x8"
		"• Six school affinity rings x2 each"
		""
		"Rings are a mages most important accessories"
		"Mix different rings for magical enhancement combos!"
	]
	quest.0000000009000057.quest_subtitle: "Full Affinity Ring Collection"
	quest.0000000009000057.title: "Accessory Expert"
	quest.0000000009000058.quest_desc: [
		"Proof of pushing your magical path to its peak"
		"Showcase your most precious magical collection"
		""
		"Collection requirements:"
		"• Necronomicon — Proof of Legend"
		"• Netherite Spell Book — Proof of Peak"
		"• Legendary Ink x4 — Ultimate inscription ink"
		"• Arcane Ingots x64 — Proof of boundless resources"
		""
		"All of this gathered in one place"
		"you are a true legendary collector!"
	]
	quest.0000000009000058.quest_subtitle: "Ultimate Magic Collector"
	quest.0000000009000058.title: "Legendary Collection"
	quest.0000000009000059.quest_desc: [
		"Runes are the bridge connecting school powers to spell books"
		"Collect large quantities of all six school runes"
		""
		"Submit 32 of each school rune:"
		"• Fire Runes — Power of Flame"
		"• Ice Runes — Power of Frost"
		"• Lightning Runes — Power of Lightning"
		"• Holy Runes — Power of the Divine"
		"• Blood Runes — Power of Life"
		"• Nature Runes — Power of the Earth"
		""
		"With runes in hand, all magic is yours to command!"
	]
	quest.0000000009000059.quest_subtitle: "Six Schools Rune Mastery"
	quest.0000000009000059.title: "Rune Master"
	quest.0000000009000060.quest_desc: [
		"Congratulations! You have become a Magic Conqueror!"
		""
		"You have mastered:"
		"• Arcane Basics — From debris to Arcane Ingots"
		"• Arcane Anvil  Alchemist Cauldron — Magical Workshop"
		"• Six Schools — Fire/Ice/Lightning/Holy/Blood/Nature"
		"• School Books — All six school spell books"
		"• Spell Book Upgrades — Gold > Diamond > Netherite"
		"• Necronomicon — Legendary forbidden spell tome"
		"• Full Armor Sets — Six school exclusive battle armor"
		"• Full Ring Collection — Magical accessory master"
		"• Full Rune Mastery — All six school runes"
		"• Material Master — Vast magical resource reserves"
		""
		"From Arcane Apprentice to Magic Conqueror"
		"You are AKINOs most powerful Magic Conqueror!"
	]
	quest.0000000009000060.quest_subtitle: "ISB Chapter Final Completion"
	quest.0000000009000060.title: "Graduation: Magic Conqueror"
	quest.0000000010000001.quest_desc: [
		"Gather glowstone in the dark depths of the Nether"
		"Build a portal to the Aether using glowstone"
		"Within the radiance, the world above the clouds awaits you"
		"Step through this gate and begin your Aether journey"
	]
	quest.0000000010000001.quest_subtitle: "Sky Gate"
	quest.0000000010000001.title: "Sky Gate"
	quest.0000000010000002.quest_desc: [
		"Cross the glowstone portal to enter the Aether"
		"Collect Aether Grass as your foothold"
		"Observe the unique terrain and creatures around you"
		"Above the sky, anything is possible"
	]
	quest.0000000010000002.quest_subtitle: "Enter the Aether"
	quest.0000000010000002.title: "Enter the Aether"
	quest.0000000010000003.quest_desc: [
		"The Aether has different survival rules than the overworld"
		"Collect Aether Dirt and Aether Grass as basics"
		"Learn the Aether's unique fall mechanics"
		"Stand firm on your feet to travel further"
	]
	quest.0000000010000003.quest_subtitle: "Aether Survival"
	quest.0000000010000003.title: "Aether Survival"
	quest.0000000010000004.quest_desc: [
		"The Aether's most basic wood — Skyroot"
		"Chop Skyroot Logs and collect saplings"
		"Skyroot wood is the starting point of Aether survival"
		"All construction begins with this log"
	]
	quest.0000000010000004.quest_subtitle: "Skyroot Logs"
	quest.0000000010000004.title: "Skyroot Logs"
	quest.0000000010000005.quest_desc: [
		"Craft basic tools using Skyroot wood"
		"Your most reliable companion in the early Aether"
		"Pickaxe, axe, shovel, sword — a complete set"
		"Well-equipped, ready to travel in all directions"
	]
	quest.0000000010000005.quest_subtitle: "Skyroot Tools"
	quest.0000000010000005.title: "Skyroot Tools"
	quest.0000000010000006.quest_desc: [
		"Process Skyroot logs into building materials"
		"Planks, stairs, slabs — all available"
		"Build your first base in the Aether"
		"Skyroot builds are beautiful and practical"
	]
	quest.0000000010000006.quest_subtitle: "Skyroot Building"
	quest.0000000010000006.title: "Skyroot Building"
	quest.0000000010000007.quest_desc: [
		"Add doors and fences to your Aether home"
		"Doors for protection, fences for Moa ranching"
		"The complete Skyroot home series"
		"Safety first — build your Aether cottage"
	]
	quest.0000000010000007.quest_subtitle: "Skyroot Doors"
	quest.0000000010000007.title: "Skyroot Doors"
	quest.0000000010000008.quest_desc: [
		"Sail across Aether lakes and cloud tops"
		"Skyroot Boat and Chest Boat"
		"Light and durable, essential for floating island exploration"
		"Ride the wind and waves across Aether waters"
	]
	quest.0000000010000008.title: "Skyroot Boat"
	quest.0000000010000009.quest_desc: [
		"Skyroot Bucket, the Aether's unique container"
		"Used to carry water and transport aquatic creatures"
		"Can also collect the Aether's unique poison"
		"A small bucket with great utility"
	]
	quest.0000000010000009.title: "Skyroot Bucket"
	quest.0000000010000010.quest_desc: [
		"Settling in the Aether? Of course you need a bed"
		"Skyroot Bed and Bookshelf accompany your nights"
		"Setting a spawn point in the Aether is crucial"
		"Rest well and prepare for greater challenges"
	]
	quest.0000000010000010.title: "Skyroot Bed"
	quest.0000000010000011.quest_desc: [
		"The Aether's unique aercloud blocks"
		"Cold aerclouds slow you down, golden aerclouds speed you up"
		"Blue aerclouds let you bounce — each with its own use"
		"Collect all three aerclouds and master Aether mobility"
	]
	quest.0000000010000011.quest_subtitle: "Aerclouds"
	quest.0000000010000011.title: "Aerclouds"
	quest.0000000010000012.quest_desc: [
		"The Aether's most abundant stone — Holystone"
		"Ancient stones scattered across Aether island massifs"
		"A more durable material than Skyroot"
		"Holystone — opens the second phase of the Aether"
	]
	quest.0000000010000012.quest_subtitle: "Holystone Era"
	quest.0000000010000012.title: "Holystone Era"
	quest.0000000010000013.quest_desc: [
		"Process Holystone into refined building blocks"
		"Holystone Bricks, Holystone Brick Stairs, and Slabs"
		"The perfect material for second-phase Aether building"
		"Construct a Holystone castle atop the clouds"
	]
	quest.0000000010000013.quest_subtitle: "Holystone Building"
	quest.0000000010000013.title: "Holystone Building"
	quest.0000000010000014.quest_desc: [
		"Collect more Holystone building blocks"
		"Holystone Stairs, Slabs, and Walls"
		"Perfect your Aether architectural style"
		"Every brick and tile carries Holystone's elegance"
	]
	quest.0000000010000014.quest_subtitle: "Holystone Set"
	quest.0000000010000014.title: "Holystone Set"
	quest.0000000010000015.quest_desc: [
		"Mossy Holystone weathered by ages"
		"Mossy Holystone and Mossy Holystone Stairs — ancient and natural"
		"Find them in the ancient Aether ruins"
		"Each mossy stone tells a story of the distant past"
	]
	quest.0000000010000015.quest_subtitle: "Mossy Holystone"
	quest.0000000010000015.title: "Mossy Holystone"
	quest.0000000010000016.quest_desc: [
		"The Aether's unique magical ore — Ambrosium"
		"Mine the ore to obtain Ambrosium Shards"
		"Use shards to craft Ambrosium Torches"
		"The Aether's most basic energy source"
	]
	quest.0000000010000016.title: "Ambrosium Ore"
	quest.0000000010000017.quest_desc: [
		"The most important mid-game mineral — Zanite"
		"Zanite ore spreads throughout the Aether underground"
		"Zanite gets stronger the more you use it — a unique trait"
		"The hallmark of advancing to the mid-tier Aether"
	]
	quest.0000000010000017.quest_subtitle: "Zanite Era"
	quest.0000000010000017.title: "Zanite Era"
	quest.0000000010000018.quest_desc: [
		"Forge powerful tools with Zanite"
		"Zanite tools get faster as durability decreases"
		"Unique trait makes combat and gathering more exciting"
		"Zanite in hand, the world is yours"
	]
	quest.0000000010000018.quest_subtitle: "Zanite Tools"
	quest.0000000010000018.title: "Zanite Tools"
	quest.0000000010000019.quest_desc: [
		"Craft Zanite Blocks from Zanite gemstones"
		"Store your Zanite wealth"
		"Zanite Blocks can be used for decoration or beacon bases"
		"Stack them high to display your power"
	]
	quest.0000000010000019.title: "Zanite Block"
	quest.0000000010000020.quest_desc: [
		"Craft exquisite accessories with Zanite"
		"Zanite Ring and Pendant provide unique buffs"
		"The accessory system is a unique Aether feature"
		"Wear them and feel the power of Zanite"
	]
	quest.0000000010000020.quest_subtitle: "Zanite Accessories"
	quest.0000000010000020.title: "Zanite Accessories"
	quest.0000000010000021.quest_desc: [
		"The Aether's unique delicious food"
		"Blue Berries restore stamina, Enchanted Berries provide special effects"
		"White Apples are the Aether's most precious fruit"
		"Food accompanies the journey, energy replenished"
	]
	quest.0000000010000021.quest_subtitle: "Aether Food"
	quest.0000000010000021.title: "Aether Food"
	quest.0000000010000022.quest_desc: [
		"Special sweets obtained from the Aether"
		"Candy Canes and Gingerbread Men — cute and delicious"
		"Special holiday-themed treats"
		"Sweet in the mouth, warm in the heart"
	]
	quest.0000000010000022.quest_subtitle: "Aether Sweets"
	quest.0000000010000022.title: "Aether Sweets"
	quest.0000000010000023.quest_desc: [
		"Defeat the Aether's unique Swet slimes"
		"Collect Swet Balls and Gummy Swets"
		"Blue Gummy and Golden Gummy — each with their own use"
		"Soft and sticky, but very useful"
	]
	quest.0000000010000023.quest_subtitle: "Swet  Gummy"
	quest.0000000010000023.title: "Swet  Gummy"
	quest.0000000010000024.quest_desc: [
		"The Aether's most precious ore — Gravitite"
		"Gravitite ore hides deep within the Aether underground"
		"A Zanite pickaxe is required to mine it"
		"The power of levitation, beyond ordinary physics"
	]
	quest.0000000010000024.title: "Gravitite Ore"
	quest.0000000010000025.quest_desc: [
		"Forge top-tier tools with Gravitite"
		"Gravitite tools can make blocks float in the air"
		"Right-click to levitate blocks in mid-air"
		"Master gravity, reshape the Aether"
	]
	quest.0000000010000025.quest_subtitle: "Gravitite Tools"
	quest.0000000010000025.title: "Gravitite Tools"
	quest.0000000010000026.quest_desc: [
		"Infuse Gravitite with stronger magical energy"
		"Enchanted Gravitite is the Aether's ultimate material"
		"Used to craft various ultimate equipment"
		"The perfect union of magic and gravity"
	]
	quest.0000000010000026.title: "Enchanted Gravitite"
	quest.0000000010000027.quest_desc: [
		"The Aether's three elemental weapons"
		"Flaming Sword burns all, Holy Sword banishes evil"
		"Lightning Sword strikes enemies to summon lightning"
		"Elemental power gathered at blade's edge"
	]
	quest.0000000010000027.quest_subtitle: "Special Weapons"
	quest.0000000010000027.title: "Special Weapons"
	quest.0000000010000028.quest_desc: [
		"A collection of the Aether's rare weapons"
		"Vampire Blade drains life to restore health"
		"Pig Slayer — wield against the denizens of the Nether"
		"Each weapon has its own legendary tale"
	]
	quest.0000000010000028.quest_subtitle: "Advanced Weapons"
	quest.0000000010000028.title: "Advanced Weapons"
	quest.0000000010000029.quest_desc: [
		"The essence of Aether ranged weapons"
		"Cloud Staff summons cloud blocks to walk on"
		"Nature Staff heals oneself"
		"Phoenix Bow shoots unquenchable arrows"
	]
	quest.0000000010000029.quest_subtitle: "Staves  Bow"
	quest.0000000010000029.title: "Staves  Bow"
	quest.0000000010000030.quest_desc: [
		"The Aether's most legendary divine weapons"
		"Hammer of Jeb — crushes enemies with the power of Notch"
		"Valkyrie Lance — the signature weapon of the Valkyrie Queen"
		"Obtain them and write your own legend"
	]
	quest.0000000010000030.quest_subtitle: "Legendary Weapons"
	quest.0000000010000030.title: "Legendary Weapons"
	quest.0000000010000031.quest_desc: [
		"The great gates of Aether dungeons open before you"
		"Collect the Bronze, Silver, and Gold keys"
		"Each key corresponds to a different dungeon challenge"
		"Three dungeons, three bosses, awaiting your challenge"
	]
	quest.0000000010000031.quest_subtitle: "Dungeon Entrance"
	quest.0000000010000031.title: "Dungeon Entrance"
	quest.0000000010000032.quest_desc: [
		"Challenge the Slider Boss of the Bronze Dungeon"
		"A giant sliding automaton guards the treasure"
		"Collect the Bronze Key and open the treasure chest"
		"The first test of wisdom and courage"
	]
	quest.0000000010000032.quest_subtitle: "Bronze Dungeon"
	quest.0000000010000032.title: "Bronze Dungeon"
	quest.0000000010000033.quest_desc: [
		"Challenge the Valkyrie Queen of the Silver Dungeon"
		"The valiant Valkyries guard the sacred temple"
		"Defeat her to obtain the Valkyrie Lance"
		"The ultimate test of combat skill"
	]
	quest.0000000010000033.quest_subtitle: "Silver Dungeon"
	quest.0000000010000033.title: "Silver Dungeon"
	quest.0000000010000034.quest_desc: [
		"Challenge the Sun God of the Gold Dungeon"
		"The blazing spirit guards the golden temple"
		"Find the Sun Altar and face the fury of the sun"
		"The hardest fight among the three bosses"
	]
	quest.0000000010000034.quest_subtitle: "Gold Dungeon"
	quest.0000000010000034.title: "Gold Dungeon"
	quest.0000000010000035.quest_desc: [
		"Collect the precious loot from all three dungeon bosses"
		"Victory Medals witness your triumph"
		"Presents and Enchanted Gravitite carried home in triumph"
		"All three bosses have bowed to your might"
	]
	quest.0000000010000035.title: "Boss Loot"
	quest.0000000010000036.quest_desc: [
		"The Aether's unique flying mount — Moa"
		"Collect Blue, White, and Black Moa Eggs"
		"Each Moa color has different abilities"
		"Tame a Moa and soar through Aether skies"
	]
	quest.0000000010000036.quest_subtitle: "Moa Hatching"
	quest.0000000010000036.title: "Moa Hatching"
	quest.0000000010000037.quest_desc: [
		"Craft an Incubator to hatch Moa eggs"
		"Golden Amber is the fuel for the Incubator"
		"Wait patiently, new life is about to be born"
		"Baby Moa, the Aether's most loyal companion"
	]
	quest.0000000010000037.title: "Incubator"
	quest.0000000010000038.quest_desc: [
		"Free-falling in the Aether requires a parachute"
		"Golden Parachute and Cold Parachute"
		"Pair with Golden Feathers for slow falling"
		"Land safely, fearless of the heights"
	]
	quest.0000000010000038.quest_subtitle: "Parachute Gear"
	quest.0000000010000038.title: "Parachute Gear"
	quest.0000000010000039.quest_desc: [
		"The Aether's traditional ranged weapon — Darts"
		"Golden Darts, Poison Darts, Enchanted Darts"
		"Three dart shooters, each with their own strengths"
		"Every shot hits home, piercing from a hundred paces"
	]
	quest.0000000010000039.quest_subtitle: "Dart Set"
	quest.0000000010000039.title: "Dart Set"
	quest.0000000010000040.quest_desc: [
		"The Aether's accessory system is rich and varied"
		"Golden Ring, Iron Ring, Ice Ring"
		"Pendants also come in Iron and Ice varieties"
		"Complete accessories — like a tiger with wings"
	]
	quest.0000000010000040.quest_subtitle: "Accessory Collection"
	quest.0000000010000040.title: "Accessory Collection"
	quest.0000000010000041.quest_desc: [
		"Aether capes are both cosmetic and functional"
		"Agility Cape boosts movement speed"
		"Swet Cape and Valkyrie Cape each have their own traits"
		"Capes flowing — the Aether is yours to soar"
	]
	quest.0000000010000041.quest_subtitle: "Cape Collection"
	quest.0000000010000041.title: "Cape Collection"
	quest.0000000010000042.quest_desc: [
		"The Aether's unique special defensive equipment"
		"Shield of Repulsion repels all who dare attack"
		"Invisibility Cloak lets you move unseen in darkness"
		"Regeneration Stone and Healing Stone keep you completely safe"
	]
	quest.0000000010000042.quest_subtitle: "Special Equipment"
	quest.0000000010000042.title: "Special Equipment"
	quest.0000000010000043.quest_desc: [
		"Collect Life Shards to increase your maximum health"
		"Iron Bubble provides underwater breathing"
		"Search the depths of the Aether for these rare items"
		"Life force is the foundation of Aether exploration"
	]
	quest.0000000010000043.quest_subtitle: "Life Shard"
	quest.0000000010000043.title: "Life Shard"
	quest.0000000010000044.quest_desc: [
		"Collect all the Aether music discs"
		"Six discs recording the tales of the Aether"
		"From Aether Tune to Slider's Wrath"
		"Music is the chanting of the Aether's soul"
	]
	quest.0000000010000044.quest_subtitle: "Music Discs"
	quest.0000000010000044.title: "Music Discs"
	quest.0000000010000045.quest_desc: [
		"The Aether's rarest tree — Golden Oak"
		"Collect Golden Oak Logs and saplings"
		"Golden Oaks only grow on special Aether floating islands"
		"Golden leaves shimmering with radiance"
	]
	quest.0000000010000045.title: "Golden Oak"
	quest.0000000010000046.quest_desc: [
		"The Aether's beautiful crystal leaves"
		"Crystal Leaves and Crystal Fruit Leaves"
		"They grow in the mystical corners of the Aether"
		"Crystal clear, breathtakingly beautiful"
	]
	quest.0000000010000046.title: "Crystal Leaves"
	quest.0000000010000047.quest_desc: [
		"The Aether's unique quicksoil and glass"
		"Quicksoil makes those walking on it slide faster"
		"Quicksoil Glass is a transparent speed floor"
		"Speed and passion — race freely through the Aether"
	]
	quest.0000000010000047.quest_subtitle: "Quicksoil Glass"
	quest.0000000010000047.title: "Quicksoil Glass"
	quest.0000000010000048.quest_desc: [
		"The ultimate proof of an Aether Master"
		"Gather massive quantities of rare Aether resources"
		"Gravitite Ore, Zanite, Aether Grass, Presents"
		"You are now truly an Aether Master-grade figure"
	]
	quest.0000000010000048.quest_subtitle: "Aether Master"
	quest.0000000010000048.title: "Aether Master"
	quest.0000000010000049.quest_desc: [
		"The ultimate goal of an Aether Collector"
		"Collect massive quantities of Aether delicacies and goods"
		"Blue Berries, Candy Canes, Gingerbread Men, Aechor Petals"
		"Every collected item is a precious memory of the Aether"
	]
	quest.0000000010000049.title: "Aether Collector"
	quest.0000000010000050.quest_desc: [
		"The final graduation mission of the Aether journey"
		"From the Sky Gate to the three dungeons"
		"You have conquered the entire world above the clouds"
		"Aether Overlord — the title speaks for itself"
		"Thank you for your perseverance and courage"
	]
	quest.0000000010000050.title: "Aether Conqueror"
	quest.0000000011000001.quest_desc: [
		"Welcome to the Ultimate Boss Hunting chapter!"
		"This chapter challenges the strongest bosses in this modpack."
		""
		"ISB Magic Bosses:"
		"- Tyros - The Flame Demon King"
		"- Dead King - Lord of the Undead"
		""
		"Block Factory Bosses (BFB):"
		"- Sandworm - Desert Behemoth"
		"- Yeti - Tundra Predator"
		"- Great Dragon - Sky Overlord"
		"- Knight - Castle Guardian"
		"- Kraken - Deep Sea Terror"
		""
		"All quests require submitting boss drop trophies as proof."
		"No cheating - only victory earns the spoils!"
		""
		"Prepare 32 Arcane Ingots and embark on your hunt!"
	]
	quest.0000000011000001.quest_subtitle: "ISB Magic Boss Hunt"
	quest.0000000011000001.title: "Magic Hunt"
	quest.0000000011000002.quest_desc: [
		"Tyros - The Flame Demon King"
		"Demon lord who commands hellfire."
		""
		"Boss traits:"
		"- Immune to fire and lava damage"
		"- Launches fireball barrages"
		"- Summons Blaze minions to assist"
		"- Extremely high HP; full enchanted gear recommended"
		""
		"Battle preparations:"
		"- Fire Resistance potion (ESSENTIAL!)"
		"- Ranged weapons for aerial combat"
		"- Fully enchanted Netherite gear"
		""
		"Trophy proof: Blaze Rod x32 + Magma Cream x8"
		"Prove you have defeated the Flame Demon King!"
	]
	quest.0000000011000002.quest_subtitle: "Tyros the Flame Demon"
	quest.0000000011000002.title: "Tyros Battle"
	quest.0000000011000003.quest_desc: [
		"Dead King - Lord of the Undead"
		"The terrifying monarch who rules the realm of the dead."
		""
		"Boss traits:"
		"- Summons undead legions to assist"
		"- Wither aura continuously corrodes life"
		"- Wither Skeleton royal guard protection"
		"- Shadow magic area attacks"
		""
		"Battle preparations:"
		"- Smite-enchanted weapons"
		"- Plenty of milk to clear wither effects"
		"- Golden apples for health regeneration"
		""
		"Trophy proof: Wither Skeleton Skull x3 + Bone Block x8"
		"Prove you have defeated the Lord of the Undead!"
	]
	quest.0000000011000003.quest_subtitle: "Dead King, Lord of Undead"
	quest.0000000011000003.title: "Dead King Battle"
	quest.0000000011000004.quest_desc: [
		"After defeating Tyros and the Dead King,"
		"you have earned the right to wield high-level magic."
		""
		"The Necronomicon is the most powerful shadow spellbook,"
		"containing the ultimate power of the undead realm."
		""
		"Only a mage who has conquered both flame and undeath"
		"is worthy of mastering this tome."
		""
		"Submit the Necronomicon as proof of the dual-king conquest!"
	]
	quest.0000000011000004.quest_subtitle: "Defeat both Kings for the Necronomicon"
	quest.0000000011000004.title: "Necronomicon"
	quest.0000000011000005.quest_desc: [
		"You have defeated all ISB Magic bosses!"
		""
		"Achievement summary:"
		"- Tyros - Flame Demon King (done)"
		"- Dead King - Lord of the Undead (done)"
		"- Necronomicon - Ultimate Spell (done)"
		""
		"Now submit the final trophies"
		"to prove you have conquered the ISB Magic chapter!"
		""
		"Required: Nether Star x2 + Arcane Ingot x64"
	]
	quest.0000000011000005.quest_subtitle: "ISB Boss Complete Hunt"
	quest.0000000011000005.title: "Magic Boss Hunter"
	quest.0000000011000006.quest_desc: [
		"Block Factory Bosses (BFB)"
		"are the second boss challenge group in this pack."
		""
		"Five bosses are scattered across the world:"
		"- Sandworm - Deep in the desert"
		"- Yeti - Snow-covered tundra"
		"- Great Dragon - Towering mountain peaks"
		"- Knight - Ancient castle ruins"
		"- Kraken - Deep ocean caves"
		""
		"Each boss has unique trophies."
		"Defeat them all to complete the ultimate conquest!"
		""
		"Ready your strongest gear!"
		"Submit: Netherite Sword x1 + Totem of Undying x1"
	]
	quest.0000000011000006.quest_subtitle: "Block Factory Bosses"
	quest.0000000011000006.title: "Ultimate Challenge"
	quest.0000000011000007.quest_desc: [
		"Sandworm - A giant worm lurking beneath the desert."
		""
		"Boss traits:"
		"- Lurks in sand, ambushes unexpectedly"
		"- Burrows underground, hard to lock onto"
		"- Swallows players for massive damage"
		"- Summons zombies to assist"
		""
		"Combat tips:"
		"- Fight on solid blocks (harder for the worm to burrow)"
		"- Suppress with ranged bow attacks"
		"- Watch for ground vibration warnings"
		""
		"Trophy proof: Sand x64 + Sandstone x64 + Rotten Flesh x32"
	]
	quest.0000000011000007.quest_subtitle: "Desert Behemoth"
	quest.0000000011000007.title: "Sandworm"
	quest.0000000011000008.quest_desc: [
		"Yeti - The apex predator of the frozen tundra."
		""
		"Boss traits:"
		"- Ice breath freezes players"
		"- Frigid aura continuously slows"
		"- Bite attacks deal piercing damage"
		"- Summons ice shard area attacks"
		""
		"Battle preparations:"
		"- Leather armor for cold protection"
		"- Resistance potions"
		"- Keep moving to dodge ice shards"
		""
		"Trophy proof: Snow Block x32 + Packed Ice x32 + Bone x32"
	]
	quest.0000000011000008.quest_subtitle: "Tundra Predator"
	quest.0000000011000008.title: "Yeti"
	quest.0000000011000009.quest_desc: [
		"Great Dragon - Sky overlord atop towering peaks."
		""
		"Boss traits:"
		"- Agile and flexible flight patterns"
		"- Dragon breath covers large areas"
		"- Dive-bomb strikes are instantly lethal"
		"- Dragon roar knocks back players"
		""
		"Battle preparations:"
		"- Elytra + Fireworks for aerial pursuit"
		"- Powerful bow for ranged damage"
		"- Dragon''s Breath potions as counters"
		"- Burst melee when grounded"
		""
		"Trophy proof: Dragon''s Breath x8 + Dragon Head x1 + Obsidian x64"
	]
	quest.0000000011000009.quest_subtitle: "Sky Overlord"
	quest.0000000011000009.title: "Great Dragon"
	quest.0000000011000010.quest_desc: [
		"Knight - The immortal guardian of ancient castles."
		""
		"Boss traits:"
		"- Heavy armor with extreme damage reduction"
		"- Shield blocks frontal attacks"
		"- Charging impacts deal massive damage"
		"- Summons Iron Golem legions"
		""
		"Combat tips:"
		"- Flank attack (knight''s shield makes front invulnerable)"
		"- Axe to break shield (armor-piercing effect)"
		"- Prioritize clearing Iron Golem minions"
		""
		"Trophy proof: Netherite Ingot x4 + Shield x4 + Iron Block x16"
	]
	quest.0000000011000010.quest_subtitle: "Castle Guardian"
	quest.0000000011000010.title: "Knight"
	quest.0000000011000011.quest_desc: [
		"Kraken - The terrifying leviathan of the deep ocean caves."
		""
		"Boss traits:"
		"- Moves extremely fast underwater, relentless pursuit"
		"- Tentacle attacks deal area damage"
		"- Ink clouds blind players"
		"- Whirlpool vortex drags players into the depths"
		""
		"Battle preparations:"
		"- Depth Strider III enchanted boots"
		"- Water Breathing + Night Vision potions"
		"- Trident (Impaling V) for ranged advantage"
		"- Turtle Shell helmet for extended underwater time"
		""
		"Trophy proof: Heart of the Sea x2 + Prismarine Shard x64 + Nautilus Shell x4"
	]
	quest.0000000011000011.quest_subtitle: "Deep Sea Terror"
	quest.0000000011000011.title: "Kraken"
	quest.0000000011000012.quest_desc: [
		"You have defeated all 5 BFB bosses!"
		""
		"Hunt checklist:"
		"- Sandworm - Desert Behemoth (done)"
		"- Yeti - Tundra Predator (done)"
		"- Great Dragon - Sky Overlord (done)"
		"- Knight - Castle Guardian (done)"
		"- Kraken - Deep Sea Terror (done)"
		""
		"All five bosses conquered!"
		"Submit combined trophies as proof of victory."
		""
		"Required: Nether Star x5 + Dragon''s Breath x16 + Sand x64 + Snow Block x64 + Heart of the Sea x4"
	]
	quest.0000000011000012.quest_subtitle: "BFB Complete Hunt"
	quest.0000000011000012.title: "BFB Hunter"
	quest.0000000011000013.quest_desc: [
		"You have conquered all bosses in this modpack!"
		""
		"ISB Magic Boss record:"
		"- Tyros - Flame Demon King (done)"
		"- Dead King - Lord of the Undead (done)"
		"- Necronomicon - Ultimate Spell (done)"
		""
		"BFB Boss record:"
		"- Sandworm + Yeti + Dragon + Knight + Kraken (done)"
		""
		"You are a true Boss Hunter!"
		"Submit final proof:"
		"Nether Star x8 + Dragon Head x1 + Netherite Block x1"
	]
	quest.0000000011000013.quest_subtitle: "ISB + BFB Complete Conquest"
	quest.0000000011000013.title: "Boss Conqueror"
	quest.0000000011000014.quest_desc: [
		"Congratulations! Boss Hunter Graduation!"
		""
		"You have defeated all ultimate bosses in this modpack."
		"From the Flame Demon King''s inferno to the deep sea leviathan''s abyss,"
		"from the desert worm''s sandstorms to the sky dragon''s firmament."
		"You are fearless and unstoppable!"
		""
		"Your name shall be etched in the server''s history."
		"You are a true Boss Hunter without equal!"
		""
		"Submit the final graduation proof:"
		"Nether Star x10 + Beacon x1 + Dragon Head x1"
	]
	quest.0000000011000014.quest_subtitle: "Ultimate Hunt Complete"
	quest.0000000011000014.title: "Boss Hunter Graduation"
	quest.0000000012000001.quest_desc: [
		"Welcome to the RPG Progression and Maid System!"
		""
		"The Touhou Little Maid mod adds"
		"adorable maid companions to your adventure."
		""
		"Use cake to tame or summon maids."
		"They will accompany you exploring the world, fighting enemies,"
		"and can even manage farms and items for you."
		""
		"Prepare a cake and begin"
		"your maid companion journey!"
	]
	quest.0000000012000001.quest_subtitle: "Maid Companion System"
	quest.0000000012000001.title: "Adventure Companion"
	quest.0000000012000002.quest_desc: [
		"Maids are your most loyal adventure companions."
		""
		"How to obtain a maid:"
		"- Right-click a maid with cake to tame her"
		"- Tamed maids will follow you"
		"- Right-click to open the maid GUI for management"
		""
		"Maids spawn naturally in the world."
		"Explore different biomes to find"
		"your perfect maid companion!"
		""
		"Submit 4 cakes as taming proof."
	]
	quest.0000000012000002.quest_subtitle: "Taming Your Maid"
	quest.0000000012000002.title: "Maid Contract"
	quest.0000000012000003.quest_desc: [
		"Your maid can equip weapons and armor!"
		""
		"Open the maid GUI and place in equipment slots:"
		"- Diamond Sword: Boosts maid''s melee attack power"
		"- Diamond Chestplate: Enhances maid''s defense"
		"- Bow: Grants maid ranged attack capability"
		""
		"A well-equipped maid is your"
		"reliable assistant in battle, especially against tough enemies."
		""
		"Prepare all three equipment items"
		"to outfit your maid with a full combat set!"
	]
	quest.0000000012000003.quest_subtitle: "Maid Equipment"
	quest.0000000012000003.title: "Maid Equipment"
	quest.0000000012000004.quest_desc: [
		"Puffish Skills provides"
		"a powerful skill tree system!"
		""
		"Press K to open the skill tree interface."
		"Level up to earn skill points,"
		"and invest points in the skill tree for passive bonuses:"
		"- Combat Skills: Increase attack damage and speed"
		"- Mining Skills: Increase mining speed and fortune"
		"- Survival Skills: Increase health and armor"
		"- Agility Skills: Increase movement speed and dodge"
		""
		"Bottles o'' Enchanting and enchanted books symbolize"
		"your initial investment in the skill system."
	]
	quest.0000000012000004.quest_subtitle: "Puffish Skills Introduction"
	quest.0000000012000004.title: "Skill Tree"
	quest.0000000012000005.quest_desc: [
		"Puffish Attributes and Curios"
		"provide an equipment attribute bonus system for your character."
		""
		"Curio slots:"
		"- Ring slot: Wear rings for attribute bonuses"
		"- Necklace slot: Wear necklaces for special effects"
		"- Belt slot: Wear belts for enhanced defense"
		"- Also: bracelets, charms, and many more slots"
		""
		"Golden apples symbolize attribute enhancement."
		"Gold nuggets symbolize Curio accessories."
		"Get ready to explore the world of attribute gear!"
	]
	quest.0000000012000005.quest_subtitle: "Puffish Attributes  Curios"
	quest.0000000012000005.title: "Attribute Gear"
	quest.0000000012000006.quest_desc: [
		"It''s time to hone your combat skills!"
		""
		"Through the skill tree''s combat branch,"
		"your character''s strength is improving."
		"Now test your training in real combat!"
		""
		"Kill targets:"
		"- Skeletons x20: Practice ranged defense"
		"- Zombies x20: Practice melee blocking"
		"- Spiders x10: Practice agile positioning"
		""
		"Bring your maid to fight alongside you."
		"Accumulate real combat experience and march toward combat mastery!"
	]
	quest.0000000012000006.quest_subtitle: "Combat Training"
	quest.0000000012000006.title: "Combat Training"
	quest.0000000012000007.quest_desc: [
		"Maids are your most loyal combat partners."
		""
		"With a well-equipped maid by your side,"
		"sweep through the nightly monster hordes together!"
		""
		"Collect these trophies as combat proof:"
		"- Rotten Flesh x64: Proof of the zombie army"
		"- Bones x64: Proof of the skeleton archers"
		"- String x32: Proof of the spider nests"
		""
		"Fight alongside your maid, amass troves of loot,"
		"and prove your unbeatable combat synergy!"
	]
	quest.0000000012000007.quest_subtitle: "Maid Combat"
	quest.0000000012000007.title: "Maid Combat"
	quest.0000000012000008.quest_desc: [
		"You have completed skill training and combat testing."
		"Now it''s time to prove your full RPG mastery!"
		""
		"Submit these items as master-level proof:"
		"- Enchanted Golden Apple: Ultimate combat recovery"
		"- Totem of Undying: Last resort for desperate survival"
		"- Netherite Ingot x4: Symbol of top-tier equipment"
		""
		"This is the milestone node for the first half of this chapter."
		"Completing this quest proves you have mastered RPG core gameplay."
		"Continue downward to explore shrine and fairy secrets!"
	]
	quest.0000000012000008.quest_subtitle: "RPG Complete Mastery"
	quest.0000000012000008.title: "Full Power"
	quest.0000000012000009.quest_desc: [
		"In the Touhou Little Maid mod,"
		"shrines are important structures that provide P-Points (spirit power)."
		""
		"Use lanterns and glowstone to illuminate the shrine."
		"The shrine''s gohei will provide you and your maid"
		"with P-Point balance for special abilities."
		""
		"Collect these shrine lighting materials:"
		"- Glowstone x32: Main shrine light source"
		"- Lanterns x16: Decorative shrine lamps"
		"- Amethyst Shards x16: Spirit power medium"
		""
		"Light up the shrine and unlock the spirit power system!"
	]
	quest.0000000012000009.quest_subtitle: "Shrine P-Power"
	quest.0000000012000009.title: "Shrine Power"
	quest.0000000012000010.quest_desc: [
		"Wild fairy maids are scattered throughout the world."
		"They are a special variant type of maid."
		""
		"Fairy maids have unique appearances and abilities."
		"Use cake to tame them and expand your maid squad!"
		""
		"Taming supplies needed:"
		"- Emeralds x16: Fairy maid trading currency"
		"- Cakes x8: For taming multiple fairy maids"
		"- Golden Carrots x16: Fairy maids'' favorite food"
		""
		"Explore different biomes"
		"to discover and tame rare fairy maids!"
	]
	quest.0000000012000010.quest_subtitle: "Fairy Maids"
	quest.0000000012000010.title: "Fairy Maids"
	quest.0000000012000011.quest_desc: [
		"This is the ultimate test of the RPG progression system!"
		""
		"You have completed:"
		"[+] Skill tree training and combat practice"
		"[+] Attribute gear and Curio accessories"
		"[+] Maid taming, equipping, and combat synergy"
		"[+] Shrine spirit power and fairy maid exploration"
		""
		"Now submit the final proof:"
		"- Cakes x16: Logistics for your maid legion"
		"- Enchanted Golden Apples x4: Ultimate combat reserves"
		"- Nether Stars x4: Symbol of master-level power"
		""
		"Congratulations! You are an AKINO RPG Master!"
		"Next, welcome the final graduation ceremony!"
	]
	quest.0000000012000011.quest_subtitle: "Maid  RPG Grandmaster"
	quest.0000000012000011.title: "Master of Companions"
	quest.0000000012000012.quest_desc: [
		"Congratulations! You have reached the final graduation ceremony!"
		""
		"Review your AKINO adventure journey:"
		"- Vanilla Survival Basics - Starting MC life from scratch"
		"- Cooking and Cuisine - Enjoy the fruits of harvest"
		"- Storage Management - Build your item kingdom"
		"- Macaw''s Building - Craft your dream home"
		"- BYG Rich World - Explore 40+ biome wonders"
		"- YUNG Dungeons - Conquer new structure challenges"
		"- Dimension Travel - Nether, End, Aether, Deeper Darker"
		"- Create Mechanical Power - Steampunk automation"
		"- Iron''s Spells - Master the six schools of magic"
		"- Boss Hunting - Defeat all legendary foes"
		"- RPG Progression - Skills, Attributes, Maid Mastery"
		""
		"Submit the final graduation offerings:"
		"- Nether Star x8 - Witness to complete power"
		"- Dragon Head - Ultimate conquest of the Ender Dragon"
		""
		"- Beacon - Light at the top of the world"
		"- Cake - A memento returning to where it all began"
		""
		"You are a true AKINO Master!"
	]
	quest.0000000012000012.quest_subtitle: "AKINO Graduation Ceremony"
	quest.0000000012000012.title: "AKINO Graduation"
	quest.00FA24BFFBD39B2D.quest_desc: [
		"Defeat Shulkers in End Cities to"
		"collect shulker shells. Two shells"
		"craft a shulker box which stores"
		"items even when broken. Portable"
		"storage for your adventures."
	]
	quest.00FA24BFFBD39B2D.title: "Shulker Shell"
	quest.03CFC47D75623D5C.quest_desc: [
		"Craft a brewing stand with a blaze"
		"rod and cobblestone. Brewing stands"
		"create potions using water bottles"
		"nether wart and various ingredients."
	]
	quest.03CFC47D75623D5C.title: "Brewing Stand"
	quest.056088BF4F56866E.quest_desc: [
		"Mine redstone ore deep underground"
		"using an iron pickaxe or better."
		"Redstone is the core component for"
		"contraptions automation and circuits."
	]
	quest.056088BF4F56866E.title: "Redstone Dust"
	quest.06BBD2FAF873BD70.quest_desc: [
		"Craft the mighty diamond pickaxe using"
		"diamonds and sticks. Diamond tools have"
		"the highest durability and can mine"
		"obsidian for accessing the Nether."
	]
	quest.06BBD2FAF873BD70.title: "Diamond Pickaxe"
	quest.0909F835E2FB137A.quest_desc: [
		"Collect diamonds from deep underground."
		"Two diamonds plus obsidian and a book"
		"craft the enchanting table. Save some"
		"for tools armor and jukeboxes."
	]
	quest.0909F835E2FB137A.title: "Diamond"
	quest.0AA29F4ECB8E4C91.quest_desc: [
		"Begin your Vanilla Survival journey."
		"Master tools farming redstone enchanting"
		"brewing and exploration. Five branches"
		"await your progress through Minecraft."
	]
	quest.0AA29F4ECB8E4C91.title: "Vanilla Journey"
	quest.0C3851E13BD87FE7.quest_desc: [
		"Craft a furnace with 8 cobblestone."
		"Furnaces smelt ores into ingots and"
		"cook raw food. Use coal charcoal or"
		"wood as fuel to power your furnace."
	]
	quest.0C3851E13BD87FE7.title: "Furnace"
	quest.0E7C0A6ADC9B45F3.quest_desc: [
		"Find melon and pumpkin seeds in"
		"dungeons mineshafts or villages."
		"Melons restore hunger while pumpkins"
		"can be carved or used to make golems."
	]
	quest.0E7C0A6ADC9B45F3.title: "Melon  Pumpkin"
	quest.108F8962EE32DC2E.quest_desc: [
		"JEI (Just Enough Items) shows all recipes."
		"Press R on an item to see its recipe or"
		"U to see what it can be used for."
		"Search items on the right side of your inventory."
	]
	quest.108F8962EE32DC2E.title: "JEI Recipes"
	quest.1655335413FB1714.quest_desc: [
		"Biomes We've Gone adds over 80 new biomes"
		"with unique trees plants and terrain."
		"Explore diverse landscapes from lush"
		"tropics to frozen wastelands."
	]
	quest.1655335413FB1714.title: "Biomes  Building"
	quest.180492980DB17A32.quest_desc: [
		"The FTB Quest Book is your guide through"
		"the modpack. Open it with the hotkey or"
		"the book icon in your inventory."
		"Quests help you learn mods step by step."
	]
	quest.180492980DB17A32.title: "Quest Book Guide"
	quest.1A3F5B8C6AED8BA1.quest_desc: [
		"Upgrade a dropper with a bow to craft"
		"a dispenser. Dispensers can shoot"
		"arrows place water or lava and use"
		"other items with special behaviors."
	]
	quest.1A3F5B8C6AED8BA1.title: "Dispenser"
	quest.1B13FE0613AB1936.quest_desc: [
		"Enter the Nether and defeat Blazes"
		"in Nether Fortresses. Blaze rods are"
		"essential for brewing stands and for"
		"crafting Eyes of Ender."
	]
	quest.1B13FE0613AB1936.title: "Blaze Rod"
	quest.1D6B52B45262B3E6.quest_desc: [
		"Craft your first pickaxe using planks"
		"and sticks. Wooden tools are the"
		"foundation of all tool progression."
		"Use it to mine stone and upgrade."
	]
	quest.1D6B52B45262B3E6.title: "Wooden Pickaxe"
	quest.1DC504A8DD3E340D.quest_desc: [
		"Craft bookshelves with books and wood"
		"planks. Place 15 bookshelves around"
		"your enchanting table to unlock level"
		"30 enchantments for maximum power."
	]
	quest.1DC504A8DD3E340D.title: "Bookshelf"
	quest.20CCEC345A7C854B.quest_desc: [
		"Upgrade to a blast furnace using iron"
		"ingots a furnace and smooth stone."
		"Blast furnaces smelt ores twice as"
		"fast as a regular furnace."
	]
	quest.20CCEC345A7C854B.title: "Blast Furnace"
	quest.2160D71A7E80C5FA.quest_desc: [
		"Craft an observer with cobblestone"
		"redstone dust and nether quartz."
		"Observers detect block updates and"
		"emit a redstone pulse in response."
	]
	quest.2160D71A7E80C5FA.title: "Observer"
	quest.227795C4B58DD1A0.quest_desc: [
		"Breed chickens with seeds for eggs"
		"and meat. Shear or breed sheep with"
		"wheat for wool. Wool is essential"
		"for beds and decorative blocks."
	]
	quest.227795C4B58DD1A0.title: "Chicken  Sheep Farm"
	quest.2379CC05C6EA7358.quest_desc: [
		"Complete this quest to unlock all content"
		"chapters. Each chapter focuses on a"
		"specific aspect of the modpack."
		"Good luck on your adventure!"
	]
	quest.2379CC05C6EA7358.title: "Unlock All Chapters"
	quest.2757288AA4ACA157.quest_desc: [
		"Face powerful bosses and enhance your"
		"combat abilities. Iron's Spellbooks adds"
		"boss fights while improved combat mechanics"
		"make battles more engaging and rewarding."
	]
	quest.2757288AA4ACA157.title: "Combat  Bosses"
	quest.2871A402DDA75DFE.quest_desc: [
		"Craft a hopper with iron ingots and"
		"a chest. Hoppers move items between"
		"containers and can collect dropped"
		"items on the ground automatically."
	]
	quest.2871A402DDA75DFE.title: "Hopper"
	quest.290B326B898FDFC2.quest_desc: [
		"Find beetroot seeds in villages or"
		"dungeon chests. Beetroots can be"
		"crafted into beetroot soup for a"
		"hearty meal restoring 6 hunger."
	]
	quest.290B326B898FDFC2.title: "Beetroot"
	quest.2A77A8B819B0A58D.quest_desc: [
		"Waystones let you teleport between locations."
		"Find them in villages or craft your own."
		"Right-click a Waystone to activate it then"
		"warp between any activated Waystones."
	]
	quest.2A77A8B819B0A58D.title: "Waystones"
	quest.2C67A0D81F3382F5.quest_desc: [
		"Craft a dropper with cobblestone and"
		"redstone dust. Droppers eject items"
		"from their inventory when powered."
		"Essential for item transport systems."
	]
	quest.2C67A0D81F3382F5.title: "Dropper"
	quest.2F2BCA80BADED045.quest_desc: [
		"Mine gold ore found deep underground"
		"or in badlands biomes. Gold ingots are"
		"used for powered rails golden apples"
		"and bartering with Piglins."
	]
	quest.2F2BCA80BADED045.title: "Gold Mining"
	quest.3053761AB671D65F.quest_desc: [
		"Brew a potion by placing water bottles"
		"in a brewing stand adding nether wart"
		"and then a secondary ingredient like"
		"sugar blaze powder or golden carrots."
	]
	quest.3053761AB671D65F.title: "Water Bottle Potion"
	quest.3693B876119DEE82.quest_desc: [
		"Craft Eyes of Ender with ender pearls"
		"and blaze powder. Throw them to locate"
		"the Stronghold. Fill the End Portal"
		"frame with 12 Eyes of Ender."
	]
	quest.3693B876119DEE82.title: "Eye of Ender"
	quest.3B692852CBD08203.quest_desc: [
		"Craft bread from 3 wheat in a row."
		"Bread is an excellent early-game food"
		"restoring 5 hunger points. Ideal for"
		"long mining trips and exploration."
	]
	quest.3B692852CBD08203.title: "Bread"
	quest.3D947BE2838F0FFD.quest_desc: [
		"Combine a piston with a slimeball"
		"dropped by slimes. Sticky pistons"
		"can both push and pull blocks"
		"enabling advanced contraptions."
	]
	quest.3D947BE2838F0FFD.title: "Sticky Piston"
	quest.4084C0C650D6D286.quest_desc: [
		"Create is a mechanical engineering mod."
		"Build contraptions with gears belts and"
		"shafts. Automate resource processing"
		"with mechanical power instead of redstone."
	]
	quest.4084C0C650D6D286.title: "Create"
	quest.45CB29779F19E294.quest_desc: [
		"Welcome to AKINO's Survival Optimization!"
		"This modpack combines over 200 mods"
		"for an enhanced Minecraft experience."
		"Complete this tutorial to unlock all chapters."
	]
	quest.45CB29779F19E294.title: "Welcome to AKINO"
	quest.477E5422BB62324B.quest_desc: [
		"Craft an enchanting table with obsidian"
		"diamonds and a book. Enchanting adds"
		"powerful abilities to your tools and"
		"armor. Surround with bookshelves for"
		"higher-level enchantments."
	]
	quest.477E5422BB62324B.title: "Enchanting Table"
	quest.487D033753B53CA8.quest_desc: [
		"Mine coal ore found in stone layers."
		"Coal is the most common fuel source"
		"used in furnaces for smelting ores"
		"and cooking your first food."
	]
	quest.487D033753B53CA8.title: "Coal Mining"
	quest.48EB23F3A8E0E619.quest_desc: [
		"Summon and defeat the Wither to obtain"
		"a Nether Star for a beacon. Craft a"
		"conduit with nautilus shells and a"
		"heart of the sea. These end-game blocks"
		"grant powerful area buffs."
	]
	quest.48EB23F3A8E0E619.title: "Beacon  Conduit"
	quest.4A13EF2048CCBC9D.quest_desc: [
		"The Aether is a heavenly dimension in the"
		"sky. Build a Glowstone Portal with water"
		"to enter this paradise dimension filled"
		"with flying islands and unique mobs."
	]
	quest.4A13EF2048CCBC9D.title: "Aether"
	quest.4A8AA81E4CC7E6FB.quest_desc: [
		"Iron's Spellbooks adds a complete magic system."
		"Craft spell books find scrolls and learn"
		"powerful spells. Use mana to cast healing"
		"damage and utility spells in combat."
	]
	quest.4A8AA81E4CC7E6FB.title: "Iron's Spellbooks"
	quest.4C6497DFF66336B6.quest_desc: [
		"Craft detector rails with iron ingots"
		"stone pressure plates and redstone."
		"Detector rails emit a redstone signal"
		"when a minecart passes over them."
	]
	quest.4C6497DFF66336B6.title: "Detector Rail"
	quest.4D8D44EF7B17B929.quest_desc: [
		"Xaero's Minimap and World Map help you"
		"navigate the world. Set waypoints see"
		"terrain around you and never get lost"
		"on your adventures."
	]
	quest.4D8D44EF7B17B929.title: "Xaero's Maps"
	quest.4E63603D557A8E50.quest_desc: [
		"Jade shows information about the block or"
		"entity you are looking at. See block names"
		"mod sources and more at the top of your"
		"screen without opening any interface."
	]
	quest.4E63603D557A8E50.title: "Jade HUD"
	quest.51124642104D6F70.quest_desc: [
		"Collect Dragon's Breath using a glass"
		"bottle during the Ender Dragon fight."
		"Dragon's Breath is used to brew"
		"lingering potions."
	]
	quest.51124642104D6F70.title: "Dragon's Breath"
	quest.5144ECF156FE8973.quest_desc: [
		"Congratulations! You have mastered"
		"every branch of Vanilla Survival."
		"You have conquered tools farming"
		"redstone enchanting and exploration."
		"Your name echoes across the server!"
	]
	quest.5144ECF156FE8973.title: "Vanilla Grandmaster"
	quest.5683D9B30B01B931.quest_desc: [
		"Sophisticated Backpacks add portable storage."
		"Craft a backpack and upgrade it with various"
		"tiers and modules like crafting tables"
		"smelting and magnet upgrades. Press B to open."
	]
	quest.5683D9B30B01B931.title: "Sophisticated Backpacks"
	quest.57253D0D9A020F39.quest_desc: [
		"Craft a boat with wood planks. Boats"
		"let you travel across oceans and rivers"
		"quickly. They can carry two passengers"
		"and are immune to fall damage."
	]
	quest.57253D0D9A020F39.title: "Boat"
	quest.577D321D24D51E1C.quest_desc: [
		"Craft a compass with iron ingots and"
		"redstone dust. The compass always"
		"points to your world spawn point."
		"Essential for navigation."
	]
	quest.577D321D24D51E1C.title: "Compass"
	quest.585719C49104B22A.quest_desc: [
		"Forge an iron pickaxe with iron ingots"
		"and sticks. Iron tools mine faster and"
		"can harvest diamond ore and gold ore."
		"A major step in your progression."
	]
	quest.585719C49104B22A.title: "Iron Pickaxe"
	quest.5A29E29D84EC1BB2.quest_desc: [
		"Breed cows with wheat and pigs with"
		"carrots. Cows provide beef and leather"
		"while pigs give porkchops. A steady"
		"food supply is vital for survival."
	]
	quest.5A29E29D84EC1BB2.title: "Cow  Pig Farm"
	quest.5AFF77883C0E8075.quest_desc: [
		"Find carrots in village farms or as"
		"a rare zombie drop. Carrots are easy"
		"to farm and restore 3 hunger points."
		"Also used to breed pigs and rabbits."
	]
	quest.5AFF77883C0E8075.title: "Carrot"
	quest.5DDDD609E80C8E62.quest_desc: [
		"Defeat Endermen in the Overworld or"
		"the Nether to collect ender pearls."
		"Throw an ender pearl to teleport to"
		"where it lands at the cost of health."
	]
	quest.5DDDD609E80C8E62.title: "Ender Pearl"
	quest.5F0F0C58411C27DF.quest_desc: [
		"Craft rails with iron ingots and a"
		"stick. Rails guide minecarts along"
		"a path. Combine with powered rails"
		"to build full railway systems."
	]
	quest.5F0F0C58411C27DF.title: "Rails"
	quest.5F69490589CD056D.quest_desc: [
		"Upgrade to a stone pickaxe using"
		"cobblestone and sticks. Stone tools"
		"mine faster and can harvest iron ore"
		"which wooden tools cannot."
	]
	quest.5F69490589CD056D.title: "Stone Pickaxe"
	quest.6082FF105C97DFC7.quest_desc: [
		"Mine iron ore found underground."
		"Smelt raw iron in a furnace to get"
		"iron ingots. Iron is essential for"
		"tools armor and mechanical crafting."
	]
	quest.6082FF105C97DFC7.title: "Iron Mining"
	quest.6659973960B4E6B2.quest_desc: [
		"Craft a minecart with iron ingots."
		"Minecarts ride on rails for fast"
		"transportation. Add a chest furnace"
		"or hopper for specialized minecarts."
	]
	quest.6659973960B4E6B2.title: "Minecart"
	quest.6667B5A27F9DE92E.quest_desc: [
		"Welcome to AKINO Survival Optimization modpack!"
		""
		"Features:"
		"• Iron's Spellbooks — Six Schools of Magic"
		"• Create — Steampunk Automation"
		"• BYG Oh The Biomes — 40+ Biomes to Explore"
		"• YUNG'sOverhauled Structures — New Dungeon Experience"
		"• Aether + Deeper Darker Depths"
		"• Touhou Little Maid — Maid Companion Adventures"
		""
		"This chapter is a tutorial overview. Complete all quests to unlock every chapter!"
	]
	quest.6667B5A27F9DE92E.quest_subtitle: "Modpack Overview"
	quest.6667B5A27F9DE92E.title: "Welcome to AKINO"
	quest.66972350E70080C5.quest_desc: [
		"Craft a repeater with redstone torches"
		"redstone dust and stone. Repeaters"
		"extend and delay redstone signals"
		"up to 4 ticks of delay."
	]
	quest.66972350E70080C5.title: "Redstone Repeater"
	quest.6717E1912A4A900C.quest_desc: [
		"The Deeper Darker mod expands the Deep Dark"
		"dimension below the Ancient Cities."
		"Discover Sculk-infested caves and face"
		"the dangers lurking in the depths."
	]
	quest.6717E1912A4A900C.title: "Deeper Darker"
	quest.676273237277BC75.quest_desc: [
		"Craft a fishing rod with sticks and"
		"string from spiders. Fish in any body"
		"of water to catch raw fish which can"
		"be cooked for better hunger restoration."
	]
	quest.676273237277BC75.title: "Fishing Rod"
	quest.6797570FAA857C5F.quest_desc: [
		"Craft an anvil with iron blocks and"
		"iron ingots. Anvils combine enchanted"
		"items and repair tools. Experience"
		"bottles can be found or traded."
	]
	quest.6797570FAA857C5F.title: "Anvil  Exp Bottle"
	quest.68C1B60CBC5F072F.quest_desc: [
		"Find elytra in End Ships floating"
		"near End Cities. Elytra let you glide"
		"through the air. Boost with fireworks"
		"for powered flight across the world."
	]
	quest.68C1B60CBC5F072F.title: "Elytra"
	quest.6CC5DE67AEB158EC.quest_desc: [
		"Mine diamond ore near bedrock levels."
		"Diamonds are the most valuable ore"
		"used for top-tier tools armor and"
		"an enchanting table."
	]
	quest.6CC5DE67AEB158EC.title: "Diamond Mining"
	quest.71EDDB11F73F7C4C.quest_desc: [
		"Craft an empty map with paper and a"
		"compass. Maps record the terrain as"
		"you explore. Expand them with more"
		"paper at a cartography table."
	]
	quest.71EDDB11F73F7C4C.title: "Map"
	quest.74058C637502CD90.quest_desc: [
		"Craft a piston with wood planks"
		"cobblestone redstone dust and an"
		"iron ingot. Pistons push blocks"
		"when powered by redstone."
	]
	quest.74058C637502CD90.title: "Piston"
	quest.74B6BC1EA60CF143.quest_desc: [
		"Congratulations! You have learned about"
		"the major mods in this modpack. You are"
		"now ready to dive deeper into each"
		"chapter and master every mod."
	]
	quest.74B6BC1EA60CF143.title: "Tutorial Complete"
	quest.74B9B00986CD9B18.quest_desc: [
		"Find potatoes in village farms or as"
		"a rare zombie drop. Potatoes can be"
		"cooked into baked potatoes for better"
		"hunger restoration."
	]
	quest.74B9B00986CD9B18.title: "Potato"
	quest.7646A4EF95218159.quest_desc: [
		"Collect wheat seeds by breaking tall"
		"grass. Plant seeds on farmland near"
		"water to grow wheat. Wheat is the"
		"staple crop for bread and breeding."
	]
	quest.7646A4EF95218159.title: "Wheat Seeds"
	quest.77AAF938A932FE52.quest_desc: [
		"Craft a spyglass with copper ingots"
		"and an amethyst shard. Use it to zoom"
		"in and scout distant terrain or"
		"locate structures from afar."
	]
	quest.77AAF938A932FE52.title: "Spyglass"
	quest.7998017F967B10D9.quest_desc: [
		"Brew a lingering potion by adding"
		"Dragon's Breath to a splash potion."
		"Lingering potions create a cloud that"
		"applies effects to entities inside."
	]
	quest.7998017F967B10D9.title: "Lingering Potion"
	quest.79C171814B1BE5D1.quest_desc: [
		"Find nether wart growing in Nether"
		"Fortresses. Nether wart is the base"
		"ingredient for all potions. Farm it"
		"on soul sand for a steady supply."
	]
	quest.79C171814B1BE5D1.title: "Nether Wart"
	quest.7A895FDC11FD4B86.quest_desc: [
		"Craft powered rails with gold ingots"
		"redstone dust and sticks. Powered"
		"rails propel minecarts when given"
		"a redstone signal."
	]
	quest.7A895FDC11FD4B86.title: "Powered Rail"
	quest.7B364D96652201C0.quest_desc: [
		"Upgrade your diamond pickaxe with a"
		"netherite ingot at a smithing table."
		"Netherite tools are lava-proof and"
		"have the highest stats in the game."
	]
	quest.7B364D96652201C0.title: "Netherite Pickaxe"
	quest.7E36D8AFE64BAC31.quest_desc: [
		"Mine obsidian with a diamond pickaxe"
		"or find it where water meets lava."
		"Obsidian is needed for Nether portals"
		"enchanting tables and ender chests."
	]
	quest.7E36D8AFE64BAC31.title: "Obsidian"
	quest.7FCE371458E53CDC.quest_desc: [
		"Cook raw cod or salmon in a furnace"
		"or smoker. Cooked fish is an excellent"
		"food source that restores 5 hunger"
		"points without needing farmland."
	]
	quest.7FCE371458E53CDC.title: "Cooked Fish"
