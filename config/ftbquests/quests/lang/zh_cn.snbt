	quest.0000000005000002.title: "BYG 木头 Guide"
	quest.0000000005000003.quest_desc: [
		"BYG世界拥有种类繁多的植物，每种植物都适应其原生生物群系"
		"芦荟——生长于干旱温暖生物群系"
		"紫菀花丛——温带草原的标志性花卉"
		"这些植物不仅美观，也是食材。开启你的植物收集之旅！"
	]
	quest.0000000005000003.quest_subtitle: "BYG Flora Basics"
	quest.0000000005000003.title: "BYG Flora Basics"
	quest.0000000005000004.quest_desc: [
		"BYG不仅扩展了生物群系，还带来了独特的食物系统"
		"使用生物群系植物制作美味佳肴"
		"芦荟汁——清爽的沙漠饮品"
		"蓝莓派——温带生物群系的甜蜜享受"
		"收集足够的食材，品尝BYG的独特风味。美食是探索路上最好的慰藉"
	]
	quest.0000000005000004.quest_subtitle: "BYG Culinary 探索"
	quest.0000000005000004.title: "BYG Culinary 探索"
	quest.0000000005000005.quest_desc: [
		"BYG生物群系中蕴藏着丰富的矿产宝藏，稀有矿物和独特植物等待你的发现"
		"绿宝石——热带生物群系的珍贵矿物"
